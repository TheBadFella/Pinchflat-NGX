<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <div class="flex gap-3 items-center min-w-0">
    <.link
      href={~p"/sources/#{@media_item.source_id}"}
      aria-label="Back"
      class="theme-icon-button theme-outline-button shrink-0"
    >
      <.icon name="hero-arrow-left" class="h-5 w-5" />
    </.link>

    <h2 class="ml-4 min-w-0 [overflow-wrap:anywhere] text-title-md2 font-bold text-theme-on-surface">
      {@media_item.title}
    </h2>
  </div>

  <nav class="shrink-0">
    <.button href={~p"/sources/#{@media_item.source_id}/media/#{@media_item}/edit"} variant="primary">
      <.icon name="hero-pencil-square" class="mr-2" /> Edit
    </.button>
  </nav>
</div>

<div class="theme-surface-raised px-7.5 py-5 pt-6">
  <div class="max-w-full">
    <.tabbed_layout active_tab={@active_tab} tab_href={@tab_href}>
      <:tab_append><.actions_dropdown media_item={@media_item} /></:tab_append>

      <:tab title="Media" id="media">
        <div class="flex flex-col gap-10 text-theme-on-surface">
          <section :if={@media_item.last_error} class="mt-6">
            <div class="flex items-center gap-1 mb-2">
              <.icon name="hero-exclamation-circle-solid" class="theme-status-error" />
              <h3 class="font-bold text-xl">Last Error</h3>
            </div>
            <span>{@media_item.last_error}</span>
          </section>

          <section :if={@media_item.unavailable_at} class="mt-6">
            <div class="flex items-center gap-1 mb-2">
              <.icon name="hero-no-symbol" class="theme-status-warning" />
              <h3 class="font-bold text-xl">Unavailable</h3>
            </div>

            <span>
              This item was skipped because it is permanently unavailable{if @media_item.unavailable_reason,
                do: ": #{@media_item.unavailable_reason}",
                else: " (members-only, private, or removed)"}.
            </span>
          </section>

          <%= if media_file_exists?(@media_item) do %>
            <section class="grid grid-cols-1 xl:gap-6 mt-6">
              <div><.media_preview media_item={@media_item} /></div>

              <aside class="mt-4">
                <h2 class="text-xl mb-2">{@media_item.title}</h2>

                <div>Uploaded: {DateTime.to_date(@media_item.uploaded_at)}</div>

                <div>
                  <span :if={URI.parse(@media_item.original_url).scheme =~ "http"}>
                    <.subtle_link href={@media_item.original_url} target="_blank">Open Original</.subtle_link>
                    <span class="mx-2">or</span>
                  </span>

                  <span>
                    <.subtle_link
                      href={~p"/media/#{@media_item.uuid}/stream?v=#{DateTime.to_unix(@media_item.updated_at)}"}
                      target="_blank"
                    >
                      Open Local Stream
                    </.subtle_link>
                  </span>
                </div>

                <div :if={@media_item.description} class="mt-4 text-theme-on-surface-muted">
                  <.render_description text={@media_item.description} />
                </div>
              </aside>
            </section>
          <% end %>

          <section>
            <h3 class="font-bold text-xl mb-2">Raw Attributes</h3>

            <section>
              <strong>Source:</strong>
              <.subtle_link href={~p"/sources/#{@media_item.source_id}"}>{@media_item.source.custom_name}</.subtle_link>
              <.list_items_from_map map={Map.from_struct(@media_item)} />
            </section>
          </section>
        </div>
      </:tab>

      <:tab title="Tasks" id="tasks">
        <%= if match?([_|_], @media_item.tasks) do %>
          <div class="space-y-4 md:hidden">
            <article :for={task <- @media_item.tasks} class="theme-surface-accent space-y-3 rounded-m3-lg p-4">
              <div class="break-words font-medium text-theme-on-surface">{task.job.worker}</div>

              <dl class="grid grid-cols-1 gap-3 text-sm">
                <div class="flex items-start justify-between gap-3">
                  <dt class="text-theme-on-surface-muted">State</dt>

                  <dd class="text-right text-theme-on-surface">{task.job.state}</dd>
                </div>

                <div class="flex items-start justify-between gap-3">
                  <dt class="text-theme-on-surface-muted">Scheduled At</dt>

                  <dd class="text-right text-theme-on-surface">
                    <.datetime_in_zone datetime={task.job.scheduled_at} />
                  </dd>
                </div>
              </dl>
            </article>
          </div>

          <div class="hidden md:block">
            <.table rows={@media_item.tasks}>
              <:col :let={task} label="Worker">{task.job.worker}</:col>

              <:col :let={task} label="State">{task.job.state}</:col>

              <:col :let={task} label="Scheduled At"><.datetime_in_zone datetime={task.job.scheduled_at} /></:col>
            </.table>
          </div>
        <% else %>
          <p class="text-theme-on-surface">Nothing Here!</p>
        <% end %>
      </:tab>
    </.tabbed_layout>
  </div>
</div>
