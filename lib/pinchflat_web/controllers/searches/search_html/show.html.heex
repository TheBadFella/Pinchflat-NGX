<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <h2 class="truncate text-title-md2 font-bold text-theme-on-surface">Results for "{@search_term}"</h2>
</div>

<div class="theme-surface-raised px-5 py-5 sm:px-7.5">
  <div class="max-w-full text-theme-on-surface">
    <%= if match?([_|_], @search_results) do %>
      <ul class="divide-y divide-theme-outline/60">
        <li :for={result <- @search_results} class="flex gap-4 py-4 first:pt-0 last:pb-0">
          <.media_thumbnail media_item={result} size="row" />
          <div class="min-w-0 flex-1 space-y-1">
            <.subtle_link href={~p"/sources/#{result.source_id}/media/#{result.id}"}>
              <span class="block break-words font-medium text-theme-on-surface">{result.title}</span>
            </.subtle_link>
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-theme-on-surface-muted">
              <span>
                <span :if={result.source}>{String.trim(result.source.custom_name || "")}</span><span :if={
                  result.uploaded_at
                }>, published
                <.datetime_in_zone
                  datetime={result.uploaded_at}
                  format="%Y-%m-%d"
                /></span><span :if={result.media_filepath && result.media_downloaded_at}>, downloaded
                <.datetime_in_zone
                  datetime={result.media_downloaded_at}
                  format="%Y-%m-%d"
                /></span>
              </span>
              <span class={[
                "theme-download-status",
                if(result.media_filepath, do: "theme-download-status-ok", else: "theme-download-status-waiting")
              ]}>
                {if result.media_filepath, do: "Downloaded", else: "Not downloaded"}
              </span>
            </p>
            <p class="break-words text-sm text-theme-on-surface-muted">
              <.highlight_search_terms text={result.matching_search_term} />
            </p>
          </div>
        </li>
      </ul>
    <% else %>
      <p class="text-center text-lg font-bold text-theme-on-surface">No results found</p>
    <% end %>
  </div>
</div>
