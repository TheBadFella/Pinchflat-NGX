<div class="mb-6 flex gap-3 flex-row items-center">
  <.link href={~p"/media_profiles"} aria-label="Back" class="theme-icon-button theme-outline-button shrink-0">
    <.icon name="hero-arrow-left" class="h-5 w-5" />
  </.link>

  <h2 class="ml-4 min-w-0 [overflow-wrap:anywhere] text-title-md2 font-bold text-theme-on-surface">
    Editing "{@media_profile.name}"
  </h2>
</div>

<div class="theme-surface-raised px-5 pb-2.5 pt-6 sm:px-7.5 xl:pb-1">
  <div class="max-w-full">
    <div class="flex flex-col gap-10">
      <.media_profile_form changeset={@changeset} action={~p"/media_profiles/#{@media_profile}"} method="patch" />
    </div>
  </div>
</div>
