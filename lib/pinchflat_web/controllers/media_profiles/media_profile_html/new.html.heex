<div class="mb-6 flex gap-3 flex-row items-center">
  <.link
    :if={!Settings.get!(:onboarding)}
    href={~p"/media_profiles"}
    aria-label="Back"
    class="theme-icon-button theme-outline-button"
  >
    <.icon name="hero-arrow-left" class="h-5 w-5" />
  </.link>
  <h2 class="ml-4 text-title-md2 font-bold text-theme-on-surface">New Media Profile</h2>
</div>

<div class="theme-surface-raised px-5 pb-2.5 pt-6 sm:px-7.5 xl:pb-1">
  <div class="max-w-full">
    <div class="flex flex-col gap-10">
      <.media_profile_form
        changeset={@changeset}
        action={~p"/media_profiles"}
        method="post"
        yt_dlp_options={@yt_dlp_options}
        yt_dlp_options_version={@yt_dlp_options_version}
        yt_dlp_options_present={@yt_dlp_options_present}
        yt_dlp_options_readable={@yt_dlp_options_readable}
        yt_dlp_options_clearable={@yt_dlp_options_clearable}
        yt_dlp_options_inherited={@yt_dlp_options_inherited}
        yt_dlp_options_profile_presence={@yt_dlp_options_profile_presence}
        yt_dlp_error={@yt_dlp_error}
      />
    </div>
  </div>
</div>
