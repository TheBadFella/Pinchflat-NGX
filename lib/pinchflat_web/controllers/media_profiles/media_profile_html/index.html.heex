<div :if={message = Phoenix.Flash.get(@conn.assigns.flash, :default_profile_saved)} class="theme-toast-stack">
  <.flash id="default-profile-saved-toast" kind={:info} toast>{message}</.flash>
</div>

<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <h2 class="text-title-md2 font-bold text-theme-on-surface">Media Profiles</h2>

  <nav>
    <.button href={~p"/media_profiles/new"} variant="primary">
      <span class="font-bold text-xl mr-2">+</span> New <span class="hidden sm:inline pl-1">Media Profile</span>
    </.button>
  </nav>
</div>

<div class="theme-surface-raised">
  <div class="space-y-4 p-4 lg:hidden">
    <article :for={media_profile <- @media_profiles} class="theme-surface-accent space-y-4 rounded-m3-lg p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-48 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <.subtle_link href={~p"/media_profiles/#{media_profile.id}"}>
              <span class="block break-words font-medium text-theme-on-surface">{media_profile.name}</span>
            </.subtle_link>
            <span
              :if={@default_profile_id == media_profile.id}
              class="theme-pill theme-pill-info"
            >
              Default
            </span>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <.link
            :if={@default_profile_id != media_profile.id}
            href={~p"/media_profiles/#{media_profile.id}/set_default"}
            method="post"
            class="theme-outline-button theme-button-compact"
          >
            Set as Default
          </.link>
          <button
            :if={@default_profile_id == media_profile.id}
            type="button"
            disabled
            title="New sources, Browse and imports preselect this profile"
            class="theme-outline-button theme-button-compact inline-flex items-center gap-1"
          >
            <.icon name="hero-check" class="h-4 w-4" /> Current default
          </button>
          <.icon_link
            href={~p"/media_profiles/#{media_profile.id}/edit"}
            icon="hero-pencil-square"
            aria-label="Edit"
            class="mx-1 shrink-0"
          />
        </div>
      </div>

      <dl class="grid grid-cols-1 gap-3 text-sm">
        <div class="flex items-start justify-between gap-3">
          <dt class="text-theme-on-surface-muted">Preferred Resolution</dt>
          <dd class="text-right text-theme-on-surface">{media_profile.preferred_resolution}</dd>
        </div>
        <div class="flex items-start justify-between gap-3">
          <dt class="text-theme-on-surface-muted">Sources</dt>
          <dd class="text-right text-theme-on-surface">
            <.subtle_link href={~p"/media_profiles/#{media_profile.id}/#tab-sources"}>
              <.localized_number number={media_profile.source_count} />
            </.subtle_link>
          </dd>
        </div>
      </dl>
    </article>
  </div>

  <div class="hidden lg:block">
    <div class="max-w-full overflow-visible">
      <div class="overflow-x-auto overflow-y-hidden">
        <div class="flex min-w-max flex-col gap-10">
          <.table rows={@media_profiles}>
            <:col :let={media_profile} label="Name" class="truncate max-w-xs">
              <div class="flex min-w-0 items-center gap-2">
                <span class="min-w-0 truncate" title={media_profile.name}>
                  <.subtle_link href={~p"/media_profiles/#{media_profile.id}"}>{media_profile.name}</.subtle_link>
                </span>
                <span
                  :if={@default_profile_id == media_profile.id}
                  class="theme-pill theme-pill-info"
                >
                  Default
                </span>
              </div>
            </:col>

            <:col :let={media_profile} label="Preferred Resolution">{media_profile.preferred_resolution}</:col>

            <:col :let={media_profile} label="Sources">
              <.subtle_link href={~p"/media_profiles/#{media_profile.id}/#tab-sources"}>
                <.localized_number number={media_profile.source_count} />
              </.subtle_link>
            </:col>

            <:col :let={media_profile} label="" class="flex items-center justify-end gap-2">
              <.link
                :if={@default_profile_id != media_profile.id}
                href={~p"/media_profiles/#{media_profile.id}/set_default"}
                method="post"
                class="theme-outline-button theme-button-compact"
              >
                Set as Default
              </.link>
              <button
                :if={@default_profile_id == media_profile.id}
                type="button"
                disabled
                title="New sources, Browse and imports preselect this profile"
                class="theme-outline-button theme-button-compact inline-flex items-center gap-1"
              >
                <.icon name="hero-check" class="h-4 w-4" /> Current default
              </button>
              <.icon_link
                href={~p"/media_profiles/#{media_profile.id}/edit"}
                icon="hero-pencil-square"
                aria-label="Edit"
                class="mr-4"
              />
            </:col>
          </.table>
        </div>
      </div>
    </div>
  </div>
</div>
