<.tabbed_layout active_tab={to_string(@source_type)} tab_href={fn type -> source_tab_path(type, @view_mode) end}>
  <:tab :for={{type, title} <- source_tabs()} id={type} title={title}>
    <div>
      <div
        :if={@tab_record_count > 0 or @search_term != nil}
        id="source-toolbar"
        class="@container mb-4 flex flex-wrap items-center gap-x-3 gap-y-2"
      >
        <div class="flex w-full flex-wrap items-center gap-2 sm:w-auto">
          <form
            id="source-search-form"
            role="search"
            class="min-w-0 flex-1 max-sm:order-first max-sm:basis-full sm:w-80 sm:flex-none lg:w-96"
            phx-change="search"
            phx-submit="search"
            x-data="{
              setSearchParam(term) {
                const url = new URL(location.href);
                term.trim() ? url.searchParams.set('q', term.trim()) : url.searchParams.delete('q');
                history.replaceState(null, '', url);
              },
              clearSearchInput() {
                const input = document.getElementById('source-search-input');
                input.value = '';
                input.focus();
                this.setSearchParam('');
              }
            }"
            x-on:input.debounce.200ms="setSearchParam($event.target.value)"
            x-on:clear-source-search.window="clearSearchInput()"
          >
            <.input
              type="text"
              id="source-search-input"
              name="q"
              value={@search_term}
              placeholder={"Search #{source_type_noun(@source_type)}"}
              aria-label={"Search #{source_type_noun(@source_type)}"}
              autocomplete="off"
              enterkeyhint="search"
              phx-debounce="200"
            >
              <:input_action>
                <button
                  :if={@search_term}
                  type="button"
                  class="theme-field-action hover:bg-transparent"
                  aria-label="Clear search"
                  phx-click={JS.push("clear_search") |> JS.dispatch("clear-source-search")}
                >
                  <.icon name="hero-x-mark" class="h-5 w-5" />
                </button>
                <span :if={!@search_term} class="theme-field-action pointer-events-none" aria-hidden="true">
                  <.icon name="hero-magnifying-glass" class="h-5 w-5" />
                </span>
              </:input_action>
            </.input>
          </form>
        </div>

        <div
          id="selected-source-actions"
          role="group"
          aria-label="Actions for selected sources"
          data-selected-count={MapSet.size(@selected_ids)}
          class="ml-auto flex flex-wrap items-center justify-end gap-2"
        >
          <.button
            id="source-selection-toggle"
            type="button"
            variant="outline"
            size="compact"
            class={["shrink-0 gap-1.5", MapSet.size(@selected_ids) > 0 && "text-theme-primary"]}
            aria-pressed={to_string(MapSet.size(@selected_ids) > 0)}
            aria-label={selection_toggle_label(@selected_ids, @total_record_count)}
            aria-live="polite"
            disabled={@sources == []}
            phx-click="toggle_selection"
          >
            <.icon
              name={if MapSet.size(@selected_ids) > 0, do: "hero-x-mark", else: "hero-check-circle"}
              class="h-4 w-4"
            />
            {selection_toggle_text(@selected_ids, @total_record_count)}
          </.button>

          <.bulk_downloads armed={@armed} done_action={@done_action} selected_ids={@selected_ids} />

          <div id="selected-source-profile">
            <.button_dropdown
              text={if @done_action == :profile, do: "Profile Changed", else: "Media Profile"}
              short_text={if @done_action != :profile, do: "Profile"}
              short_class="@5xl:hidden"
              long_class="@max-5xl:hidden"
              variant={if @done_action == :profile, do: "success", else: "outline"}
              size="compact"
              disabled={MapSet.size(@selected_ids) == 0}
            >
              <:option :for={profile <- @media_profiles}>
                <button
                  type="button"
                  phx-click="bulk_profile"
                  phx-value-profile_id={profile.id}
                  data-armed={to_string(armed_for?(@armed, {:profile, to_string(profile.id)}, @selected_ids))}
                  x-on:click="if ($el.dataset.armed === 'true') dropdownOpen = false"
                  class={armed_for?(@armed, {:profile, to_string(profile.id)}, @selected_ids) && "theme-status-warning"}
                >
                  <span class="min-w-0 truncate">
                    {if armed_for?(@armed, {:profile, to_string(profile.id)}, @selected_ids),
                      do: "Use #{profile.name} for #{MapSet.size(@selected_ids)}?",
                      else: profile.name}
                  </span>
                </button>
              </:option>
            </.button_dropdown>
          </div>

          <div :if={@source_type != :videos} id="selected-source-frequency">
            <.button_dropdown
              text={if @done_action == :frequency, do: "Frequency Changed", else: "Index Frequency"}
              text_class={if @done_action == :frequency, do: "", else: "max-sm:sr-only"}
              leading_icon="hero-clock"
              aria_label="Index frequency for the selected sources"
              variant={if @done_action == :frequency, do: "success", else: "outline"}
              size="compact"
              disabled={MapSet.size(@selected_ids) == 0}
            >
              <:option :for={{label, minutes} <- SourceHTML.friendly_index_frequencies()}>
                <button
                  type="button"
                  phx-click="bulk_frequency"
                  phx-value-minutes={minutes}
                  data-armed={to_string(armed_for?(@armed, {:frequency, to_string(minutes)}, @selected_ids))}
                  x-on:click="if ($el.dataset.armed === 'true') dropdownOpen = false"
                  class={armed_for?(@armed, {:frequency, to_string(minutes)}, @selected_ids) && "theme-status-warning"}
                >
                  {if armed_for?(@armed, {:frequency, to_string(minutes)}, @selected_ids),
                    do: "Use #{label} for #{MapSet.size(@selected_ids)}?",
                    else: label}
                </button>
              </:option>
            </.button_dropdown>
          </div>

          <div :if={@source_type != :videos} id="selected-source-cutoff-menu">
            <.button_dropdown
              text="Download Cutoff"
              text_class="max-sm:sr-only"
              short_text="DL Cutoff"
              short_class="@5xl:hidden max-sm:sr-only"
              long_class="@max-5xl:hidden"
              leading_icon="hero-archive-box-x-mark"
              aria_label="Download cutoff for the selected sources"
              variant="outline"
              size="compact"
              disabled={MapSet.size(@selected_ids) == 0}
            >
              <:option>
                <.form
                  for={%{}}
                  id="selected-source-cutoff"
                  action={~p"/sources/cutoff/apply_now"}
                  method="post"
                  class="w-72 px-4 pb-2 text-left"
                >
                  <input type="hidden" name="return_to" value={@return_to} />
                  <input :for={id <- Enum.sort(@selected_ids)} type="hidden" name="source_ids[]" value={id} />
                  <div class="space-y-3">
                    <.cutoff_fields
                      id_base="selected-source-cutoff"
                      date_name="cutoff_date"
                      days_name="cutoff_days"
                      mode="date"
                      timezone={@timezone}
                    />
                    <p class="text-xs text-theme-on-surface-muted">
                      If downloaded media would become eligible for cleanup, you'll see the counts and confirm first.
                    </p>
                    <.button type="submit" size="compact" class="w-full" disabled={MapSet.size(@selected_ids) == 0}>
                      Apply
                    </.button>
                  </div>
                </.form>
              </:option>
            </.button_dropdown>
          </div>

          <.button
            type="button"
            variant="danger"
            size="compact"
            class="gap-1.5"
            disabled={MapSet.size(@selected_ids) == 0}
            phx-click={JS.push("confirm_delete") |> show_modal("delete-selected-sources-modal")}
          >
            <.icon name="hero-trash" class="h-4 w-4" /> <span class="max-sm:sr-only">Delete</span>
          </.button>

          <div id="selected-source-jobs">
            <.button_dropdown
              icon_name="hero-ellipsis-vertical-solid"
              aria_label="More actions for the selected sources"
              tooltip={if @job_running, do: "Queuing…", else: "More actions"}
              variant="outline"
              size="compact"
              disabled={MapSet.size(@selected_ids) == 0 or not is_nil(@job_running)}
            >
              <:option :for={{name, job, label} <- bulk_jobs()}>
                <button
                  type="button"
                  phx-click="bulk_job"
                  phx-value-action={name}
                  data-armed={to_string(armed_for?(@armed, {:job, job}, @selected_ids))}
                  x-on:click="if ($el.dataset.armed === 'true') dropdownOpen = false"
                  class={armed_for?(@armed, {:job, job}, @selected_ids) && "theme-status-warning"}
                >
                  {if armed_for?(@armed, {:job, job}, @selected_ids),
                    do: "#{label} for #{MapSet.size(@selected_ids)}?",
                    else: label}
                </button>
              </:option>
              <:option>
                <%!-- Reconciliation plans cover one source or the whole library. --%>
                <.link
                  :if={MapSet.size(@selected_ids) == 1}
                  href={~p"/reconciliation?#{[source_id: Enum.at(@selected_ids, 0)]}"}
                >
                  Reconcile Files
                </.link>
                <button
                  :if={MapSet.size(@selected_ids) != 1}
                  type="button"
                  disabled
                  class="flex-col items-start! gap-0! disabled:cursor-not-allowed disabled:opacity-60"
                >
                  Reconcile Files <span class="text-xs font-normal">One source at a time</span>
                </button>
              </:option>
              <:option>
                <div class="h-px w-full bg-theme-outline/70"></div>
              </:option>
              <:option :for={
                {action, icon, label} <- [
                  {:pause, "hero-bolt-slash-solid", "Disable Automatic Downloads"},
                  {:resume, "hero-bolt-solid", "Enable Automatic Downloads"}
                ]
              }>
                <button
                  type="button"
                  phx-click="bulk_action"
                  phx-value-action={action}
                  data-armed={to_string(armed_for?(@armed, action, @selected_ids))}
                  x-on:click="if ($el.dataset.armed === 'true') dropdownOpen = false"
                  class={armed_for?(@armed, action, @selected_ids) && "theme-status-warning"}
                >
                  <.icon name={icon} class="h-4 w-4" />
                  {if armed_for?(@armed, action, @selected_ids),
                    do: "#{label} for #{MapSet.size(@selected_ids)}?",
                    else: label}
                </button>
              </:option>
            </.button_dropdown>
          </div>
        </div>
      </div>

      <p
        id="source-search-summary"
        class={["text-sm text-theme-on-surface-muted", @search_term && "-mt-2 mb-4"]}
        role="status"
      >
        <span :if={@search_term}>
          Showing <.localized_number number={@total_record_count} /> of
          <.localized_number number={@tab_record_count} /> {source_type_noun(@source_type)} for “{@search_term}”
        </span>
      </p>

      <SourceHTML.source_delete_dialog
        id="delete-selected-sources-modal"
        form_id="delete-selected-sources"
        names={@delete_names}
        action={~p"/sources/delete_selected"}
        on_cancel={JS.push("cancel_delete")}
        return_to={@return_to}
        source_ids={@delete_ids}
      />

      <div
        :if={show_selection_banner?(@selection_scope, @sources, @selected_ids, @total_record_count)}
        id="source-select-all"
        class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-m3-sm bg-theme-primary/10 px-3 py-2 text-sm text-theme-on-surface"
      >
        <%= cond do %>
          <% @selection_scope == :all -> %>
            <span :if={MapSet.size(@selected_ids) == @total_record_count}>
              All {MapSet.size(@selected_ids)} {source_type_noun(@source_type)} are selected.
            </span>
            <span :if={MapSet.size(@selected_ids) != @total_record_count}>
              {MapSet.size(@selected_ids)} of {@total_record_count} {source_type_noun(@source_type)} are selected.
            </span>
            <button
              type="button"
              class="theme-touch-target font-semibold text-theme-primary hover:underline"
              phx-click="clear_selection"
            >
              Clear Selection
            </button>
          <% @total_record_count <= selection_limit() -> %>
            <span>All {length(@sources)} {source_type_noun(@source_type)} on this page are selected.</span>
            <button
              type="button"
              class="theme-touch-target font-semibold text-theme-primary hover:underline"
              phx-click="select_all"
            >
              Select All {@total_record_count} {source_type_title(@source_type)}
            </button>
          <% true -> %>
            <span>
              All {length(@sources)} on this page are selected. Bulk actions work on up to {selection_limit()} sources at a time, so search to narrow the list before selecting everything.
            </span>
        <% end %>
      </div>

      <div
        :if={@sources == [] and @search_term != nil}
        id="source-search-empty"
        class="mb-5 rounded-m3-sm bg-theme-surface p-5 text-theme-on-surface"
      >
        <h3 class="font-semibold">No {source_type_noun(@source_type)} match “{@search_term}”</h3>
        <p class="mt-2 text-sm text-theme-on-surface-muted">
          Search checks source names and YouTube channel and playlist names.
          Try another term, or clear the search to see all {source_type_noun(@source_type)}.
        </p>
        <.button
          type="button"
          variant="outline"
          class="mt-4"
          phx-click={JS.push("clear_search") |> JS.dispatch("clear-source-search")}
        >
          Clear Search
        </.button>
      </div>
    </div>

    <div
      :if={@sources == [] and is_nil(@search_term)}
      class="mb-5 rounded-m3-sm bg-theme-surface p-5 text-theme-on-surface"
    >
      <%= if @source_type == :videos do %>
        <h3 class="font-semibold">No individual videos yet</h3>
        <p class="mt-2 text-sm text-theme-on-surface-muted">
          Videos added individually appear here, including those added with Paste URL.
          Videos downloaded through an existing channel or playlist stay with that source.
        </p>
        <.button href={~p"/browse"} variant="primary" class="mt-4">Browse YouTube</.button>
      <% else %>
        <h3 class="font-semibold">No channels or playlists yet</h3>
        <p class="mt-2 text-sm text-theme-on-surface-muted">
          Add a channel or playlist to follow its videos. Individually added videos are in the Individual videos tab.
        </p>
        <.button href={~p"/sources/new"} variant="primary" class="mt-4">New Source</.button>
      <% end %>
    </div>

    <div
      id="source-notice-toasts"
      class="theme-toast-stack"
    >
      <.flash
        :if={@notice}
        id={"source-notice-#{@notice_id}"}
        kind={notice_kind(@notice)}
        title={notice_title(@notice)}
        toast
      >
        {notice_text(@notice)}
      </.flash>
    </div>

    <div :if={@view_mode == :table}>
      <div class="space-y-4 md:hidden">
        <article :for={source <- @sources} class="theme-surface-accent space-y-4 rounded-m3-lg p-4">
          <.input
            type="checkbox"
            id={"source-select-mobile-#{source.id}"}
            name="source_selection"
            label="Select"
            label_class="sr-only"
            aria-label={"Select #{source.custom_name}"}
            checked={MapSet.member?(@selected_ids, to_string(source.id))}
            phx-click="toggle_source_selection"
            phx-value-id={source.id}
          />
          <div class="flex flex-col gap-3">
            <div class="min-w-0">
              <div class="flex items-start gap-3">
                <div class="flex min-h-11 items-center">
                  <SourceHTML.source_status_switch
                    source={source}
                    downloading={MapSet.member?(@downloading_ids, source.id)}
                    id_prefix="mobile"
                  />
                </div>

                <div class="min-w-0 flex-1">
                  <.subtle_link href={~p"/sources/#{source.id}"} class="flex min-h-11 items-center">
                    <span class="block text-pretty break-words font-medium text-theme-on-surface">{source.custom_name}</span>
                  </.subtle_link>

                  <div class="mt-1 flex flex-wrap items-center gap-2">
                    <.source_profile_picker source={source} media_profiles={@media_profiles} />
                    <.source_index_frequency
                      :if={@source_type != :videos}
                      source={source}
                      id={"source-indexing-mobile-#{source.id}"}
                      show_icon
                      class="text-xs text-theme-on-surface-muted"
                    />
                    <.source_retention
                      :if={@source_type != :videos}
                      source={source}
                      id={"source-retention-mobile-#{source.id}"}
                      timezone={@timezone}
                      confirm={confirm_for(@cutoff_confirm, source)}
                      show_icon
                      class="text-xs text-theme-on-surface-muted"
                    />
                  </div>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3">
              <.tooltip tooltip="Edit" position="top" tooltip_class="text-nowrap">
                <.icon_link
                  href={~p"/sources/#{source.id}/edit"}
                  icon="hero-pencil-square"
                  aria-label="Edit"
                  class="mx-1"
                />
              </.tooltip>
              <.source_delete_button source={source} />
              <.source_row_actions
                source={source}
                return_to={@return_to}
                downloading={MapSet.member?(@downloading_ids, source.id)}
              />
            </div>
          </div>

          <dl class="grid grid-cols-1 gap-3 text-sm">
            <div class="flex items-start justify-between gap-3">
              <dt class="text-theme-on-surface-muted">Pending</dt>

              <dd class="text-right text-theme-on-surface">
                <.subtle_link
                  href={~p"/sources/#{source.id}/#tab-pending"}
                  class="inline-flex min-h-11 min-w-11 items-center justify-center"
                >
                  <.localized_number number={source.pending_count} />
                </.subtle_link>
              </dd>
            </div>

            <div class="flex items-start justify-between gap-3">
              <dt class="text-theme-on-surface-muted">Downloaded</dt>

              <dd class="text-right text-theme-on-surface">
                <.subtle_link
                  href={~p"/sources/#{source.id}/#tab-downloaded"}
                  class="inline-flex min-h-11 min-w-11 items-center justify-center"
                >
                  <.localized_number number={source.downloaded_count} />
                </.subtle_link>
              </dd>
            </div>

            <div class="flex items-start justify-between gap-3">
              <dt class="text-theme-on-surface-muted">Size</dt>

              <dd class="text-right text-theme-on-surface">
                <.readable_filesize byte_size={source.media_size_bytes} />
              </dd>
            </div>
          </dl>
        </article>
      </div>

      <div :if={@sources != []} id="source-table" data-view="table" class="@container hidden md:block">
        <.table rows={@sources} sort_key={@sort_key} sort_direction={@sort_direction} compact rounded={false}>
          <:col
            :let={source}
            label="Select"
            header={
              select_all_header(%{
                selected_ids: @selected_ids,
                total_record_count: @total_record_count,
                sources: @sources
              })
            }
            class="w-px align-middle"
          >
            <.input
              type="checkbox"
              id={"source-select-table-#{source.id}"}
              name="source_selection"
              label="Select"
              label_class="sr-only"
              aria-label={"Select #{source.custom_name}"}
              checked={MapSet.member?(@selected_ids, to_string(source.id))}
              phx-click="toggle_source_selection"
              phx-value-id={source.id}
            />
          </:col>

          <:col
            :let={source}
            label="Status"
            label_icon="hero-bolt"
            sort_key="status"
            class="w-px text-center align-middle"
          >
            <SourceHTML.source_status_switch
              source={source}
              downloading={MapSet.member?(@downloading_ids, source.id)}
              id_prefix="table"
            />
          </:col>

          <:col
            :let={source}
            label="Name"
            sort_key="custom_name"
            class="w-full min-w-40 whitespace-normal align-middle @max-3xl:min-w-28"
          >
            <div data-source-id={source.id} class="min-w-0 leading-6 text-pretty break-words whitespace-normal">
              <.subtle_link href={~p"/sources/#{source.id}"}>{source.custom_name}</.subtle_link>
            </div>
          </:col>

          <:col :let={source} label="Type" sort_key="collection_type">
            <SourceHTML.collection_type_badge collection_type={source.collection_type} class="@max-5xl:hidden" />
            <span class="hidden @max-5xl:inline-flex">
              <.tooltip
                tooltip={SourceHTML.collection_type_label(source.collection_type) || "Unknown"}
                position="top"
              >
                <.icon
                  name={SourceHTML.collection_type_icon(source.collection_type)}
                  class="h-5 w-5 text-theme-on-surface-muted"
                />
                <span class="sr-only">{SourceHTML.collection_type_label(source.collection_type) || "Unknown"}</span>
              </.tooltip>
            </span>
          </:col>

          <:col
            :let={source}
            label="Pending"
            label_icon="hero-queue-list"
            sort_key="pending_count"
            class="text-center tabular-nums"
          >
            <.subtle_link href={~p"/sources/#{source.id}/#tab-pending"}>
              <.localized_number number={source.pending_count} />
            </.subtle_link>
          </:col>

          <:col
            :let={source}
            label="Downloaded"
            label_icon="hero-check-circle"
            sort_key="downloaded_count"
            class="text-center tabular-nums"
          >
            <.subtle_link href={~p"/sources/#{source.id}/#tab-downloaded"}>
              <.localized_number number={source.downloaded_count} />
            </.subtle_link>
          </:col>

          <:col
            :let={source}
            label="Size"
            sort_key="media_size_bytes"
            class="whitespace-nowrap"
            column_class="@max-3xl:hidden"
          >
            <.readable_filesize byte_size={source.media_size_bytes} />
          </:col>

          <:col :let={source} label="Media Profile" sort_key="media_profile_name" class="max-w-64 align-middle">
            <.source_profile_picker
              source={source}
              media_profiles={@media_profiles}
              text_class="max-w-38 truncate @max-3xl:max-w-24"
              chevron_class="@max-3xl:hidden!"
            />
          </:col>

          <:col
            :let={source}
            :if={@source_type != :videos}
            label="Index Frequency"
            label_icon="hero-clock"
            sort_key="index_frequency"
            class="text-center"
          >
            <.source_index_frequency
              source={source}
              id={"source-indexing-#{source.id}"}
              class="mx-auto"
              chevron_class="@max-3xl:hidden!"
            />
          </:col>

          <:col
            :let={source}
            :if={@source_type != :videos}
            label="Download Retention Cutoff"
            label_icon="hero-archive-box-x-mark"
            sort_key="download_cutoff"
            class="text-center"
          >
            <.source_retention
              source={source}
              id={"source-retention-#{source.id}"}
              timezone={@timezone}
              confirm={confirm_for(@cutoff_confirm, source)}
              class="mx-auto"
              chevron_class="@max-3xl:hidden!"
            />
          </:col>

          <:col
            :let={source}
            label=""
            class="sticky right-0 bg-theme-surface-1 align-middle has-[[aria-expanded=true]]:z-10 [tr:hover_&]:bg-theme-surface-2"
          >
            <div class="flex h-full items-center justify-end gap-2">
              <div class="flex items-center gap-2 @max-4xl:hidden">
                <.tooltip tooltip="Edit" position="top" tooltip_class="text-nowrap">
                  <.icon_link
                    href={~p"/sources/#{source.id}/edit"}
                    icon="hero-pencil-square"
                    aria-label="Edit"
                    class="mx-1"
                  />
                </.tooltip>
                <.source_delete_button source={source} />
              </div>
              <.source_row_actions
                source={source}
                return_to={@return_to}
                downloading={MapSet.member?(@downloading_ids, source.id)}
                fold_edit_delete
              />
            </div>
          </:col>
        </.table>

        <section class="my-5 flex justify-center">
          <.live_pagination_controls page_number={@page} total_pages={@total_pages} />
        </section>
      </div>
    </div>

    <div :if={@view_mode == :grid}>
      <%!--
        The tab panel scrolls sideways for wide tables and clips anything drawn past its edge.
        This padding keeps the card focus ring visible on the outer columns.
      --%>
      <div
        id="source-poster-grid"
        data-view="poster-grid"
        class="grid grid-cols-1 gap-4 p-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
      >
        <%!-- Controls sit above the card's link. The glow marks a selected card or keyboard focus, not clicks. --%>
        <article
          :for={source <- @sources}
          id={"source-card-#{source.id}"}
          data-source-id={source.id}
          data-selected={to_string(MapSet.member?(@selected_ids, to_string(source.id)))}
          class={[
            "theme-surface-accent group relative transition hover:border-theme-primary/70 hover:shadow-m3-2",
            "has-[[aria-expanded=true]]:z-20",
            "has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-theme-primary has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-theme-bg",
            MapSet.member?(@selected_ids, to_string(source.id)) &&
              "ring-2 ring-theme-primary ring-offset-2 ring-offset-theme-bg"
          ]}
        >
          <.link
            href={~p"/sources/#{source.id}"}
            class="absolute inset-0 z-0 rounded-m3-lg focus-visible:outline-none"
            aria-label={"Open source #{source.custom_name}"}
          >
            <span class="sr-only">Open source {source.custom_name}</span>
          </.link>

          <div class="pointer-events-none relative z-10 flex h-full flex-col">
            <div
              x-data="{ image_loaded: false }"
              class="relative aspect-[16/10] rounded-t-m3-md bg-theme-surface-4"
            >
              <div
                x-show="!image_loaded"
                class="absolute inset-0 flex flex-col items-center justify-center gap-2 rounded-t-m3-md bg-theme-primary-container/30 p-4 text-center text-theme-on-primary-container"
                data-artwork-fallback
              >
                <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-theme-primary/20 text-xl font-bold shadow-xs">
                  {source_initials(source)}
                </span>
                <span class="text-pretty text-sm font-medium drop-shadow-xs">Artwork unavailable</span>
              </div>

              <img
                src={source_poster_url(source)}
                alt={"Artwork for #{source.custom_name}"}
                class="pointer-events-none absolute inset-0 h-full w-full rounded-t-m3-md object-cover"
                x-show="image_loaded"
                x-init="image_loaded = $el.complete && $el.naturalWidth > 0"
                x-on:load="image_loaded = true"
                x-on:error="image_loaded = false"
              />

              <button
                id={"source-select-grid-#{source.id}"}
                type="button"
                class={[
                  "theme-touch-target pointer-events-auto absolute left-2 top-2 inline-flex h-8 w-8 items-center justify-center rounded-full transition",
                  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-theme-primary",
                  if(MapSet.member?(@selected_ids, to_string(source.id)),
                    do: "bg-theme-primary text-theme-on-primary shadow-m3-2 ring-2 ring-theme-scrim/70",
                    else:
                      "border-2 border-theme-on-surface/90 bg-theme-scrim/50 opacity-0 ring-2 ring-theme-scrim/70 group-hover:opacity-100 focus-visible:opacity-100 max-sm:opacity-100"
                  )
                ]}
                aria-pressed={to_string(MapSet.member?(@selected_ids, to_string(source.id)))}
                aria-label={"Select #{source.custom_name}"}
                phx-click="toggle_source_selection"
                phx-value-id={source.id}
              >
                <.icon :if={MapSet.member?(@selected_ids, to_string(source.id))} name="hero-check" class="h-4 w-4" />
              </button>

              <div class="pointer-events-auto absolute right-2 top-2 flex items-center gap-1 opacity-0 transition group-hover:opacity-100 group-has-[:focus-visible]:opacity-100 max-sm:opacity-100 has-[[aria-expanded=true]]:opacity-100">
                <.icon_button
                  href={~p"/sources/#{source.id}/edit"}
                  icon_name="hero-pencil-square"
                  tooltip="Edit"
                  size="compact"
                />
                <.source_delete_button source={source} tooltip_position="bottom" />
                <.source_row_actions
                  source={source}
                  return_to={@return_to}
                  downloading={MapSet.member?(@downloading_ids, source.id)}
                  tooltip_position="bottom"
                />
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-4">
              <%!-- Reserves room for a two-line name so every card has the same height.
                A narrow card shows the source type as its icon only, leaving room for the frequency chip. --%>
              <div class={[
                if(@source_type == :videos, do: "theme-source-card-head-compact", else: "theme-source-card-head"),
                "@container flex flex-col gap-3"
              ]}>
                <div class="flex items-start justify-between gap-3">
                  <h3
                    class="line-clamp-2 min-w-0 break-words text-base font-semibold leading-5 text-theme-on-surface"
                    title={source.custom_name}
                  >
                    {source.custom_name}
                  </h3>
                  <div class="pointer-events-auto shrink-0">
                    <SourceHTML.source_status_switch
                      source={source}
                      downloading={MapSet.member?(@downloading_ids, source.id)}
                      id_prefix="grid"
                    />
                  </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-2 text-sm text-theme-on-surface">
                  <SourceHTML.collection_type_badge
                    collection_type={source.collection_type}
                    label_class="@max-3xs:sr-only"
                  />
                  <div :if={@source_type != :videos} class="pointer-events-auto shrink-0">
                    <.source_index_frequency
                      source={source}
                      id={"source-indexing-grid-#{source.id}"}
                      show_icon
                      class="text-xs text-theme-on-surface-muted"
                    />
                  </div>
                  <div :if={@source_type == :videos} class="pointer-events-auto max-w-full">
                    <.source_profile_picker
                      source={source}
                      media_profiles={@media_profiles}
                      text_class="max-w-32 truncate"
                    />
                  </div>
                </div>

                <div :if={@source_type != :videos} class="flex flex-wrap items-center justify-between gap-2">
                  <div class="pointer-events-auto max-w-full">
                    <.source_profile_picker
                      source={source}
                      media_profiles={@media_profiles}
                      text_class="max-w-32 truncate"
                    />
                  </div>
                  <div class="pointer-events-auto shrink-0">
                    <.source_retention
                      source={source}
                      id={"source-retention-grid-#{source.id}"}
                      timezone={@timezone}
                      confirm={confirm_for(@cutoff_confirm, source)}
                      show_icon
                      class="text-xs text-theme-on-surface-muted"
                    />
                  </div>
                </div>
              </div>

              <div class="mt-auto space-y-3">
                <dl :if={@source_type != :videos} class="grid grid-cols-2 gap-3 text-sm">
                  <div class="rounded-m3-sm bg-theme-surface-2/70 p-3">
                    <dt class="text-theme-on-surface-muted">Downloaded</dt>

                    <dd class="mt-1 font-semibold text-theme-on-surface">
                      <.localized_number number={source.downloaded_count} />
                    </dd>
                  </div>

                  <div class="rounded-m3-sm bg-theme-surface-2/70 p-3">
                    <dt class="text-theme-on-surface-muted">Pending</dt>

                    <dd class="mt-1 font-semibold text-theme-on-surface">
                      <.localized_number number={source.pending_count} />
                    </dd>
                  </div>
                </dl>
                <% progress = source_progress(source) %>
                <div class="space-y-2" data-progress-state={progress.state}>
                  <div class="flex items-center justify-between gap-2 text-xs text-theme-on-surface-muted">
                    <span class="shrink-0">Progress</span>
                    <span class="min-w-0 truncate text-right" title={progress.label}>{progress.label}</span>
                  </div>

                  <div
                    :if={progress.state == :known}
                    class="h-2 overflow-hidden rounded-full bg-theme-surface-4"
                    role="progressbar"
                    aria-label={"Download progress for #{source.custom_name}"}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={progress.percent}
                    aria-valuetext={progress.label}
                  >
                    <div
                      class="h-full rounded-full bg-theme-primary transition-all"
                      style={"width: #{progress.percent}%"}
                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>

      <section class="my-5 flex justify-center">
        <.live_pagination_controls page_number={@page} total_pages={@total_pages} />
      </section>
    </div>
  </:tab>

  <:tab_append>
    <%!-- The cookie lets the server open the list in the chosen view after leaving and coming back. --%>
    <div
      class="inline-flex items-center gap-1 rounded-m3-sm border border-theme-outline bg-theme-surface p-1"
      role="group"
      aria-label="Source view"
      x-data="{
        remember(view) {
          const url = new URL(location.href);
          url.searchParams.set('view', view);
          history.replaceState(null, '', url);
          document.cookie = `pinchflat_sources_view=${view}; path=/; max-age=31536000; SameSite=Lax`;
        }
      }"
    >
      <button
        type="button"
        class={[
          "theme-filter-button rounded-m3-xs",
          if(@view_mode == :table,
            do: "bg-theme-primary text-theme-on-primary",
            else: "text-theme-on-surface-muted hover:bg-theme-surface-2 hover:text-theme-on-surface"
          )
        ]}
        phx-click="view_change"
        phx-value-view={if @view_mode == :table, do: "grid", else: "table"}
        x-on:click={"remember('#{if @view_mode == :table, do: "grid", else: "table"}')"}
        aria-pressed={to_string(@view_mode == :table)}
        data-view-toggle="table"
      >
        <.icon name="hero-list-bullet" class="h-4 w-4" aria-hidden="true" /> <span class="max-sm:sr-only">Table</span>
      </button>

      <button
        type="button"
        class={[
          "theme-filter-button rounded-m3-xs",
          if(@view_mode == :grid,
            do: "bg-theme-primary text-theme-on-primary",
            else: "text-theme-on-surface-muted hover:bg-theme-surface-2 hover:text-theme-on-surface"
          )
        ]}
        phx-click="view_change"
        phx-value-view={if @view_mode == :table, do: "grid", else: "table"}
        x-on:click={"remember('#{if @view_mode == :table, do: "grid", else: "table"}')"}
        aria-pressed={to_string(@view_mode == :grid)}
        data-view-toggle="grid"
      >
        <.icon name="hero-squares-2x2" class="h-4 w-4" aria-hidden="true" />
        <span class="max-sm:sr-only">Poster Grid</span>
      </button>
    </div>
  </:tab_append>
</.tabbed_layout>
