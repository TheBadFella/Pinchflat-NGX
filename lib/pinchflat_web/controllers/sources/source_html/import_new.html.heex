<div class="mb-6 flex items-center gap-3">
  <.link
    href={~p"/sources"}
    aria-label="Back to sources"
    class="theme-icon-button theme-outline-button"
  >
    <.icon name="hero-arrow-left" class="h-5 w-5" />
  </.link>
  <h2 class="text-title-md2 font-bold text-theme-on-surface">Import Sources</h2>
</div>

<div class="theme-surface-raised px-5 py-6 sm:px-7.5">
  <p :if={is_nil(@preview)} class="mb-6 text-theme-on-surface-muted">
    Upload a text file with one YouTube channel, playlist, or video URL per line, or a Google Takeout subscriptions.csv file. Blank and repeated entries are skipped.
  </p>

  <p :if={is_nil(@preview)} class="mb-6 text-sm text-theme-on-surface-muted">
    Maximum 100 entries and 100 KB per file. CSV sources start with downloads paused; monitoring stays enabled.
    Text lists follow normal source settings and can start downloading. Previewing does not contact YouTube.
    Export subscriptions with <.link href="https://takeout.google.com/" target="_blank" rel="noopener noreferrer">Google Takeout</.link>.
    CSV columns: Channel Id, Channel Url, Channel Title.
  </p>

  <.form
    :if={is_nil(@preview)}
    for={%{}}
    as={:import}
    action={~p"/sources/import"}
    method="post"
    multipart
    class="max-w-xl space-y-5"
  >
    <.input
      name="import[file]"
      type="file"
      value={nil}
      accept=".txt,.csv,text/plain,text/csv"
      label="Source file"
      required
    />
    <div>
      <label for="import_media_profile_id" class="block text-sm font-medium text-theme-on-surface">Media Profile</label>
      <select
        id="import_media_profile_id"
        name="import[media_profile_id]"
        required
        class="theme-input theme-select mt-2 w-full rounded-m3-sm px-3 py-2 text-theme-on-surface"
      >
        <option value="">Choose a profile</option>
        <option :for={profile <- @media_profiles} value={profile.id}>{profile.name}</option>
      </select>
    </div>
    <.button rounding="rounded-m3-sm">Preview Sources</.button>
  </.form>

  <p :if={@error} class="mt-6 text-theme-error" role="alert">{@error}</p>

  {if @preview, do: live_render(@conn, PinchflatWeb.Sources.ImportLive, session: @preview)}
</div>
