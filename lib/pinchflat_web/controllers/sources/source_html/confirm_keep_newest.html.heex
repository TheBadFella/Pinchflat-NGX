<div class="mb-6 flex flex-row items-center gap-3">
  <.link href={~p"/sources/#{@source}/edit"} aria-label="Back" class="theme-icon-button theme-outline-button">
    <.icon name="hero-arrow-left" class="h-5 w-5" />
  </.link>
  <h2 class="ml-4 break-words text-title-md2 font-bold text-theme-on-surface">Confirm Keep Newest Limit</h2>
</div>

<section class="theme-surface-raised px-5 py-6 sm:px-7.5">
  <div class="max-w-5xl space-y-6">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-theme-on-surface-muted">{@source.custom_name}</p>
      <h3 class="mt-2 text-2xl font-bold text-theme-on-surface">
        Pinchflat-ngx will delete older downloads at the next cleanup
      </h3>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-theme-on-surface-muted">
        If this source keeps only its newest {@new_count} videos, {if @removable_count == 1,
          do: "1 older download",
          else: "#{@removable_count} older downloads"} outside that limit will be removed at the next scheduled
        cleanup. Review the count before saving.
      </p>
    </div>

    <section class="grid gap-4 sm:grid-cols-2">
      <div class="theme-status-card">
        <p class="text-xs font-semibold uppercase tracking-wide text-theme-on-surface-muted">Keep newest</p>
        <p class="mt-2 text-2xl font-bold text-theme-on-surface">{@new_count}</p>
      </div>
      <div class="theme-status-card">
        <p class="text-xs font-semibold uppercase tracking-wide text-theme-on-surface-muted">
          Deleted at next cleanup
        </p>
        <p class="mt-2 text-2xl font-bold text-theme-on-surface">{@removable_count}</p>
      </div>
    </section>

    <section class="theme-surface-accent rounded-m3-lg border border-theme-outline/70 px-5 py-4">
      <div class="flex items-start gap-3">
        <.icon name="hero-information-circle" class="mt-0.5 h-5 w-5 shrink-0 text-theme-primary" />
        <p class="text-sm leading-6 text-theme-on-surface-muted">
          Items with Prevent Automatic Deletion enabled never count towards the limit and are never removed.
          Watch-protected items count towards the limit but are never deleted, so the number of downloaded files can
          stay above {@new_count}. Raising the limit later allows older videos to be re-downloaded.
        </p>
      </div>
    </section>

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
      <.link
        href={~p"/sources/#{@source}/edit"}
        class="theme-outline-button inline-flex justify-center px-5 py-3 text-sm font-medium"
      >
        Cancel
      </.link>

      <.form for={%{}} action={~p"/sources/#{@source}"} method="put">
        <input type="hidden" name="confirm_keep_newest" value="true" />
        <.resubmitted_source_inputs source_params={@source_params} extra_params={@extra_params} />
        <.button rounding="rounded-m3-sm">Confirm and Save</.button>
      </.form>
    </div>
  </div>
</section>
