<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  method={@method}
  x-data="{ advancedMode: !!JSON.parse(localStorage.getItem('advancedMode')) }"
  x-init="$watch('advancedMode', value => localStorage.setItem('advancedMode', JSON.stringify(value)))"
>
  <.error :if={@changeset.action}>Oops, something went wrong! Please check the errors below.</.error>

  <section x-data={
    """
    {
      mediaProfileId: null,
      retentionOverride: #{Jason.encode!(to_string(f[:retention_period_days].value || ""))},
      profileRetention: #{Jason.encode!(Map.new(@media_profiles, &{to_string(&1.id), &1.retention_period_days}))},
      get retentionPolicySummary() {
        const raw = String(this.retentionOverride ?? '').trim();
        const inherited = raw === '';
        if (!inherited && (!/^[0-9]+$/.test(raw) || !Number.isSafeInteger(Number(raw)))) {
          return 'Enter 0 or a positive whole number, or leave blank to inherit.';
        }
        if (inherited && !Object.prototype.hasOwnProperty.call(this.profileRetention, this.mediaProfileId)) {
          return 'Choose a media profile to see inherited retention';
        }
        const days = inherited ? (this.profileRetention[this.mediaProfileId] ?? 0) : Number(raw);
        const origin = inherited ? 'profile default' : 'source override';
        const policy = days === 0 ? 'No age-based cleanup' : days + (days === 1 ? ' day' : ' days');
        return policy + ' (' + origin + ')';
      },
      sourceUrl: '',
      sourceType: '#{Ecto.Changeset.get_field(@changeset, :source_type, :automatic)}',
      cutoffDate: '#{f[:download_cutoff_date].value}',
      indexCutoffDate: '#{f[:index_cutoff_date].value}',
      isPlaylist: #{Ecto.Changeset.get_field(@changeset, :collection_type) == :playlist},
      get sourceTypeLabel() {
        return {
          automatic: 'Source URL',
          channel: 'Channel URL',
          playlist: 'Playlist URL',
          video: 'Video URL'
        }[this.sourceType] || 'Source URL'
      },
      get sourceTypeHelp() {
        return {
          automatic: 'URL of a channel, playlist, or single video (required). Automatic detection preserves existing Pinchflat-ngx behavior.',
          channel: 'URL of a YouTube channel (required). Pinchflat-ngx will reject a URL that resolves to a playlist or video.',
          playlist: 'URL of a YouTube playlist (required). Pinchflat-ngx will reject a URL that resolves to a channel or video.',
          video: 'URL of a single YouTube video (required). Video sources are indexed once and fast indexing is disabled automatically.'
        }[this.sourceType] || 'URL of a channel, playlist, or single video (required).'
      },
      get looksLikePlaylist() { return this.isPlaylist || /[?&]list=|\\/playlist/.test(this.sourceUrl) },
      get indexCutoffAfterDownloadCutoff() {
        return !!(this.indexCutoffDate && this.cutoffDate && this.indexCutoffDate > this.cutoffDate)
      }
    }
    """
  }>
    <section class="flex flex-wrap justify-between items-center gap-4 mt-4">
      <h3 class="text-2xl text-theme-on-surface">General Options</h3>

      <div class="flex items-center gap-3">
        <span class="text-sm font-medium text-theme-on-surface-muted">Editing Mode</span>
        <div class="theme-surface-accent inline-flex rounded-full p-1 shadow-m3-1">
          <button
            type="button"
            class="theme-filter-button rounded-full"
            x-bind:class="advancedMode ? 'text-theme-on-surface-muted hover:text-theme-on-surface' : 'bg-theme-primary text-theme-on-primary shadow-m3-1'"
            x-on:click="advancedMode = false"
            x-bind:aria-pressed="!advancedMode"
          >
            Standard
          </button>

          <button
            type="button"
            class="theme-filter-button rounded-full"
            x-bind:class="advancedMode ? 'bg-theme-primary text-theme-on-primary shadow-m3-1' : 'text-theme-on-surface-muted hover:text-theme-on-surface'"
            x-on:click="advancedMode = true"
            x-bind:aria-pressed="advancedMode"
          >
            Advanced
          </button>
        </div>
      </div>
    </section>

    <section :if={@new_source}>
      <.input
        field={f[:source_type]}
        options={Source.source_type_options()}
        type="select"
        label="Source Type"
        help="Choose Automatic to keep Pinchflat-ngx's existing URL detection, or select the type you expect before inspection."
        x-model="sourceType"
      />
      <label for={f[:original_url].id} class="mt-5 mb-2 inline-block text-sm font-medium text-theme-on-surface">
        <span x-text="sourceTypeLabel"></span>
      </label>

      <.input
        field={f[:original_url]}
        type="text"
        x-init="$el.focus()"
        x-model.fill="sourceUrl"
      />
      <p class="mt-1 text-sm leading-5 text-theme-on-surface-muted" x-text="sourceTypeHelp"></p>
    </section>

    <.input
      :if={!@new_source}
      field={f[:original_url]}
      type="text"
      label="Source URL"
      help="URL of a channel, playlist, or single video (required). Single video sources are indexed once and fast indexing is disabled automatically"
      x-init="$el.focus()"
      x-model.fill="sourceUrl"
    />
    <h3 class="mt-8 text-2xl text-theme-on-surface">Source Metadata</h3>

    <p class="mt-2 max-w-prose text-sm text-theme-on-surface-muted">
      Name and description are refreshed from source metadata unless you lock the individual field. Locked fields
      can still be edited and saved here; the lock only affects automated refreshes.
    </p>

    <.input
      field={f[:custom_name]}
      type="text"
      label="Source Name"
      help="The name shown throughout Pinchflat-ngx. It will be refreshed from source metadata unless locked."
    />
    <.input
      field={f[:custom_name_locked]}
      type="toggle"
      label="Lock Source Name"
      help="Keep the current name when automated metadata refreshes run."
    />
    <.input
      field={f[:description]}
      type="textarea"
      label="Description"
      help="The source description shown in Pinchflat-ngx. It will be refreshed from source metadata unless locked."
    />
    <.input
      field={f[:description_locked]}
      type="toggle"
      label="Lock Description"
      help="Keep the current description when automated metadata refreshes run."
    />
    <.input
      field={f[:media_profile_id]}
      options={Enum.map(@media_profiles, &{&1.name, &1.id})}
      type="select"
      label="Media Profile"
      help="Sets your preferences for what media to look for and how to store it"
      x-model.fill="mediaProfileId"
    />
    <h3 class="mt-8 text-2xl text-theme-on-surface">Indexing Options</h3>

    <section x-data={"{ fastIndexingEnabled: #{Ecto.Changeset.get_field(@changeset, :fast_index, false)} }"}>
      <.input
        field={f[:index_frequency_minutes]}
        options={friendly_index_frequencies()}
        type="select"
        label="Index Frequency"
        x-bind:disabled="fastIndexingEnabled == true"
        x-init="$watch('fastIndexingEnabled', v => v && ($el.value = 30 * 24 * 60, $el.dispatchEvent(new Event('change', { bubbles: true }))))"
        help="Indexing is the process of checking for media to download. For best results, set this to the longest delay you can tolerate for this source"
      />
      <div phx-click={show_modal("upgrade-modal")}>
        <.input
          field={f[:fast_index]}
          type="toggle"
          label="Use Fast Indexing"
          label_suffix="(pro)"
          help="Not recommended for playlists. Single video sources always disable this option. Overrides 'Index Frequency'. See below for more details (seriously, there's a TL;DR that's worth reading)"
          x-model="fastIndexingEnabled"
        />
      </div>
    </section>

    <.input
      field={f[:index_cutoff_date]}
      type="text"
      label="Indexing Cutoff Date"
      placeholder="YYYY-MM-DD"
      maxlength="10"
      pattern="((?:19|20)[0-9][0-9])-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])"
      title="YYYY-MM-DD"
      help="Stop indexing a channel once it reaches videos uploaded before this date — big time-saver for channels with a large back catalog. Set it a few days <em>before</em> the Download Cutoff Date for safety. Only applies to YouTube channels; ignored for playlists. A few videos from before this date may still be indexed (but not downloaded) — especially on channels with few videos or when Fast Indexing is enabled, since those checks look at the most recent videos regardless of date. Leave blank to index everything"
      html_help={true}
      x-model="indexCutoffDate"
      x-bind:disabled="looksLikePlaylist"
    />
    <p x-cloak x-show="looksLikePlaylist" class="mt-1 text-sm text-theme-warning">
      The Indexing Cutoff Date doesn't apply to playlists — they aren't ordered by upload date, so
      indexing can't safely stop early.
    </p>

    <p x-cloak x-show="indexCutoffAfterDownloadCutoff" class="mt-1 text-sm text-theme-warning">
      The Indexing Cutoff Date is after the Download Cutoff Date — media between the two dates would
      never be indexed, so it could never be downloaded. Set it on or before the Download Cutoff
      Date.
    </p>

    <h3 class="mt-8 text-2xl text-theme-on-surface">
      Downloading Options
    </h3>

    <section
      class="space-y-3"
      x-data={
        Phoenix.json_library().encode!(%{
          downloadMembersOnlyMedia: Ecto.Changeset.get_field(@changeset, :download_members_only_media),
          cookieBehaviour: to_string(Ecto.Changeset.get_field(@changeset, :cookie_behaviour)),
          playerClient: to_string(Ecto.Changeset.get_field(@changeset, :player_client) || ""),
          fallbacks: (Ecto.Changeset.get_field(@changeset, :player_client_fallbacks) || []) |> Enum.map(&to_string/1),
          candidateFallback: ""
        })
      }
    >
      <.input
        field={f[:download_media]}
        type="toggle"
        label="Download Media"
        help="Unchecking still indexes media but it won't be downloaded until you enable this option"
      />
      <.input
        field={f[:download_public_media]}
        type="toggle"
        label="Download Public and Unlisted Media"
        help="Controls media that yt-dlp reports as public or unlisted"
      />
      <.input
        field={f[:download_members_only_media]}
        type="toggle"
        label="Download Members-only Media"
        help="Includes subscriber-only, premium-only, and media that requires authentication"
        x-model="downloadMembersOnlyMedia"
      />
      <section :if={@show_delay_automatic_download} class="mt-3">
        <.input
          field={f[:delay_automatic_download]}
          type="toggle"
          label="Delay Automatic Download"
          help="For playlists only. Index first, then send me to a selection screen so I can choose which items to download."
        />
      </section>

      <.input
        field={f[:cookie_behaviour]}
        options={friendly_cookie_behaviours()}
        type="select"
        label="Cookie Behaviour"
        help="Uses your YouTube cookies for this source (if configured). 'When Needed' tries to minimize cookie usage except for certain indexing and downloading tasks. See docs"
        x-model="cookieBehaviour"
      />
      <.input
        field={f[:player_client]}
        options={friendly_player_clients()}
        type="select"
        label="Primary YouTube Player Client"
        help="Overrides yt-dlp's default YouTube player-client selection for this source. Default is recommended unless you need a specific client."
        x-model="playerClient"
      />
      <div class="mt-4 rounded-m3-sm border border-theme-outline/40 bg-theme-surface-2 p-4">
        <div class="mb-3">
          <h4 class="text-sm font-semibold text-theme-on-surface">Client Fallback Chain</h4>

          <p class="text-xs text-theme-on-surface-muted mt-1">
            If the primary client encounters an HTTP 403 or bot check, Pinchflat will sequentially try these fallback clients in order (up to 4 total clients).
          </p>
        </div>
        <input type="hidden" name="source[player_client_fallbacks][]" value="" />
        <div x-show="fallbacks.length > 0" class="space-y-2 mb-3">
          <template x-for="(fb, idx) in fallbacks" x-bind:key="fb">
            <div class="flex items-center justify-between rounded-m3-xs border border-theme-outline/30 bg-theme-surface-1 px-3 py-2 text-xs">
              <input type="hidden" name="source[player_client_fallbacks][]" x-bind:value="fb" />
              <div class="flex items-center gap-2">
                <span class="font-mono text-theme-on-surface-muted" x-text="`#${idx + 1}`"></span>
                <span class="font-medium text-theme-on-surface font-mono" x-text="fb"></span>
              </div>

              <div class="flex items-center gap-1">
                <button
                  type="button"
                  class="theme-icon-button theme-outline-button text-xs"
                  x-bind:disabled="idx === 0"
                  @click="
                    const temp = fallbacks[idx - 1];
                    fallbacks[idx - 1] = fallbacks[idx];
                    fallbacks[idx] = temp;
                    fallbacks = [...fallbacks];
                  "
                  title="Move Up"
                  aria-label="Move Up"
                >
                  ↑
                </button>

                <button
                  type="button"
                  class="theme-icon-button theme-outline-button text-xs"
                  x-bind:disabled="idx === fallbacks.length - 1"
                  @click="
                    const temp = fallbacks[idx + 1];
                    fallbacks[idx + 1] = fallbacks[idx];
                    fallbacks[idx] = temp;
                    fallbacks = [...fallbacks];
                  "
                  title="Move Down"
                  aria-label="Move Down"
                >
                  ↓
                </button>

                <button
                  type="button"
                  class="theme-icon-button theme-outline-button text-xs text-theme-error hover:border-theme-error"
                  @click="
                    fallbacks.splice(idx, 1);
                    fallbacks = [...fallbacks];
                  "
                  title="Remove"
                  aria-label="Remove"
                >
                  ✕
                </button>
              </div>
            </div>
          </template>
        </div>

        <div x-show="fallbacks.length === 0" class="text-xs text-theme-on-surface-muted italic mb-3">
          No fallback clients configured. Only the primary client (or yt-dlp default) will be used.
        </div>

        <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center">
          <select
            x-model="candidateFallback"
            x-bind:disabled="!playerClient || (playerClient ? 1 : 0) + fallbacks.length >= 4"
            class="theme-input rounded-m3-xs px-3 py-1.5 text-xs text-theme-on-surface focus:ring-0"
          >
            <option value="">Select fallback client to add...</option>

            <%= for {label, val} <- Source.player_client_options() do %>
              <option
                value={to_string(val)}
                x-show={
                  "playerClient !== '#{to_string(val)}' && !fallbacks.includes('#{to_string(val)}')"
                }
              >
                {label} ({to_string(val)})
              </option>
            <% end %>
          </select>

          <button
            type="button"
            class="theme-button theme-outline-button"
            x-bind:disabled="!candidateFallback || (playerClient ? 1 : 0) + fallbacks.length >= 4"
            @click="
              if (candidateFallback && !fallbacks.includes(candidateFallback) && candidateFallback !== playerClient) {
                fallbacks.push(candidateFallback);
                fallbacks = [...fallbacks];
                candidateFallback = '';
              }
            "
          >
            + Add Fallback
          </button>
        </div>

        <p x-show="!playerClient" class="text-xs text-theme-on-surface-muted mt-2">
          Select a primary YouTube Player Client above to enable fallback chains.
        </p>

        <p
          x-show="playerClient && (playerClient ? 1 : 0) + fallbacks.length >= 4"
          class="text-xs text-theme-on-surface-muted mt-2"
        >
          Maximum of 4 total clients reached (1 primary + 3 fallbacks).
        </p>
      </div>

      <div
        x-cloak
        x-show="downloadMembersOnlyMedia && cookieBehaviour === 'disabled'"
        class="theme-status-card theme-status-card-warning text-sm"
        role="alert"
      >
        Members-only media may fail without cookies. Configure a cookies.txt file and select a cookie behaviour if
        you want Pinchflat-ngx to access it; this setting will not enable cookies automatically.
      </div>

      <div
        x-cloak
        x-show="[playerClient, ...fallbacks].includes('web_creator') && cookieBehaviour !== 'all_operations'"
        class="theme-status-card theme-status-card-warning text-sm"
        role="alert"
      >
        Web Creator requires account cookies. Select All Operations to use this client reliably.
      </div>

      <div
        x-cloak
        x-show="[playerClient, ...fallbacks].some(c => ['android', 'ios', 'tv_simply'].includes(c)) && cookieBehaviour !== 'disabled'"
        class="theme-status-card theme-status-card-warning text-sm"
        role="alert"
      >
        One or more configured player clients (Android, iOS, TV Simply) do not support account cookies. Set Cookie Behaviour to Disabled before saving.
      </div>
    </section>

    <section class="theme-surface-accent mt-3 px-6 py-5">
      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_max-content] lg:items-start">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-3">
            <p class="text-sm font-medium text-theme-on-surface">Shared `cookies.txt` file</p>

            <span
              :if={@cookie_file_exists}
              class="theme-field-shell theme-field-shell-active inline-flex w-auto rounded-full"
            >
              <span class={[
                "inline-flex items-center rounded-full px-3 py-1 text-xs font-medium",
                if(@cookie_file_configured,
                  do: "bg-theme-primary-container/25 text-theme-on-primary-container",
                  else: "bg-theme-surface-2 text-theme-on-surface-muted"
                )
              ]}>
                {if @cookie_file_configured, do: "Ready", else: "Needs Contents"}
              </span>
            </span>
          </div>

          <p class="max-w-2xl text-sm leading-6 text-theme-on-surface-muted">
            <%= cond do %>
              <% @cookie_file_configured -> %>
                Cookie file is configured and ready to use.
              <% @cookie_file_exists -> %>
                Cookie file exists but is currently blank.
              <% true -> %>
                Cookie file does not exist yet.
            <% end %>
          </p>

          <p class="break-all font-mono text-xs leading-6 text-theme-on-surface-muted">{@cookie_file_path}</p>
        </div>

        <div class="flex flex-wrap items-start content-start gap-3 self-start lg:flex-nowrap lg:justify-end lg:self-start lg:justify-self-end">
          <.button
            type="button"
            class="w-auto px-5 py-3 text-sm"
            color="bg-theme-primary text-theme-on-primary"
            phx-click={show_modal("cookie-upload-modal")}
          >
            Upload cookies.txt
          </.button>

          <.button
            type="button"
            class="w-auto px-5 py-3 text-sm"
            color="theme-outline-button"
            phx-click={show_modal("cookie-paste-modal")}
          >
            Paste Cookie Contents
          </.button>

          <.button
            :if={@cookie_file_exists}
            type="button"
            class="w-auto px-5 py-3 text-sm"
            color="theme-outline-button"
            phx-click={show_modal("cookie-inspect-modal")}
          >
            Inspect Cookie File
          </.button>
        </div>
      </div>
    </section>

    <section x-show="advancedMode">
      <.input
        field={f[:min_duration_seconds]}
        type="number"
        label="Minimum Duration (seconds)"
        min="0"
        help="Minimum duration of the media to be downloaded. Can be blank"
      />
      <.input
        field={f[:max_duration_seconds]}
        type="number"
        label="Maximum Duration (seconds)"
        min="0"
        help="Maximum duration of the media to be downloaded. Can be blank"
      />
    </section>

    <section>
      <div class="grid grid-cols-1 items-start gap-3 sm:grid-cols-2">
        <.input
          field={f[:download_cutoff_date]}
          type="text"
          label="Download Cutoff Date"
          placeholder="YYYY-MM-DD"
          maxlength="10"
          pattern="((?:19|20)[0-9][0-9])-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])"
          title="YYYY-MM-DD"
          x-model="cutoffDate"
        />
        <.input
          label="Cutoff preset"
          prompt="Select preset"
          name="download_cutoff_date_preset"
          value=""
          options={cutoff_date_presets()}
          type="select"
          inputclass="w-full"
          x-on:change={"cutoffDate = $event.target.value || '#{f[:download_cutoff_date].value}'"}
        />
      </div>
      <p class="mt-2 text-sm text-theme-on-surface-muted">
        Automatically download media published on or after this date. Scheduled cleanup also deletes unprotected
        downloaded media from before this date, including manual downloads, even within their retention period.
        Leave blank for no cutoff. Prevent Automatic Deletion on a media item's Edit page overrides both cutoff
        and retention cleanup.
      </p>
    </section>

    <.input
      field={f[:retention_period_days]}
      type="number"
      label="Retention override (days)"
      placeholder="Inherit media profile"
      x-model="retentionOverride"
      min="0"
      help="Leave blank to follow the selected media profile. Enter 0 to disable age-based cleanup for this source."
      html_help={true}
    />
    <div class="theme-surface-accent rounded-m3-sm p-4">
      <p class="text-sm font-medium text-theme-on-surface">Effective retention</p>
      <p
        id="source-retention-effective"
        class="mt-1 text-sm text-theme-on-surface"
        aria-live="polite"
        x-text="retentionPolicySummary"
      >
        {retention_form_preview(@changeset, @media_profiles)}
      </p>
      <p class="mt-2 text-sm text-theme-on-surface-muted">
        Age is counted from download time. Saving a shorter period or changing the profile can make existing
        downloads eligible at the next cleanup. A publication-date cutoff can delete files sooner.
        Prevent Automatic Deletion overrides both cleanup rules.
      </p>
    </div>

    <.input
      field={f[:watch_window_days]}
      type="number"
      label="Watch window (days)"
      min="0"
      max="365"
      help="Leave blank to use the media profile setting. Set 0 to disable monitoring, or 1–365 days from the first completed download. Publication date and later downloads do not change the start or end date. Pinchflat checks duration and visibility, saves the original before replacement, and blocks replacement when a change is suspected. Checks stop at the end date; saved originals and protection for detected changes remain."
      html_help={true}
    />
    <section x-show="advancedMode">
      <h3 class="mt-8 text-2xl text-theme-on-surface">Advanced Options</h3>

      <p class="mt-2 text-sm text-theme-on-surface-muted">Tread carefully</p>

      <.input
        field={f[:title_filter_regex]}
        type="text"
        label="Title Filter Regex"
        placeholder="(?i)^How to Bike$"
        help={title_filter_regex_help()}
        html_help={true}
      />
      <section
        x-data={
          """
          {
            placeholders: JSON.parse('#{output_path_template_override_placeholders(@media_profiles)}'),
            inputValue: null,
            sourceFolderValue: #{Phoenix.json_library().encode!(Phoenix.HTML.Form.normalize_value("text", f[:download_subdirectory].value) || "")},
            sourceFolderPickerOpen: false
          }
          """
        }
        x-on:load-template="inputValue = placeholders[mediaProfileId]"
      >
        <.input
          field={f[:download_subdirectory]}
          type="text"
          inputclass="font-mono"
          label="Source folder"
          placeholder="Kids/Bluey"
          help={download_subdirectory_help()}
          x-model="sourceFolderValue"
        />
        <section
          :if={Enum.any?(@available_folders)}
          class="theme-surface-accent mt-3 overflow-hidden rounded-m3-lg"
          x-bind:class="sourceFolderPickerOpen ? 'ring-1 ring-theme-primary/40' : ''"
        >
          <button
            type="button"
            class="flex w-full items-center justify-between gap-4 px-4 py-4 text-left md:px-6"
            x-on:click="sourceFolderPickerOpen = !sourceFolderPickerOpen"
            x-bind:aria-expanded="sourceFolderPickerOpen"
          >
            <div>
              <h3 class="text-base font-semibold text-theme-on-surface">Pick existing source folder</h3>

              <p class="mt-1 text-sm text-theme-on-surface-muted">
                Choose from folders already under your media root instead of typing the path manually.
              </p>
            </div>

            <.icon
              name="hero-folder-open"
              class="h-5 w-5 shrink-0 text-theme-on-surface-muted transition duration-200"
              x-bind:class="sourceFolderPickerOpen ? 'text-theme-primary' : ''"
            />
          </button>

          <div
            x-cloak
            x-show="sourceFolderPickerOpen"
            x-transition.opacity.duration.150ms
            class="border-t border-theme-outline/60 px-4 py-4 md:px-6"
          >
            <div class="max-h-60 space-y-2 overflow-y-auto pr-1">
              <button
                :for={folder <- @available_folders}
                type="button"
                data-folder={folder}
                class="flex w-full items-center justify-between rounded-m3-sm border border-theme-outline/70 bg-theme-surface-2 px-4 py-3 text-left font-mono text-sm text-theme-on-surface transition hover:bg-theme-surface-3"
                x-bind:class="$el.dataset.folder === sourceFolderValue ? 'border-theme-primary bg-theme-primary-container/25 text-theme-on-primary-container' : ''"
                x-on:click="sourceFolderValue = $el.dataset.folder; sourceFolderPickerOpen = false"
              >
                <span class="truncate">{folder}</span>
                <.icon
                  name="hero-check"
                  class="h-4 w-4 shrink-0 text-theme-primary"
                  x-show="$el.parentElement.dataset.folder === sourceFolderValue"
                />
              </button>
            </div>
          </div>
        </section>

        <div class="mt-4">
          <.input
            field={f[:output_path_template_override]}
            type="text"
            inputclass="font-mono"
            label="Output path template override"
            help={output_path_template_override_help()}
            html_help={true}
            x-bind:placeholder="placeholders[mediaProfileId]"
            x-model.fill="inputValue"
          >
            <:input_append>
              <button
                type="button"
                class="ml-3 inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-m3-sm border border-theme-outline/70 bg-theme-surface-2 px-3 py-3 text-sm font-medium text-theme-on-surface transition hover:bg-theme-surface-3 sm:px-4 md:ml-4"
                title="Start from the media profile template, then tweak only what you need for this source."
                aria-label="Insert media profile template. Start from the media profile template, then tweak only what you need for this source."
                x-on:click="inputValue = placeholders[mediaProfileId]"
              >
                <span class="sm:hidden"><.icon name="hero-document-duplicate" class="h-5 w-5" /></span>
                <span class="hidden sm:inline">Insert media profile template</span>
              </button>
            </:input_append>
          </.input>
        </div>
      </section>

      <.input
        field={f[:output_path_template_shorts_override]}
        type="text"
        inputclass="font-mono"
        label="Shorts output path template override (optional)"
        help="Used for this source's YouTube Shorts. Leave blank to use the media profile's Shorts template, or the primary output path template if neither is set. Must end with .{{ ext }}. Saving leaves existing files in place; later re-downloads and quality upgrades use the new path."
      />
      <details class="mt-2 text-sm text-theme-on-surface-muted">
        <summary class="cursor-pointer py-3 font-medium text-theme-on-surface">How Shorts are identified</summary>
        <p class="mt-2">
          Channel tabs identify Shorts directly. Mixed playlists and fast indexing use the URL and existing
          duration/aspect-ratio detection, which can misclassify short vertical videos.
        </p>
      </details>
      <p class="mt-4 text-sm text-theme-on-surface-muted">
        Need custom yt-dlp arguments for this source? After saving, add them to
        <code>extras/yt-dlp-configs/source-123-config.txt</code>
        using the saved source ID. Pinchflat already loads
        per-source, per-profile, per-media-item, and base yt-dlp config files during downloads.
      </p>
    </section>

    <div class="my-10 w-full">
      <.button class="w-full sm:mb-7.5 sm:w-auto" rounding="rounded-m3-sm">Save Source</.button>
    </div>

    <section
      x-data="{ sourceFolderHelpOpen: false }"
      class="theme-surface-accent mb-5 w-full overflow-hidden rounded-m3-lg"
    >
      <button
        type="button"
        class="flex w-full items-center justify-between gap-4 px-4 py-4 text-left md:px-6"
        x-on:click="sourceFolderHelpOpen = !sourceFolderHelpOpen"
        x-bind:aria-expanded="sourceFolderHelpOpen"
      >
        <div>
          <h3 class="text-lg font-semibold text-theme-on-surface">How source folders work?</h3>

          <p class="mt-1 text-sm text-theme-on-surface-muted">
            Source folders sit in front of the output template. Expand this for examples and edge cases.
          </p>
        </div>

        <.icon
          name="hero-chevron-down"
          class="h-5 w-5 shrink-0 text-theme-on-surface-muted transition duration-200"
          x-bind:class="sourceFolderHelpOpen ? 'rotate-180 text-theme-primary' : ''"
        />
      </button>

      <div
        x-cloak
        x-show="sourceFolderHelpOpen"
        x-transition.opacity.duration.150ms
        class="border-t border-theme-outline/60 px-4 py-4 text-sm text-theme-on-surface md:px-6"
      >
        <p>
          Pinchflat saves downloads to <code class="text-theme-on-surface">media root + source folder + output template</code>.
        </p>

        <p class="mt-3">
          Use <strong class="text-theme-on-surface">Source folder</strong>
          for the main folder, then keep your template focused on file naming or
          subfolders inside it.
        </p>

        <p class="mt-3">
          If both the source folder and the template point to the same folder name, it will be duplicated.
          Example: source folder <code class="text-theme-on-surface">Kids</code>
          plus template <code class="text-theme-on-surface">{~S(Kids/{{ title }}.{{ ext }})}</code>
          becomes <code class="text-theme-on-surface">Kids/Kids/...</code>.
        </p>

        <p class="mt-3">Good examples:</p>

        <ul class="mt-2 list-disc pl-5">
          <li :for={example <- download_subdirectory_examples()}>
            <code class="text-theme-on-surface">{example}</code>
          </li>
        </ul>
      </div>
    </section>

    <section
      x-data="{ fastIndexHelpOpen: false }"
      class="theme-surface-accent mb-5 w-full overflow-hidden rounded-m3-lg"
    >
      <button
        type="button"
        class="flex w-full items-center justify-between gap-4 px-4 py-4 text-left md:px-6"
        x-on:click="fastIndexHelpOpen = !fastIndexHelpOpen"
        x-bind:aria-expanded="fastIndexHelpOpen"
      >
        <div>
          <h3 class="text-lg font-semibold text-theme-on-surface">What is fast indexing?</h3>

          <p class="mt-1 text-sm text-theme-on-surface-muted">Click to expand the explanation and recommendations.</p>
        </div>

        <.icon
          name="hero-chevron-down"
          class="h-5 w-5 shrink-0 text-theme-on-surface-muted transition duration-200"
          x-bind:class="fastIndexHelpOpen ? 'rotate-180 text-theme-primary' : ''"
        />
      </button>

      <div
        x-cloak
        x-show="fastIndexHelpOpen"
        x-transition.opacity.duration.150ms
        class="border-t border-theme-outline/60 px-4 py-4 md:px-6 md:py-6"
      >
        <.fast_indexing_help />
      </div>
    </section>
  </section>
</.simple_form>

<.modal id="cookie-upload-modal">
  <h3 class="text-2xl text-theme-on-surface">Upload cookies.txt</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    Upload a Netscape-format cookie file exported from your browser extension or account tools.
  </p>

  <.form for={%{}} as={:cookies} action={~p"/sources/cookies/upload"} method="post" multipart class="mt-6 space-y-4">
    <input type="hidden" name="return_to" value={@current_path} />
    <.input
      name="cookies[file]"
      type="file"
      value={nil}
      accept=".txt,text/plain"
      label="Cookie file"
      help="Choose the file to store as the shared cookies.txt file."
    />
    <div class="flex flex-wrap justify-end gap-2">
      <button
        type="button"
        class="theme-button theme-outline-button"
        phx-click={hide_modal("cookie-upload-modal")}
      >
        Cancel
      </button>
      <.button class="w-auto" rounding="rounded-m3-sm">Upload</.button>
    </div>
  </.form>
</.modal>

<.modal id="cookie-paste-modal">
  <h3 class="text-2xl text-theme-on-surface">Paste Cookie Contents</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    Paste the full contents of the file and Pinchflat will create or replace `cookies.txt`.
  </p>

  <.form for={%{}} as={:cookies} action={~p"/sources/cookies/save"} method="post" class="mt-6 space-y-4">
    <input type="hidden" name="return_to" value={@current_path} />
    <.input
      name="cookies[contents]"
      type="textarea"
      label="Cookie file contents"
      value={@cookie_file_contents}
      inputclass="min-h-[18rem] font-mono"
    />
    <div class="flex flex-wrap justify-end gap-2">
      <button
        type="button"
        class="theme-button theme-outline-button"
        phx-click={hide_modal("cookie-paste-modal")}
      >
        Cancel
      </button>
      <.button class="w-auto" rounding="rounded-m3-sm">Save Cookie File</.button>
    </div>
  </.form>
</.modal>

<.modal :if={@cookie_file_exists} id="cookie-inspect-modal">
  <h3 class="text-2xl text-theme-on-surface">Inspect Cookie File</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    This is the current shared `cookies.txt` content used for sources that enable cookie behavior.
  </p>

  <.input
    name="cookie_file_contents_preview"
    type="textarea"
    label="Current contents"
    value={@cookie_file_contents || ""}
    readonly
    inputclass="mt-4 min-h-[20rem] font-mono"
  />
  <div class="mt-6 flex justify-end">
    <button
      type="button"
      class="theme-button theme-outline-button"
      phx-click={hide_modal("cookie-inspect-modal")}
    >
      Close
    </button>
  </div>
</.modal>
