<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  method={@method}
  x-data="settingsNav()"
>
  <.error :if={@changeset.action}>Oops, something went wrong! Please check the errors below.</.error>

  <section x-data={
    """
    {
      mediaProfileId: null,
      retentionOverride: #{Jason.encode!(to_string(f[:retention_period_days].value || ""))},
      profileRetention: #{Jason.encode!(Map.new(@media_profiles, &{to_string(&1.id), &1.retention_period_days}))},
      get retentionPolicySummary() {
        const raw = String(this.retentionOverride ?? '').trim();
        const inherited = raw === '';
        if (!inherited && (!/^[0-9]+$/.test(raw) || !Number.isSafeInteger(Number(raw)))) {
          return 'Enter 0 or a positive whole number, or leave blank to inherit.';
        }
        if (inherited && !Object.prototype.hasOwnProperty.call(this.profileRetention, this.mediaProfileId)) {
          return 'Choose a media profile to see inherited retention';
        }
        const days = inherited ? (this.profileRetention[this.mediaProfileId] ?? 0) : Number(raw);
        const origin = inherited ? 'profile default' : 'source override';
        const policy = days === 0 ? 'No age-based cleanup' : days + (days === 1 ? ' day' : ' days');
        return policy + ' (' + origin + ')';
      },
      sourceUrl: '',
      sourceType: '#{Ecto.Changeset.get_field(@changeset, :source_type, :automatic)}',
      isNewSource: #{@new_source == true},
      collectionType: '#{Ecto.Changeset.get_field(@changeset, :collection_type)}',
      get isVideoSource() {
        if (!this.isNewSource) return this.collectionType === 'video';
        return this.sourceType === 'video' || (this.sourceType === 'automatic' && this.collectionType === 'video');
      },
      cutoffMode: '#{cutoff_form_mode(@changeset)}',
      cutoffDate: '#{f[:download_cutoff_date].value}',
      cutoffDays: '#{to_string(f[:download_cutoff_days].value || "")}',
      cutoffToday: '#{cutoff_today_iso()}',
      cutoffDownloadedItems: #{Jason.encode!(@cutoff_downloaded_items)},
      indexCutoffDate: '#{f[:index_cutoff_date].value}',
      isPlaylist: #{Ecto.Changeset.get_field(@changeset, :collection_type) == :playlist},
      get sourceTypeLabel() {
        return {
          automatic: 'Source URL',
          channel: 'Channel URL',
          playlist: 'Playlist URL',
          video: 'Video URL'
        }[this.sourceType] || 'Source URL'
      },
      get sourceTypeHelp() {
        return {
          automatic: 'URL of a channel, playlist, or single video (required). Automatic detection preserves existing Pinchflat-ngx behavior.',
          channel: 'URL of a YouTube channel (required). Pinchflat-ngx will reject a URL that resolves to a playlist or video.',
          playlist: 'URL of a YouTube playlist (required). Pinchflat-ngx will reject a URL that resolves to a channel or video.',
          video: 'URL of a single YouTube video (required). Video sources are indexed once and fast indexing is disabled automatically.'
        }[this.sourceType] || 'URL of a channel, playlist, or single video (required).'
      },
      get looksLikePlaylist() { return this.isPlaylist || /[?&]list=|\\/playlist/.test(this.sourceUrl) },
      get effectiveCutoffDate() {
        if (this.cutoffMode === 'date') return this.cutoffDate || '';
        if (this.cutoffMode === 'days') {
          const days = Number(this.cutoffDays);
          if (!Number.isInteger(days) || days <= 0) return '';
          const date = new Date(this.cutoffToday + 'T00:00:00Z');
          date.setUTCDate(date.getUTCDate() - days);
          return date.toISOString().slice(0, 10);
        }
        return '';
      },
      get cutoffPreviewText() {
        if (this.cutoffMode !== 'days' || !this.effectiveCutoffDate) return '';
        const days = Number(this.cutoffDays);
        return 'Effective cutoff: ' + this.effectiveCutoffDate + ' for ' + days + (days === 1 ? ' day' : ' days') + ' on ' + this.cutoffToday + '.';
      },
      get cutoffWarningCount() {
        if (!this.effectiveCutoffDate) return 0;
        return this.cutoffDownloadedItems.filter(item => !item.p && item.d < this.effectiveCutoffDate).length;
      },
      get cutoffWarningText() {
        const count = this.cutoffWarningCount;
        if (count <= 0) return '';
        const noun = count === 1 ? 'video' : 'videos';
        return 'Warning: ' + count + ' currently downloaded, unprotected ' + noun + ' published before ' + this.effectiveCutoffDate + ' will be deleted at the next scheduled cleanup.';
      },
      setCutoffMode(mode) {
        this.cutoffMode = mode;
        if (mode !== 'date') this.cutoffDate = '';
        if (mode !== 'days') this.cutoffDays = '';
      },
      get indexCutoffAfterDownloadCutoff() {
        return !!(this.indexCutoffDate && this.effectiveCutoffDate && this.indexCutoffDate > this.effectiveCutoffDate)
      }
    }
    """
  }>
    <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8">
      <.settings_nav
        label="Source settings sections"
        placeholder="cutoff, cookies, folder"
        desktop_nav_surface={:surface_2}
        bleed="-mx-4 bg-theme-surface-2 px-4 md:-mx-6 md:px-6"
        sections={[
          {"source-general", "General"},
          {"source-metadata", "Name and description"},
          {"source-indexing", "Indexing", "!isVideoSource"},
          {"source-downloading", "Downloading"},
          {"source-cleanup", "Cutoff and retention"},
          {"source-sponsorblock", "SponsorBlock"},
          {"source-advanced", "Advanced"}
        ]}
      />

      <div data-settings class="mt-6 flex min-w-0 flex-col gap-6 lg:mt-0">
        <.settings_no_match class="theme-surface-raised px-5 py-8 text-center sm:px-7.5" />

        <section
          id="source-general"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">General Options</h3>

          <section :if={@new_source}>
            <.input
              field={f[:source_type]}
              options={Source.source_type_options()}
              type="select"
              label="Source Type"
              help="Choose Automatic to keep Pinchflat-ngx's existing URL detection, or select the type you expect before inspection."
              x-model="sourceType"
              x-on:change="sourceType = $event.target.value"
            />
            <div data-setting>
              <label for={f[:original_url].id} class="mt-5 mb-2 inline-block text-sm font-medium text-theme-on-surface">
                <span x-text="sourceTypeLabel"></span>
              </label>

              <.input
                field={f[:original_url]}
                type="text"
                x-init="$el.focus()"
                x-model.fill="sourceUrl"
              />
              <p class="mt-1 text-sm leading-5 text-theme-on-surface-muted" x-text="sourceTypeHelp"></p>
              <p
                x-cloak
                x-show="/[?&]list=WL(?:&|$)/.test(sourceUrl) && sourceType !== 'video' && (sourceType !== 'automatic' || sourceUrl.includes('/playlist?'))"
                class="mt-2 text-sm text-theme-on-surface-muted"
              >
                Watch Later is private. Upload cookies from the YouTube account that owns it and set
                Cookie Behaviour to All Operations below. A playlist can be added without videos when YouTube returns its details.
              </p>
            </div>
          </section>

          <.input
            :if={!@new_source}
            field={f[:original_url]}
            type="text"
            label="Source URL"
            help="URL of a channel, playlist, or single video (required). Single video sources are indexed once and fast indexing is disabled automatically"
            x-init="$el.focus()"
            x-model.fill="sourceUrl"
          />
          <.input
            field={f[:media_profile_id]}
            options={Enum.map(@media_profiles, &{&1.name, &1.id})}
            type="select"
            label="Media Profile"
            help="Sets your preferences for what media to look for and how to store it"
            x-model.fill="mediaProfileId"
          />
          <div
            data-setting
            x-data={
        """
        {
          sourceFolderValue: #{Phoenix.json_library().encode!(Phoenix.HTML.Form.normalize_value("text", f[:download_subdirectory].value) || "")},
          sourceFolderOpen: false,
          get folderOptions() { return [...this.$root.querySelectorAll('[data-folder]')] },
          folderMatches(folder) { return folder.toLowerCase().includes(this.sourceFolderValue.trim().toLowerCase()) },
          get hasFolderMatch() { return this.folderOptions.some(option => this.folderMatches(option.dataset.folder)) },
          moveFolderFocus(step) {
            const visible = this.folderOptions.filter(option => this.folderMatches(option.dataset.folder));
            const next = visible[visible.indexOf(document.activeElement) + step];
            (next || this.$root.querySelector('input[type=text]')).focus();
          }
        }
        """
      }
            x-on:click.outside="sourceFolderOpen = false"
            x-on:focusout="if (!$el.contains($event.relatedTarget)) sourceFolderOpen = false"
            x-on:keydown.escape="sourceFolderOpen = false"
          >
            <div class="relative">
              <.input
                field={f[:download_subdirectory]}
                type="text"
                inputclass="font-mono"
                label="Source folder"
                placeholder="Kids/Bluey"
                autocomplete="off"
                aria-controls="source-folder-options"
                x-model="sourceFolderValue"
                x-on:click="sourceFolderOpen = true"
                x-on:input="sourceFolderOpen = true"
                x-on:keydown.arrow-down.prevent="sourceFolderOpen = true; $nextTick(() => moveFolderFocus(1))"
              />
              <div
                :if={Enum.any?(@available_folders)}
                id="source-folder-options"
                x-cloak
                x-show="sourceFolderOpen && hasFolderMatch"
                role="group"
                aria-label="Pick existing source folder"
                class="theme-surface-raised absolute inset-x-0 top-full z-20 mt-1 max-h-60 overflow-y-auto p-1"
                x-on:keydown.arrow-down.prevent="moveFolderFocus(1)"
                x-on:keydown.arrow-up.prevent="moveFolderFocus(-1)"
              >
                <div
                  :for={folder <- @available_folders}
                  class="theme-dropdown-option"
                  x-show={"folderMatches(#{Phoenix.json_library().encode!(folder)})"}
                >
                  <button
                    type="button"
                    data-folder={folder}
                    class="font-mono"
                    x-on:click="sourceFolderValue = $el.dataset.folder; sourceFolderOpen = false; $root.querySelector('input[type=text]').focus()"
                  >
                    <span class="min-w-0 flex-1 truncate">{folder}</span>
                    <.icon
                      name="hero-check"
                      class="h-4 w-4 shrink-0 text-theme-primary"
                      x-show={"sourceFolderValue === #{Phoenix.json_library().encode!(folder)}"}
                    />
                  </button>
                </div>
              </div>
            </div>
            <.help>
              {download_subdirectory_help()}
              <span :if={Enum.any?(@available_folders)}>Click the field to pick a folder that already exists, or type a new one.</span>
            </.help>
            <.form_disclosure title="How source folders work?">
              <div class="text-sm text-theme-on-surface">
                <p>
                  Pinchflat saves downloads to <code class="text-theme-on-surface">media root + source folder + output template</code>.
                </p>

                <p class="mt-3">
                  Use <strong class="text-theme-on-surface">Source folder</strong>
                  for the main folder, then keep your template focused on file naming or
                  subfolders inside it.
                </p>

                <p class="mt-3">
                  If both the source folder and the template point to the same folder name, it will be duplicated.
                  Example: source folder <code class="text-theme-on-surface">Kids</code>
                  plus template <code class="text-theme-on-surface">{~S(Kids/{{ title }}.{{ ext }})}</code>
                  becomes <code class="text-theme-on-surface">Kids/Kids/...</code>.
                </p>

                <p class="mt-3">Good examples:</p>

                <ul class="mt-2 list-disc pl-5">
                  <li :for={example <- download_subdirectory_examples()}>
                    <code class="text-theme-on-surface">{example}</code>
                  </li>
                </ul>
              </div>
            </.form_disclosure>
          </div>
        </section>
        <section
          id="source-metadata"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">Source Metadata</h3>

          <p class="mt-2 max-w-prose text-sm text-theme-on-surface-muted">
            Name and description follow the channel's metadata. Once you edit one, Pinchflat-ngx keeps your version
            and metadata refreshes leave it alone.
          </p>

          <.metadata_field_lock field={f[:custom_name]} lock={f[:custom_name_locked]} noun="name">
            <.input
              field={f[:custom_name]}
              type="text"
              label="Source Name"
              help="The name shown throughout Pinchflat-ngx."
              x-on:input="locked = true"
            />
          </.metadata_field_lock>
          <.metadata_field_lock field={f[:description]} lock={f[:description_locked]} noun="description">
            <.input
              field={f[:description]}
              type="textarea"
              label="Description"
              help="The source description shown in Pinchflat-ngx."
              x-on:input="locked = true"
            />
          </.metadata_field_lock>
        </section>
        <section
          id="source-indexing"
          data-setting-group
          x-cloak
          x-show="!isVideoSource"
          x-bind:data-setting-inapplicable="isVideoSource ? 'true' : false"
          x-effect="isVideoSource; $nextTick(() => filterSettings && filterSettings())"
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">Indexing Options</h3>

          <fieldset
            disabled={
              if(@new_source,
                do:
                  Ecto.Changeset.get_field(@changeset, :source_type) == :video or
                    (Ecto.Changeset.get_field(@changeset, :source_type, :automatic) == :automatic and
                       Ecto.Changeset.get_field(@changeset, :collection_type) == :video),
                else: Ecto.Changeset.get_field(@changeset, :collection_type) == :video
              )
            }
            x-bind:disabled="isVideoSource"
            class="min-w-0 border-0 p-0 m-0"
          >
            <section x-data={"{ fastIndexingEnabled: #{Ecto.Changeset.get_field(@changeset, :fast_index, false)} }"}>
              <.input
                field={f[:index_frequency_minutes]}
                options={friendly_index_frequencies()}
                type="select"
                label="Index Frequency"
                x-bind:disabled="isVideoSource || fastIndexingEnabled == true"
                x-init="$watch('fastIndexingEnabled', v => v && ($el.value = 30 * 24 * 60, $el.dispatchEvent(new Event('change', { bubbles: true }))))"
                help="Indexing is the process of checking for media to download. For best results, set this to the longest delay you can tolerate for this source"
              />
              <div phx-click={show_modal("upgrade-modal")}>
                <.input
                  field={f[:fast_index]}
                  type="toggle"
                  label="Use Fast Indexing"
                  label_suffix="(pro)"
                  help="Not recommended for playlists. Single video sources always disable this option. Overrides 'Index Frequency'. Read 'What is fast indexing?' below before turning this on."
                  x-model="fastIndexingEnabled"
                />
              </div>
              <.form_disclosure title="What is fast indexing?" data-setting>
                <.fast_indexing_help />
              </.form_disclosure>
            </section>

            <div data-setting class="mt-5">
              <.date_picker
                id={f[:index_cutoff_date].id}
                name={f[:index_cutoff_date].name}
                label="Indexing Cutoff Date"
                value={to_string(f[:index_cutoff_date].value || "")}
                timezone={Application.fetch_env!(:pinchflat, :timezone)}
                required={false}
                x-modelable="value"
                x-model="indexCutoffDate"
              />
              <.error :for={error <- f[:index_cutoff_date].errors}>{translate_error(error)}</.error>
              <.help>
                Stop indexing a channel once it reaches videos uploaded before this date. This saves a lot of time on
                channels with a large back catalog. Set it a few days <em>before</em>
                the Download Cutoff Date for safety. It only applies to YouTube channels and is ignored for playlists. A few
                videos from before this date may still be indexed (but not downloaded), especially on channels with few
                videos or when Fast Indexing is enabled, since those checks look at the most recent videos regardless of
                date. Leave blank to index everything.
              </.help>
            </div>
            <p x-cloak x-show="looksLikePlaylist" class="mt-1 text-sm text-theme-warning">
              The Indexing Cutoff Date doesn't apply to playlists — they aren't ordered by upload date, so
              indexing can't safely stop early.
            </p>

            <p x-cloak x-show="indexCutoffAfterDownloadCutoff" class="mt-1 text-sm text-theme-warning">
              The Indexing Cutoff Date is after the Download Cutoff Date — media between the two dates would
              never be indexed, so it could never be downloaded. Set it on or before the Download Cutoff
              Date.
            </p>
          </fieldset>
        </section>
        <section
          id="source-downloading"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">
            Downloading Options
          </h3>

          <section
            class="space-y-3"
            x-data={
              Phoenix.json_library().encode!(%{
                downloadMembersOnlyMedia: Ecto.Changeset.get_field(@changeset, :download_members_only_media),
                cookieBehaviour: to_string(Ecto.Changeset.get_field(@changeset, :cookie_behaviour)),
                playerClient: to_string(Ecto.Changeset.get_field(@changeset, :player_client) || ""),
                fallbacks:
                  (Ecto.Changeset.get_field(@changeset, :player_client_fallbacks) || []) |> Enum.map(&to_string/1),
                candidateFallback: ""
              })
            }
          >
            <.input
              field={f[:download_media]}
              type="toggle"
              label="Download Media"
              help="Unchecking still indexes media but it won't be downloaded until you enable this option"
            />
            <.input
              field={f[:download_public_media]}
              type="toggle"
              label="Download Public and Unlisted Media"
              help="Controls media that yt-dlp reports as public or unlisted"
            />
            <.input
              field={f[:download_members_only_media]}
              type="toggle"
              label="Download Members-only Media"
              help="Includes subscriber-only, premium-only, and media that requires authentication"
              x-model="downloadMembersOnlyMedia"
            />
            <section :if={@show_delay_automatic_download} class="mt-3">
              <.input
                field={f[:delay_automatic_download]}
                type="toggle"
                label="Delay Automatic Download"
                help="For playlists only. Index first, then send me to a selection screen so I can choose which items to download."
              />
            </section>

            <.input
              field={f[:cookie_behaviour]}
              options={friendly_cookie_behaviours()}
              type="select"
              label="Cookie Behaviour"
              help="Uses your YouTube cookies for this source (if configured). 'When Needed' tries to minimize cookie usage except for certain indexing and downloading tasks. See docs"
              x-model="cookieBehaviour"
            />
            <div
              id="source-shared-cookies"
              data-setting
              data-setting-label="Shared cookies.txt"
              class="theme-surface-accent flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 text-sm"
            >
              <p class="min-w-0 flex-1 basis-60 text-theme-on-surface-muted">
                <span class="font-medium text-theme-on-surface">Shared cookies.txt:</span>
                <%= cond do %>
                  <% @cookie_file_configured -> %>
                    Cookie file is configured and ready to use.
                  <% @cookie_file_exists -> %>
                    Cookie file exists but is currently blank.
                  <% true -> %>
                    Cookie file does not exist yet.
                <% end %>
                Cookie health checks are in <.link href={~p"/settings"} class="underline">Settings</.link>.
              </p>

              <div class="flex flex-wrap gap-2">
                <.button type="button" variant="secondary" size="compact" phx-click={show_modal("cookie-upload-modal")}>
                  Upload cookies.txt
                </.button>
                <.button type="button" variant="secondary" size="compact" phx-click={show_modal("cookie-paste-modal")}>
                  Paste contents
                </.button>
                <.button
                  :if={@cookie_file_exists}
                  type="button"
                  variant="secondary"
                  size="compact"
                  phx-click={show_modal("cookie-inspect-modal")}
                >
                  Inspect
                </.button>
              </div>
            </div>
            <.form_disclosure
              title="YouTube player client"
              open={Enum.any?([:player_client, :player_client_fallbacks], &Keyword.has_key?(@changeset.errors, &1))}
              data-setting-group
            >
              <:status>
                <span x-text="(playerClient || 'yt-dlp default') + (fallbacks.length ? ', then ' + fallbacks.join(', ') : '')"></span>
              </:status>
              <.input
                field={f[:player_client]}
                options={friendly_player_clients()}
                type="select"
                label="Primary YouTube Player Client"
                help="Overrides yt-dlp's default YouTube player-client selection for this source. Default is recommended unless you need a specific client."
                x-model="playerClient"
              />
              <div data-setting class="mt-4 rounded-m3-sm border border-theme-outline/40 bg-theme-surface-2 p-4">
                <div class="mb-3">
                  <h4 class="text-sm font-semibold text-theme-on-surface">Client Fallback Chain</h4>

                  <p class="text-xs text-theme-on-surface-muted mt-1">
                    If the primary client encounters an HTTP 403 or bot check, Pinchflat will sequentially try these fallback clients in order (up to 4 total clients).
                  </p>
                </div>
                <input type="hidden" name="source[player_client_fallbacks][]" value="" />
                <div x-show="fallbacks.length > 0" class="space-y-2 mb-3">
                  <template x-for="(fb, idx) in fallbacks" x-bind:key="fb">
                    <div class="flex items-center justify-between rounded-m3-xs border border-theme-outline/30 bg-theme-surface-1 px-3 py-2 text-xs">
                      <input type="hidden" name="source[player_client_fallbacks][]" x-bind:value="fb" />
                      <div class="flex items-center gap-2">
                        <span class="font-mono text-theme-on-surface-muted" x-text="`#${idx + 1}`"></span>
                        <span class="font-medium text-theme-on-surface font-mono" x-text="fb"></span>
                      </div>

                      <div class="flex items-center gap-1">
                        <button
                          type="button"
                          class="theme-icon-button theme-outline-button text-xs"
                          x-bind:disabled="idx === 0"
                          @click="
                    const temp = fallbacks[idx - 1];
                    fallbacks[idx - 1] = fallbacks[idx];
                    fallbacks[idx] = temp;
                    fallbacks = [...fallbacks];
                  "
                          title="Move Up"
                          aria-label="Move Up"
                        >
                          ↑
                        </button>

                        <button
                          type="button"
                          class="theme-icon-button theme-outline-button text-xs"
                          x-bind:disabled="idx === fallbacks.length - 1"
                          @click="
                    const temp = fallbacks[idx + 1];
                    fallbacks[idx + 1] = fallbacks[idx];
                    fallbacks[idx] = temp;
                    fallbacks = [...fallbacks];
                  "
                          title="Move Down"
                          aria-label="Move Down"
                        >
                          ↓
                        </button>

                        <button
                          type="button"
                          class="theme-icon-button theme-outline-button text-xs text-theme-error hover:border-theme-error"
                          @click="
                    fallbacks.splice(idx, 1);
                    fallbacks = [...fallbacks];
                  "
                          title="Remove"
                          aria-label="Remove"
                        >
                          ✕
                        </button>
                      </div>
                    </div>
                  </template>
                </div>

                <div x-show="fallbacks.length === 0" class="text-xs text-theme-on-surface-muted italic mb-3">
                  No fallback clients configured. Only the primary client (or yt-dlp default) will be used.
                </div>

                <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center">
                  <select
                    x-model="candidateFallback"
                    x-bind:disabled="!playerClient || (playerClient ? 1 : 0) + fallbacks.length >= 4"
                    class="theme-input rounded-m3-xs px-3 py-1.5 text-xs text-theme-on-surface focus:ring-0"
                  >
                    <option value="">Select fallback client to add...</option>

                    <%= for {label, val} <- Source.player_client_options() do %>
                      <option
                        value={to_string(val)}
                        x-show={
                  "playerClient !== '#{to_string(val)}' && !fallbacks.includes('#{to_string(val)}')"
                }
                      >
                        {label} ({to_string(val)})
                      </option>
                    <% end %>
                  </select>

                  <button
                    type="button"
                    class="theme-button theme-outline-button"
                    x-bind:disabled="!candidateFallback || (playerClient ? 1 : 0) + fallbacks.length >= 4"
                    @click="
              if (candidateFallback && !fallbacks.includes(candidateFallback) && candidateFallback !== playerClient) {
                fallbacks.push(candidateFallback);
                fallbacks = [...fallbacks];
                candidateFallback = '';
              }
            "
                  >
                    + Add Fallback
                  </button>
                </div>

                <p x-show="!playerClient" class="text-xs text-theme-on-surface-muted mt-2">
                  Select a primary YouTube Player Client above to enable fallback chains.
                </p>

                <p
                  x-show="playerClient && (playerClient ? 1 : 0) + fallbacks.length >= 4"
                  class="text-xs text-theme-on-surface-muted mt-2"
                >
                  Maximum of 4 total clients reached (1 primary + 3 fallbacks).
                </p>
              </div>
            </.form_disclosure>

            <div
              x-cloak
              x-show="downloadMembersOnlyMedia && cookieBehaviour === 'disabled'"
              class="theme-status-card theme-status-card-warning text-sm"
              role="alert"
            >
              Members-only media may fail without cookies. Configure a cookies.txt file and select a cookie behaviour if
              you want Pinchflat-ngx to access it; this setting will not enable cookies automatically.
            </div>

            <div
              x-cloak
              x-show="[playerClient, ...fallbacks].includes('web_creator') && cookieBehaviour !== 'all_operations'"
              class="theme-status-card theme-status-card-warning text-sm"
              role="alert"
            >
              Web Creator requires account cookies. Select All Operations to use this client reliably.
            </div>

            <div
              x-cloak
              x-show="[playerClient, ...fallbacks].some(c => ['android', 'ios', 'tv_simply'].includes(c)) && cookieBehaviour !== 'disabled'"
              class="theme-status-card theme-status-card-warning text-sm"
              role="alert"
            >
              One or more configured player clients (Android, iOS, TV Simply) do not support account cookies. Set Cookie Behaviour to Disabled before saving.
            </div>
          </section>

          <fieldset
            id="source-duration-filter"
            x-cloak
            x-show="!isVideoSource"
            x-bind:disabled="isVideoSource"
            x-bind:data-setting-inapplicable="isVideoSource ? 'true' : false"
            x-effect="isVideoSource; $nextTick(() => filterSettings && filterSettings())"
            class="min-w-0 border-0 p-0 m-0"
          >
            <section data-setting data-setting-keywords="minimum maximum duration length seconds">
              <div class="grid gap-x-4 sm:grid-cols-2">
                <.input field={f[:min_duration_seconds]} type="number" label="Minimum Duration (seconds)" min="0" />
                <.input field={f[:max_duration_seconds]} type="number" label="Maximum Duration (seconds)" min="0" />
              </div>
              <p class="mt-1 text-sm leading-5 text-theme-on-surface-muted">
                Only download media within this length. Leave either field blank for no limit.
              </p>
            </section>
          </fieldset>

          <section
            x-cloak
            x-show="isPlaylist"
            data-setting
            data-setting-keywords="owner channel uploader playlist lock"
          >
            <.input
              field={f[:only_owner_uploads]}
              type="toggle"
              label="Only download videos uploaded by the playlist owner"
              help="Videos the owner added from other channels are still listed but not downloaded. Videos already downloaded are kept. Has no effect on playlists without an owner channel, such as mixes."
            />
          </section>

          <section
            x-cloak
            x-show="collectionType === 'channel' || (isNewSource && ['automatic', 'channel'].includes(sourceType) && !looksLikePlaylist)"
            data-setting
            data-setting-keywords="playlist subfolder folder organize sort channel"
          >
            <.input
              field={f[:playlist_subfolders]}
              type="toggle"
              label="Sort new downloads into playlist subfolders"
              help="Channel sources only. Each index reads the channel's playlists, and a new download goes into a subfolder named after the first playlist that contains it. Videos in no playlist use the usual folder. Files already downloaded are not moved."
            />
            <.input
              field={f[:playlist_files]}
              type="toggle"
              label="Write playlist files"
              help="Channel sources only. Writes an .m3u file for each of the channel's playlists in the folder that holds this source's downloads, listing its downloaded videos in playlist order. A video in several playlists is listed in each. Files are updated after each index and download, and removed when this is turned off."
            />
          </section>
        </section>
        <section
          id="source-cleanup"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">Cutoff and Retention</h3>

          <fieldset
            id="source-download-cutoff"
            x-cloak
            x-show="!isVideoSource"
            x-effect="isVideoSource; $nextTick(() => filterSettings && filterSettings())"
            x-bind:disabled="isVideoSource"
            x-bind:data-setting-inapplicable="isVideoSource ? 'true' : false"
            class="min-w-0 border-0 p-0 m-0"
          >
            <section data-setting class="mt-5">
              <div class="sm:max-w-md">
                <.label for="source-cutoff-mode">Download cutoff</.label>
                <div class="theme-field-shell">
                  <select
                    id="source-cutoff-mode"
                    x-model="cutoffMode"
                    x-on:change="setCutoffMode($event.target.value)"
                    class="theme-input theme-select w-full rounded-m3-sm py-2.5 pl-4 pr-10 outline-none transition"
                  >
                    <option value="none">No cutoff</option>
                    <option value="date">Fixed date</option>
                    <option value="days">Rolling window (last N days)</option>
                  </select>
                </div>
              </div>

              <div x-show="cutoffMode === 'date'" x-cloak class="mt-4 sm:max-w-md">
                <.date_picker
                  id={f[:download_cutoff_date].id}
                  name={f[:download_cutoff_date].name}
                  label="Download Cutoff Date"
                  value={to_string(f[:download_cutoff_date].value || "")}
                  timezone={Application.fetch_env!(:pinchflat, :timezone)}
                  required={false}
                  presets={cutoff_date_presets()}
                  x-modelable="value"
                  x-model="cutoffDate"
                />
              </div>
              <.error :for={error <- f[:download_cutoff_date].errors}>{translate_error(error)}</.error>

              <div x-show="cutoffMode === 'days'" x-cloak class="mt-4 sm:max-w-md">
                <.input
                  field={f[:download_cutoff_days]}
                  type="number"
                  min="1"
                  step="1"
                  label="Rolling window (days)"
                  placeholder="30"
                  x-model="cutoffDays"
                  help="Only download media published within this many days of each run."
                />
                <p
                  x-show="effectiveCutoffDate"
                  class="mt-2 text-sm text-theme-on-surface"
                  aria-live="polite"
                  x-text="cutoffPreviewText"
                >
                </p>
              </div>
              <.error :for={error <- f[:download_cutoff_days].errors}>{translate_error(error)}</.error>

              <div
                x-show="cutoffMode === 'days' && cutoffWarningCount > 0"
                x-cloak
                class="theme-status-card theme-status-card-warning mt-4"
                role="alert"
              >
                <div class="flex items-start gap-3">
                  <.icon name="hero-exclamation-triangle" class="mt-0.5 h-5 w-5 shrink-0" />
                  <p class="text-sm leading-6 text-theme-on-surface" x-text="cutoffWarningText"></p>
                </div>
              </div>

              <p class="mt-2 text-sm text-theme-on-surface-muted">
                Automatically download media published on or after the cutoff. Scheduled cleanup also deletes unprotected
                downloaded media from before it, including manual downloads, even within their retention period. A rolling
                window moves with the current date. Choose No cutoff to disable both. Prevent Automatic Deletion on a
                media item's Edit page overrides cutoff and retention cleanup.
              </p>
            </section>
          </fieldset>
          <p x-show="isVideoSource" x-cloak class="mt-5 text-sm text-theme-on-surface-muted">
            Download cutoffs don't apply to a single video source. The video is downloaded whatever its publication date.
          </p>

          <.form_disclosure
            title="Retention and watch window"
            open={
              Enum.any?(
                [:retention_period_days, :watch_window_days, :keep_newest_count],
                &Keyword.has_key?(@changeset.errors, &1)
              )
            }
            data-setting-group
          >
            <:status>
              <span x-text="'Retention: ' + retentionPolicySummary">Retention: {retention_form_preview(
                @changeset,
                @media_profiles
              )}</span>
            </:status>
            <div data-setting>
              <.input
                field={f[:retention_period_days]}
                type="number"
                label="Retention override (days)"
                placeholder="Inherit media profile"
                x-model="retentionOverride"
                min="0"
                help="Leave blank to follow the selected media profile. Enter 0 to disable age-based cleanup for this source."
                html_help={true}
              />
              <div class="theme-surface-accent rounded-m3-sm p-4">
                <p class="text-sm font-medium text-theme-on-surface">Effective retention</p>
                <p
                  id="source-retention-effective"
                  class="mt-1 text-sm text-theme-on-surface"
                  aria-live="polite"
                  x-text="retentionPolicySummary"
                >
                  {retention_form_preview(@changeset, @media_profiles)}
                </p>
                <p class="mt-2 text-sm text-theme-on-surface-muted">
                  Age is counted from download time. Saving a shorter period or changing the profile can make existing
                  downloads eligible at the next cleanup. A publication-date cutoff can delete files sooner.
                  Prevent Automatic Deletion overrides both cleanup rules.
                </p>
              </div>
            </div>

            <.input
              field={f[:watch_window_days]}
              type="number"
              label="Watch window (days)"
              min="0"
              max="365"
              help="Leave blank to use the media profile setting. Set 0 to disable monitoring, or 1–365 days from the first completed download. Publication date and later downloads do not change the start or end date. Pinchflat checks duration and visibility, saves the original before replacement, and blocks replacement when a change is suspected. Checks stop at the end date; saved originals and protection for detected changes remain."
              html_help={true}
            />

            <.input
              field={f[:keep_newest_count]}
              type="number"
              label="Keep newest (videos)"
              min="1"
              help="Leave blank to disable. When set, Pinchflat keeps only the newest N downloaded or pending-eligible videos for this source, ordered by publication date and ID. Items with prevent culling enabled never count towards the limit and are never removed. Watch-protected items count towards the limit but are never deleted, so total downloaded items can exceed N. Lowering this number will delete older unprotected downloaded files at the next scheduled cleanup; raising it allows older videos to be re-downloaded."
            />
          </.form_disclosure>
        </section>
        <section
          id="source-sponsorblock"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
          x-data={
            Phoenix.json_library().encode!(%{
              markMode: sponsorblock_mode(Ecto.Changeset.get_field(@changeset, :sponsorblock_mark_categories)),
              removeMode: sponsorblock_mode(Ecto.Changeset.get_field(@changeset, :sponsorblock_remove_categories)),
              profilePreview: sponsorblock_profile_preview(@media_profiles)
            })
          }
        >
          <h3 class="text-2xl text-theme-on-surface">SponsorBlock</h3>

          <p class="mt-2 text-sm text-theme-on-surface-muted">
            Applies to future downloads, quality upgrades and redownloads. Existing files are never re-cut.
          </p>
          <p class="mt-1 text-sm text-theme-on-surface-muted">
            Not sure what a category covers? See the
            <.subtle_link href="https://wiki.sponsor.ajay.app/w/Guidelines#Category_breakdown" target="_blank">
              SponsorBlock category breakdown
            </.subtle_link>
            for a description of each one.
          </p>

          <.form_disclosure
            title="Mark and remove segments"
            open={
              Enum.any?(
                [:sponsorblock_mark_categories, :sponsorblock_remove_categories],
                &Keyword.has_key?(@changeset.errors, &1)
              )
            }
            data-setting-group
          >
            <:status>
              Mark: {sponsorblock_status_label(@changeset, @media_profiles, :mark)} · Remove: {sponsorblock_status_label(
                @changeset,
                @media_profiles,
                :remove
              )}
            </:status>

            <div data-setting data-setting-label="Remove segments">
              <.input
                name="source[sponsorblock_remove_mode]"
                id="source_sponsorblock_remove_mode"
                type="select"
                label="Remove these segments"
                value={sponsorblock_mode(Ecto.Changeset.get_field(@changeset, :sponsorblock_remove_categories))}
                options={sponsorblock_mode_options()}
                help="Segments in these categories are cut out of the downloaded file entirely."
                x-model="removeMode"
              />
              <p
                class="mt-1 text-sm text-theme-on-surface-muted"
                x-show="removeMode === 'inherit'"
                x-text="'Uses the media profile: ' + ((profilePreview[mediaProfileId] || {}).remove || 'None')"
              >
              </p>

              <div x-show="removeMode === 'custom'" x-cloak>
                <.input
                  field={f[:sponsorblock_remove_categories]}
                  options={friendly_sponsorblock_categories()}
                  type="checkbox_group"
                  label="Categories to remove"
                  value={Ecto.Changeset.get_field(@changeset, :sponsorblock_remove_categories) || []}
                />
              </div>
              <.error :for={error <- f[:sponsorblock_remove_categories].errors}>{translate_error(error)}</.error>
            </div>

            <div data-setting data-setting-label="Mark segments as chapters">
              <.input
                name="source[sponsorblock_mark_mode]"
                id="source_sponsorblock_mark_mode"
                type="select"
                label="Mark these segments as chapters"
                value={sponsorblock_mode(Ecto.Changeset.get_field(@changeset, :sponsorblock_mark_categories))}
                options={sponsorblock_mode_options()}
                help="Segments in these categories are kept but marked as chapters so your player can skip them. A category can't also be selected for removal."
                x-model="markMode"
              />
              <p
                class="mt-1 text-sm text-theme-on-surface-muted"
                x-show="markMode === 'inherit'"
                x-text="'Uses the media profile: ' + ((profilePreview[mediaProfileId] || {}).mark || 'None')"
              >
              </p>

              <div x-show="markMode === 'custom'" x-cloak>
                <.input
                  field={f[:sponsorblock_mark_categories]}
                  options={friendly_sponsorblock_categories()}
                  type="checkbox_group"
                  label="Categories to mark"
                  value={Ecto.Changeset.get_field(@changeset, :sponsorblock_mark_categories) || []}
                />
              </div>
              <.error :for={error <- f[:sponsorblock_mark_categories].errors}>{translate_error(error)}</.error>
            </div>
          </.form_disclosure>
        </section>
        <section
          id="source-advanced"
          data-setting-group
          class="theme-surface-raised px-5 py-5 sm:px-7.5 scroll-mt-36 lg:scroll-mt-24"
        >
          <h3 class="text-2xl text-theme-on-surface">Advanced Options</h3>

          <p class="mt-2 text-sm text-theme-on-surface-muted">Tread carefully</p>

          <fieldset
            id="source-title-filter"
            x-cloak
            x-show="!isVideoSource"
            x-bind:disabled="isVideoSource"
            x-bind:data-setting-inapplicable="isVideoSource ? 'true' : false"
            x-effect="isVideoSource; $nextTick(() => filterSettings && filterSettings())"
            class="min-w-0 border-0 p-0 m-0"
          >
            <.form_disclosure
              title="Title filter"
              open={Keyword.has_key?(@changeset.errors, :title_filter_regex)}
              data-setting-group
              x-data={
              """
              Object.assign(window.pinchflatTitleFilterBuilder(#{title_filter_regex_json(f)}), {
                titles: '',
                sourceId: #{Phoenix.json_library().encode!(@changeset.data.id)},
                busy: false,
                tested: false,
                error: '',
                samples: [],
                indexed: [],
                matched(results) { return results.filter(result => result.match).length },
                async test() {
                  this.busy = true;
                  this.error = '';
                  try {
                    const body = new URLSearchParams({ regex: this.regex, titles: this.titles, source_id: this.sourceId ?? '' });
                    const response = await fetch('/sources/title_filter/test', {
                      method: 'POST',
                      headers: { 'x-csrf-token': document.querySelector('meta[name=csrf-token]').content },
                      body
                    });
                    const data = await response.json();
                    this.error = response.ok ? '' : data.error;
                    this.samples = response.ok ? data.samples : [];
                    this.indexed = response.ok ? data.indexed : [];
                  } catch (_error) {
                    this.error = 'The test could not reach Pinchflat-ngx. Check the connection and try again.';
                  }
                  this.tested = true;
                  this.busy = false;
                }
              })
              """
            }
            >
              <:status>
                <span x-text="regex.trim() ? 'Enabled' : 'None'">
                  {if f[:title_filter_regex].value in [nil, ""], do: "None", else: "Enabled"}
                </span>
              </:status>
              <div data-setting x-data="window.pinchflatSavedTitleFilters()">
                <section
                  class="border-b border-theme-outline/35 pb-5 pt-4"
                  aria-labelledby="title-filter-stored-heading"
                  data-saved-title-filters
                >
                  <h4 id="title-filter-stored-heading" class="text-sm font-semibold text-theme-on-surface">
                    Stored Filters
                  </h4>
                  <p class="mt-1 text-sm leading-5 text-theme-on-surface-muted">
                    Commonly used filters can be stored for access across all sources
                  </p>

                  <p x-show="savedFilters.length === 0" class="mt-3 text-sm text-theme-on-surface-muted">
                    No stored filters yet.
                  </p>
                  <ul x-cloak x-show="savedFilters.length > 0" class="theme-list mt-3" aria-label="Stored filters">
                    <template x-for="filter in savedFilters" x-bind:key="filter.id">
                      <li
                        class="theme-list-item flex flex-wrap items-center gap-x-3 gap-y-2"
                        x-bind:class="filter.id === loadedId && 'theme-list-item-selected'"
                        x-bind:aria-current="filter.id === loadedId ? 'true' : null"
                      >
                        <div class="min-w-0 flex-1">
                          <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-theme-on-surface">
                            <span class="[overflow-wrap:anywhere]" x-text="filter.name"></span>
                            <span
                              x-cloak
                              x-show="filter.id === loadedId && changedSinceLoaded()"
                              class="theme-badge-warning rounded-full px-2 py-0.5 text-xs font-medium"
                            >
                              Changed since loaded
                            </span>
                          </p>
                          <p
                            class="truncate font-mono text-xs text-theme-on-surface-muted"
                            x-text="filter.regex"
                            x-bind:title="filter.regex"
                          >
                          </p>
                        </div>
                        <div class="flex shrink-0 gap-2">
                          <.button
                            type="button"
                            variant="secondary"
                            size="compact"
                            x-on:click="loadFilter(filter)"
                            x-bind:disabled="savedBusy"
                            x-bind:aria-label="'Load stored filter ' + filter.name"
                          >
                            Load
                          </.button>
                          <.button
                            type="button"
                            variant="danger"
                            size="compact"
                            x-on:click="deleteFilter(filter)"
                            x-bind:disabled="savedBusy"
                            x-bind:aria-label="deleteLabel(filter)"
                          >
                            <span x-text="confirmDeleteId === filter.id ? 'Confirm delete' : 'Delete'">Delete</span>
                          </.button>
                        </div>
                      </li>
                    </template>
                  </ul>
                  <div aria-live="polite">
                    <p
                      x-cloak
                      x-show="savedMessage && messageWhere === 'list'"
                      x-text="savedMessage"
                      class="mt-2 text-sm text-theme-error"
                    >
                    </p>
                  </div>
                </section>
                <div data-title-filter-builder>
                  <p class="mt-3 text-sm leading-5 text-theme-on-surface-muted">
                    Type a word and press Enter. Use * as a wildcard and "quotes" for phrases that contain commas.
                  </p>
                  <p x-cloak x-show="custom" class="mt-2 text-sm text-theme-warning">
                    This source already has a regex the builder cannot read. Adding anything below replaces it.
                  </p>

                  <%!-- Each list's switches are centred on its word box and may rise beside its heading --%>
                  <div
                    :for={group <- title_filter_groups()}
                    class="grid grid-cols-1 gap-x-7 gap-y-2 border-b border-theme-outline/35 pb-7 pt-5 sm:grid-cols-[minmax(0,1fr)_15rem]"
                    data-title-filter-list={group.key}
                  >
                    <div class="flex items-center gap-1 text-sm font-medium text-theme-on-surface sm:col-start-1 sm:row-start-1">
                      {group.label}
                      <.info_tip id={"title-filter-#{group.key}-tip"} label={"About #{group.label}"} text={group.help} />
                    </div>
                    <div
                      class="theme-chip-field sm:col-start-1 sm:row-start-2"
                      x-on:click="$el.querySelector('input').focus()"
                    >
                      <template x-for={"(term, index) in terms.#{group.key}"} x-bind:key="term">
                        <span
                          class="theme-chip"
                          x-bind:class={"isConflicting('#{group.key}', term) && 'theme-chip-conflict'"}
                        >
                          <span class="[overflow-wrap:anywhere]" x-text="term"></span>
                          <button
                            type="button"
                            class="theme-chip-remove cursor-pointer"
                            x-bind:aria-label="'Remove ' + term"
                            title="Remove"
                            x-on:click.stop={"removeTerm('#{group.key}', index)"}
                          >
                            &times;
                          </button>
                        </span>
                      </template>
                      <input
                        type="text"
                        autocomplete="off"
                        class="theme-chip-field-input"
                        placeholder={group.placeholder}
                        x-bind:placeholder={"terms.#{group.key}.length ? '' : '#{group.placeholder}'"}
                        aria-label={group.label}
                        x-on:keydown={"termKeydown('#{group.key}', $event)"}
                        x-on:blur={"termBlur('#{group.key}', $event)"}
                        x-on:paste={"termPaste('#{group.key}', $event)"}
                      />
                    </div>
                    <div class="flex flex-row flex-wrap gap-x-6 gap-y-1 sm:col-start-2 sm:row-start-2 sm:-my-[23px] sm:flex-col sm:flex-nowrap sm:gap-1.5 sm:self-center">
                      <div class="flex items-center justify-between gap-3">
                        <span class="flex items-center gap-1 text-sm text-theme-on-surface">
                          <label for={"title-filter-#{group.key}-whole"} class="cursor-pointer">
                            Whole words only
                          </label>
                          <.info_tip
                            id={"title-filter-#{group.key}-whole-tip"}
                            label="About whole words only"
                            text={~s(Only match complete words. Off lets "art" match "party".)}
                            align="right"
                          />
                        </span>
                        <label for={"title-filter-#{group.key}-whole"} class="theme-switch-target cursor-pointer">
                          <input
                            type="checkbox"
                            id={"title-filter-#{group.key}-whole"}
                            class="peer sr-only"
                            x-model={"options.#{group.key}.whole"}
                            x-on:change="writeRegex()"
                          />
                          <span class="theme-switch-track peer-checked:border-theme-primary/70 peer-checked:bg-theme-primary-container peer-focus-visible:ring-2 peer-focus-visible:ring-theme-primary peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-theme-surface"></span>
                          <span class="theme-switch-thumb peer-checked:translate-x-6 peer-checked:bg-theme-primary"></span>
                        </label>
                      </div>
                      <div class="flex items-center justify-between gap-3">
                        <span class="flex items-center gap-1 text-sm text-theme-on-surface">
                          <label for={"title-filter-#{group.key}-case"} class="cursor-pointer">
                            Match capital letters
                          </label>
                          <.info_tip
                            id={"title-filter-#{group.key}-case-tip"}
                            label="About match capital letters"
                            text={~s(Off means "Review" and "review" count the same.)}
                            align="right"
                          />
                        </span>
                        <label for={"title-filter-#{group.key}-case"} class="theme-switch-target cursor-pointer">
                          <input
                            type="checkbox"
                            id={"title-filter-#{group.key}-case"}
                            class="peer sr-only"
                            x-model={"options.#{group.key}.matchCase"}
                            x-on:change="writeRegex()"
                          />
                          <span class="theme-switch-track peer-checked:border-theme-primary/70 peer-checked:bg-theme-primary-container peer-focus-visible:ring-2 peer-focus-visible:ring-theme-primary peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-theme-surface"></span>
                          <span class="theme-switch-thumb peer-checked:translate-x-6 peer-checked:bg-theme-primary"></span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <.input
                    field={f[:title_filter_regex]}
                    type="text"
                    inputclass="font-mono"
                    label="Title Filter Regex"
                    placeholder="(?i)^How to Bike$"
                    help={title_filter_regex_help()}
                    html_help={true}
                    x-model.fill="regex"
                    x-ref="regexInput"
                  >
                    <:input_action>
                      <button
                        type="button"
                        class="theme-field-action hover:bg-transparent"
                        x-cloak
                        x-show="regex.trim() !== ''"
                        x-on:click="clearFilter(); $refs.regexInput.focus()"
                        aria-label="Clear title filter"
                      >
                        <.icon name="hero-x-mark" class="h-5 w-5" />
                      </button>
                    </:input_action>
                  </.input>

                  <div aria-live="polite">
                    <div
                      x-cloak
                      x-show="conflicts().length > 0"
                      x-ref="conflicts"
                      class="theme-status-card theme-status-card-warning mt-5 text-sm"
                      data-title-filter-conflicts
                    >
                      <p class="font-medium">This filter contradicts itself</p>
                      <ul class="mt-1 list-disc space-y-1 pl-5">
                        <template
                          x-for="conflict in conflicts()"
                          x-bind:key="conflict.list + conflict.term + conflict.blocked"
                        >
                          <li x-text="conflict.message"></li>
                        </template>
                      </ul>
                      <p class="mt-2" x-text="conflictHint()"></p>
                    </div>
                  </div>
                </div>
                <.form_disclosure title="Test this filter">
                  <p :if={@changeset.data.id} class="mt-3 text-sm text-theme-on-surface-muted">
                    The 50 most recently published indexed titles of this source are checked too.
                  </p>
                  <.input
                    type="textarea"
                    name="title_filter_samples"
                    id="title-filter-samples"
                    value=""
                    label="Sample titles, one per line"
                    x-model="titles"
                  />
                  <div class="mt-3">
                    <.button
                      type="button"
                      variant="secondary"
                      x-on:click="test()"
                      x-bind:disabled="busy || regex.trim() === ''"
                    >
                      Test filter
                    </.button>
                  </div>

                  <div aria-live="polite">
                    <p
                      x-cloak
                      x-show="error"
                      x-text="error"
                      class="theme-status-card theme-status-card-warning mt-3 text-sm"
                    >
                    </p>

                    <template x-for="group in [{ label: 'Sample titles', results: samples }, { label: 'Recent indexed titles', results: indexed }]">
                      <div x-show="tested && !error && group.results.length > 0" class="mt-4">
                        <p class="text-sm font-medium text-theme-on-surface">
                          <span x-text="group.label"></span>:
                          <span x-text="matched(group.results) + ' of ' + group.results.length + ' would download'"></span>
                        </p>
                        <ul class="mt-2 space-y-1 text-sm">
                          <template x-for="result in group.results">
                            <li class="flex items-start gap-2">
                              <span
                                class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium"
                                x-bind:class="result.match ? 'theme-badge-success' : 'theme-badge-warning'"
                                x-text="result.match ? 'Matches' : 'Filtered out'"
                              ></span>
                              <span class="min-w-0 [overflow-wrap:anywhere] text-theme-on-surface" x-text="result.title"></span>
                            </li>
                          </template>
                        </ul>
                      </div>
                    </template>

                    <p
                      x-cloak
                      x-show="tested && !error && samples.length === 0 && indexed.length === 0"
                      class="mt-3 text-sm text-theme-on-surface-muted"
                    >
                      The regex is valid. Add sample titles above to see which ones it matches.
                    </p>
                  </div>
                </.form_disclosure>

                <div
                  x-cloak
                  x-show="showSaveBar()"
                  class="theme-save-bar mt-4"
                  role="region"
                  aria-label="Store this title filter"
                  data-title-filter-save-bar
                >
                  <div class="flex flex-wrap items-center gap-3">
                    <p class="min-w-56 flex-1 text-sm text-theme-on-surface">
                      <template x-if="loadedFilter()">
                        <span>Changes to <strong class="font-semibold" x-text="loadedFilter()?.name"></strong></span>
                      </template>
                      <template x-if="!loadedFilter()">
                        <span>New filter</span>
                      </template>
                      <span class="block text-theme-on-surface-muted" x-text="saveBarPrompt()"></span>
                    </p>

                    <template x-if="!adding">
                      <div class="flex flex-wrap items-center gap-2">
                        <.button
                          x-show="loadedFilter()"
                          type="button"
                          variant="outline"
                          x-on:click="discardChanges()"
                        >
                          Discard changes
                        </.button>
                        <.button type="button" variant="secondary" x-on:click="startStoringNew()">
                          Store as new…
                        </.button>
                        <.button
                          x-show="loadedFilter()"
                          type="button"
                          variant="secondary"
                          x-on:click="updateLoaded()"
                          x-bind:disabled="savedBusy"
                        >
                          <span x-text="'Update \u201c' + loadedFilter()?.name + '\u201d'">Update</span>
                        </.button>
                      </div>
                    </template>

                    <template x-if="adding">
                      <div class="flex flex-wrap items-center gap-2">
                        <div class="w-64">
                          <.input
                            type="text"
                            name="title_filter_save_name"
                            id="title-filter-save-name"
                            value=""
                            placeholder="New filter name"
                            aria-label="New filter name"
                            maxlength="80"
                            x-model="saveName"
                            x-init="$nextTick(() => $el.focus())"
                            x-on:keydown.enter.prevent="saveFilter()"
                            x-on:keydown.escape.prevent="cancelAdding()"
                          />
                        </div>
                        <.button type="button" variant="outline" x-on:click="cancelAdding()">Cancel</.button>
                        <.button
                          type="button"
                          variant="secondary"
                          x-on:click="saveFilter()"
                          x-bind:disabled="savedBusy || saveName.trim() === ''"
                        >
                          Store filter
                        </.button>
                      </div>
                    </template>
                  </div>
                  <div aria-live="polite">
                    <p
                      x-cloak
                      x-show="savedMessage && messageWhere === 'bar'"
                      x-text="savedMessage"
                      class="mt-2 text-sm text-theme-error"
                    >
                    </p>
                  </div>
                </div>
              </div>
            </.form_disclosure>
          </fieldset>
          <.form_disclosure
            title="Title language"
            open={Keyword.has_key?(@changeset.errors, :title_language)}
            data-setting-group
          >
            <:status>{title_language_label(f[:title_language].value)}</:status>
            <div data-setting>
              <.input
                field={f[:title_language]}
                options={title_language_options()}
                type="select"
                label="Title language"
                help="When set, Pinchflat-ngx saves the channel's translated title for that language next to the original title. Existing downloads keep their names."
              />
            </div>
          </.form_disclosure>
          <section
            x-data={
          """
          {
            placeholders: JSON.parse('#{output_path_template_override_placeholders(@media_profiles)}'),
            inputValue: null
          }
          """
        }
            x-on:load-template="inputValue = placeholders[mediaProfileId]"
          >
            <.form_disclosure
              title="Output path template overrides"
              open={
                Enum.any?(
                  [:output_path_template_override, :output_path_template_shorts_override],
                  &Keyword.has_key?(@changeset.errors, &1)
                )
              }
              data-setting-group
            >
              <:status>
                {if f[:output_path_template_override].value || f[:output_path_template_shorts_override].value,
                  do: "Customized for this source",
                  else: "Using the media profile templates"}
              </:status>
              <.input
                field={f[:output_path_template_override]}
                type="text"
                inputclass="font-mono"
                label="Output path template override"
                help={output_path_template_override_help()}
                html_help={true}
                x-bind:placeholder="placeholders[mediaProfileId]"
                x-model.fill="inputValue"
              >
                <:input_append>
                  <button
                    type="button"
                    class="ml-3 inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-m3-sm border border-theme-outline/70 bg-theme-surface-2 px-3 py-3 text-sm font-medium text-theme-on-surface transition hover:bg-theme-surface-3 sm:px-4 md:ml-4"
                    title="Start from the media profile template, then tweak only what you need for this source."
                    aria-label="Insert media profile template. Start from the media profile template, then tweak only what you need for this source."
                    x-on:click="inputValue = placeholders[mediaProfileId]"
                  >
                    <span class="sm:hidden"><.icon name="hero-document-duplicate" class="h-5 w-5" /></span>
                    <span class="hidden sm:inline">Insert media profile template</span>
                  </button>
                </:input_append>
              </.input>

              <.input
                field={f[:output_path_template_shorts_override]}
                type="text"
                inputclass="font-mono"
                label="Shorts output path template override (optional)"
                help="Used for this source's YouTube Shorts. Leave blank to use the media profile's Shorts template, or the primary output path template if neither is set. Must end with .{{ ext }}. Saving leaves existing files in place; later re-downloads and quality upgrades use the new path."
              />
              <details class="mt-2 text-sm text-theme-on-surface-muted">
                <summary class="cursor-pointer py-3 font-medium text-theme-on-surface">
                  How Shorts are identified
                </summary>
                <p class="mt-2">
                  Channel tabs identify Shorts directly. Mixed playlists and fast indexing use the URL and existing
                  duration/aspect-ratio detection, which can misclassify short vertical videos.
                </p>
              </details>
            </.form_disclosure>
          </section>
          <.yt_dlp_options_editor
            collapsed
            id_prefix="source"
            scope_help="Saved to this source's managed config file; existing manually maintained config files keep working. These options apply to every download for this source. The base config and the selected media profile's config still apply, and a media-item config can add its own options."
            contents={@yt_dlp_options}
            version={@yt_dlp_options_version}
            present={@yt_dlp_options_present}
            readable={@yt_dlp_options_readable}
            clearable={@yt_dlp_options_clearable}
            inherited={@yt_dlp_options_inherited}
            profile_presence={@yt_dlp_options_profile_presence}
            error={@yt_dlp_error}
          />
        </section>

        <div class="theme-surface-raised sticky bottom-0 z-10 px-5 py-3 sm:px-7.5">
          <.button class="w-full sm:w-auto" rounding="rounded-m3-sm">Save Source</.button>
        </div>
      </div>
    </div>
  </section>
</.simple_form>

<.modal id="cookie-upload-modal">
  <h3 class="text-2xl text-theme-on-surface">Upload cookies.txt</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    Upload a Netscape-format cookie file exported from your browser extension or account tools.
  </p>

  <.form for={%{}} as={:cookies} action={~p"/sources/cookies/upload"} method="post" multipart class="mt-6 space-y-4">
    <input type="hidden" name="return_to" value={@current_path} />
    <.input
      name="cookies[file]"
      type="file"
      value={nil}
      accept=".txt,text/plain"
      label="Cookie file"
      help="Choose the file to store as the shared cookies.txt file."
    />
    <div class="flex flex-wrap justify-end gap-2">
      <button
        type="button"
        class="theme-button theme-outline-button"
        phx-click={hide_modal("cookie-upload-modal")}
      >
        Cancel
      </button>
      <.button class="w-auto" rounding="rounded-m3-sm">Upload</.button>
    </div>
  </.form>
</.modal>

<.modal id="cookie-paste-modal">
  <h3 class="text-2xl text-theme-on-surface">Paste Cookie Contents</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    Paste the full contents of the file and Pinchflat will create or replace `cookies.txt`.
  </p>

  <.form for={%{}} as={:cookies} action={~p"/sources/cookies/save"} method="post" class="mt-6 space-y-4">
    <input type="hidden" name="return_to" value={@current_path} />
    <.input
      name="cookies[contents]"
      type="textarea"
      label="Cookie file contents"
      value={@cookie_file_contents}
      inputclass="min-h-[18rem] font-mono"
    />
    <div class="flex flex-wrap justify-end gap-2">
      <button
        type="button"
        class="theme-button theme-outline-button"
        phx-click={hide_modal("cookie-paste-modal")}
      >
        Cancel
      </button>
      <.button class="w-auto" rounding="rounded-m3-sm">Save Cookie File</.button>
    </div>
  </.form>
</.modal>

<.modal :if={@cookie_file_exists} id="cookie-inspect-modal">
  <h3 class="text-2xl text-theme-on-surface">Inspect Cookie File</h3>

  <p class="mt-2 text-sm text-theme-on-surface-muted">
    This is the current shared `cookies.txt` content used for sources that enable cookie behavior.
  </p>

  <.input
    name="cookie_file_contents_preview"
    type="textarea"
    label="Current contents"
    value={@cookie_file_contents || ""}
    readonly
    inputclass="mt-4 min-h-[20rem] font-mono"
  />
  <div class="mt-6 flex justify-end">
    <button
      type="button"
      class="theme-button theme-outline-button"
      phx-click={hide_modal("cookie-inspect-modal")}
    >
      Close
    </button>
  </div>
</.modal>
