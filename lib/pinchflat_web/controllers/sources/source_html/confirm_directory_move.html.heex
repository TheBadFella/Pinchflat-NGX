<div class="mb-6 flex flex-row items-center gap-3">
  <.link href={~p"/sources/#{@source}/edit"} aria-label="Back" class="theme-icon-button theme-outline-button">
    <.icon name="hero-arrow-left" class="h-5 w-5" />
  </.link>
  <h2 class="ml-4 break-words text-title-md2 font-bold text-theme-on-surface">Confirm Source Folder Move</h2>
</div>

<section class="theme-surface-raised px-5 py-6 sm:px-7.5">
  <div class="max-w-5xl space-y-6">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-theme-on-surface-muted">{@source.custom_name}</p>
      <h3 class="mt-2 text-2xl font-bold text-theme-on-surface">
        Pinchflat-ngx will move this source's existing files
      </h3>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-theme-on-surface-muted">
        Review the destination before saving. If a conflict is listed, fix it on disk first, then go back and save again.
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <section class="theme-surface-accent rounded-m3-lg px-5 py-4">
        <p class="text-sm font-semibold text-theme-on-surface">From</p>
        <p class="mt-2 break-all font-mono text-sm leading-6 text-theme-on-surface-muted">
          {@directory_move_plan.old_directory}
        </p>
      </section>

      <section class="theme-surface-accent rounded-m3-lg px-5 py-4">
        <p class="text-sm font-semibold text-theme-on-surface">To</p>
        <p class="mt-2 break-all font-mono text-sm leading-6 text-theme-on-surface-muted">
          {@directory_move_plan.new_directory}
        </p>
      </section>
    </div>

    <section class="grid gap-4 sm:grid-cols-3">
      <div class="theme-status-card">
        <p class="text-xs font-semibold uppercase tracking-wide text-theme-on-surface-muted">Files Found</p>
        <p class="mt-2 text-2xl font-bold text-theme-on-surface">{@directory_move_plan.file_count}</p>
      </div>
      <div class="theme-status-card">
        <p class="text-xs font-semibold uppercase tracking-wide text-theme-on-surface-muted">Current Folder</p>
        <p class="mt-2 text-sm font-semibold text-theme-on-surface">
          {if @directory_move_plan.old_directory_exists, do: "Exists", else: "Missing"}
        </p>
      </div>
      <div class="theme-status-card">
        <p class="text-xs font-semibold uppercase tracking-wide text-theme-on-surface-muted">Destination</p>
        <p class="mt-2 text-sm font-semibold text-theme-on-surface">
          {if @directory_move_plan.new_directory_exists, do: "Already exists", else: "Will be created"}
        </p>
      </div>
    </section>

    <section
      :if={Enum.any?(@directory_move_plan.conflicts)}
      class="theme-surface-accent rounded-m3-lg border border-theme-error/70 px-5 py-4"
    >
      <div class="flex items-start gap-3">
        <.icon name="hero-exclamation-triangle" class="mt-0.5 h-5 w-5 shrink-0 text-theme-error" />
        <div>
          <h3 class="font-semibold text-theme-error">File conflicts need attention</h3>
          <p class="mt-2 text-sm leading-6 text-theme-on-surface-muted">
            These destination files already exist. Pinchflat-ngx will not overwrite them automatically.
          </p>
        </div>
      </div>

      <ul class="mt-4 max-h-64 space-y-2 overflow-y-auto rounded-m3-sm border border-theme-outline/70 bg-theme-surface px-4 py-3">
        <li
          :for={conflict <- @directory_move_plan.conflicts}
          class="break-all font-mono text-xs leading-5 text-theme-on-surface"
        >
          {conflict}
        </li>
      </ul>
    </section>

    <section
      :if={!Enum.any?(@directory_move_plan.conflicts)}
      class="theme-surface-accent rounded-m3-lg border border-theme-outline/70 px-5 py-4"
    >
      <div class="flex items-start gap-3">
        <.icon name="hero-information-circle" class="mt-0.5 h-5 w-5 shrink-0 text-theme-primary" />
        <p class="text-sm leading-6 text-theme-on-surface-muted">
          Existing source metadata paths and downloaded media paths in the database will be updated to the new folder.
        </p>
      </div>
    </section>

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
      <.link
        href={~p"/sources/#{@source}/edit"}
        class="theme-outline-button inline-flex justify-center px-5 py-3 text-sm font-medium"
      >
        Back to Edit
      </.link>

      <.form :if={!Enum.any?(@directory_move_plan.conflicts)} for={%{}} action={~p"/sources/#{@source}"} method="put">
        <input type="hidden" name="confirm_directory_move" value="true" />
        <input :for={{key, value} <- @source_params} type="hidden" name={"source[#{key}]"} value={value || ""} />
        <.button rounding="rounded-m3-sm">Save and Move Files</.button>
      </.form>
    </div>
  </div>
</section>
