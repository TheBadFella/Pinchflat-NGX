<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-center gap-3">
    <h2 class="ml-4 text-title-md2 font-bold text-theme-on-surface">
      Diagnostics
    </h2>
  </div>
  <div class="flex flex-wrap items-center gap-2 sm:gap-4">
    <.button
      variant="primary"
      class="w-full sm:w-auto"
      x-data="{ copied: false }"
      x-on:click={~s"
        copyWithCallbacks(
          `#{diagnostic_info_string()}`,
          () => copied = true,
          () => copied = false
        )
      "}
    >
      Copy Diagnostic Info
      <span x-show="copied" x-transition.duration.150ms><.icon name="hero-check" class="ml-2 h-4 w-4" /></span>
    </.button>
    <.button href={~p"/download_logs"} variant="secondary" class="w-full sm:w-auto">
      Download Logs
    </.button>
  </div>
</div>

<div class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
  <h3 class="mb-4 text-lg font-semibold text-theme-on-surface">System Overview</h3>
  <% stats = system_stats() %>
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Pending Downloads</p>
      <p class="text-2xl font-bold text-theme-on-surface">{stats.total_pending_downloads}</p>
    </div>
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Downloaded Media</p>
      <p class="text-2xl font-bold text-theme-on-surface">{stats.total_downloaded}</p>
    </div>
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Total Sources</p>
      <p class="text-2xl font-bold text-theme-on-surface">{stats.total_sources}</p>
    </div>
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Total Media Items</p>
      <p class="text-2xl font-bold text-theme-on-surface">{stats.total_media_items}</p>
    </div>
  </div>
</div>

<% pot_status = po_token_provider_status() %>
<div id="po-token-provider-status" class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
  <div class="mb-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold text-theme-on-surface">PO-token Provider</h3>
    <%= if pot_status.state != :disabled do %>
      <.button
        href={~p"/diagnostics/test_po_token_provider"}
        method="post"
        variant="secondary"
        class="w-full sm:w-auto"
      >
        Test Provider
      </.button>
    <% end %>
  </div>
  <p class={"text-sm font-semibold #{po_token_provider_status_class(pot_status)}"}>
    {pot_status.label}
  </p>
  <p class="mt-1 text-sm text-theme-on-surface-muted">{pot_status.detail}</p>
  <p class="mt-2 text-xs text-theme-on-surface-muted">
    Configure <span class="font-mono">POT_PROVIDER_URL</span> to enable the internal bgutil-compatible provider.
    Health checks use the provider's bounded <span class="font-mono">/ping</span> endpoint and never display tokens.
  </p>
</div>

<!-- Database -->
<% db = database_stats() %>
<div class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold text-theme-on-surface">Database</h3>
    <div :if={sqlite_database?()} class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
      {live_render(@conn, Pinchflat.Settings.IntegrityCheckLive,
        id: "integrity-check-live",
        container: {:div, class: "w-full sm:w-auto"}
      )}
      <.button
        href={~p"/diagnostics/vacuum_database"}
        method="post"
        data-confirm="Compact the database now? Job queues are paused while any running jobs finish, then the database is compacted and the queues resume on their own. With long-running jobs this can take a while."
        variant="primary"
        class="w-full sm:w-auto"
      >
        <.icon name="hero-circle-stack" class="mr-1 h-4 w-4" /> Compact Now
      </.button>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-2 gap-4 md:grid-cols-5">
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Size on Disk</p>
      <p class="text-2xl font-bold text-theme-on-surface">{format_bytes(db.total_bytes)}</p>
      <p class="mt-1 text-xs text-theme-on-surface-muted">
        <%= if sqlite_database?() do %>
          {format_bytes(db.main_file_bytes)} database + {format_bytes(db.wal_file_bytes + db.shm_file_bytes)} WAL
        <% else %>
          Reported by PostgreSQL
        <% end %>
      </p>
    </div>
    <div :if={sqlite_database?()} class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Reclaimable Space</p>
      <p class="text-2xl font-bold text-theme-on-surface">{format_bytes(db.reclaimable_bytes)}</p>
      <p class="mt-1 text-xs text-theme-on-surface-muted">Freed by compacting</p>
    </div>
    <div :if={sqlite_database?()} class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Journal Mode</p>
      <p class="text-2xl font-bold uppercase text-theme-on-surface">{db.journal_mode}</p>
    </div>
    <div :if={!sqlite_database?()} class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Adapter</p>
      <p class="text-2xl font-bold text-theme-on-surface">PostgreSQL</p>
    </div>
    <div class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Orphaned Tasks</p>
      <p class={"text-2xl font-bold #{if orphaned_task_count() > 0, do: "theme-status-error", else: "text-theme-on-surface"}"}>
        {orphaned_task_count()}
      </p>
      <p class="mt-1 text-xs text-theme-on-surface-muted">Should always be 0</p>
    </div>
    <% compaction_enabled = scheduled_compaction_enabled?() %>
    <div :if={sqlite_database?()} class="theme-surface-accent p-4">
      <p class="text-sm text-theme-on-surface-muted">Scheduled Compaction</p>
      <p class={"text-2xl font-bold #{if compaction_enabled, do: "theme-status-success", else: "text-theme-on-surface"}"}>
        {if compaction_enabled, do: "On", else: "Off"}
      </p>
      <p class="mt-1 text-xs text-theme-on-surface-muted">
        {if compaction_enabled, do: "Monthly on the 1st at 03:00", else: "Manual only"}
        <.link
          href={~p"/diagnostics/toggle_scheduled_compaction"}
          method="post"
          class="text-theme-primary hover:underline whitespace-nowrap"
        >
          Turn {if compaction_enabled, do: "off", else: "on"}
        </.link>
      </p>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-2 gap-4 md:grid-cols-5">
    <%= for {table, count} <- table_row_counts() do %>
      <div class="rounded-m3-sm border border-theme-outline/50 bg-theme-surface-2 p-3">
        <p class="text-xs text-theme-on-surface-muted">{format_table_name(table)}</p>
        <p class="text-lg font-semibold text-theme-on-surface">{count}</p>
      </div>
    <% end %>
  </div>

  <p :if={sqlite_database?()} class="text-sm text-theme-on-surface">
    <span class="text-theme-on-surface-muted">Last compaction:</span>
    <.maintenance_status job={latest_maintenance_job()} />
  </p>
  <p :if={sqlite_database?()} class="mt-2 text-xs text-theme-on-surface-muted">
    Compacting (a SQLite VACUUM) shrinks the database by returning space left behind by deleted
    records — old job history, removed media — to the filesystem. The Compact Now button compacts
    on demand at any time. To avoid disturbing downloads and indexing, it
    first pauses the job queues and waits for running jobs to finish (however long they take — a large
    indexing run can be hours), then compacts and resumes the queues on its own. While it waits, the
    queues above show as Paused. It refuses to compact — and reports an error here and under Failed
    Jobs — if there isn't enough free disk space to do it safely.
  </p>
</div>

<div class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold text-theme-on-surface">Queue Health</h3>
    <.button href={~p"/diagnostics"} variant="secondary" class="w-full sm:w-auto">
      <.icon name="hero-arrow-path" class="mr-1 h-4 w-4" /> Refresh
    </.button>
  </div>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <%= for stats <- queue_stats() do %>
      <div class={"theme-status-card #{queue_health_class(stats)}"}>
        <div class="mb-2 flex items-start justify-between">
          <h4 class="font-semibold text-theme-on-surface">{format_queue_name(stats.name)}</h4>
          <span class={"rounded-m3-xs px-2 py-1 text-xs #{queue_status_class(stats)}"}>
            {queue_status_text(stats)}
          </span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-sm">
          <div>
            <span class="text-theme-on-surface-muted">Running:</span>
            <span class="ml-1 text-theme-on-surface">{stats.running}/{stats.limit}</span>
          </div>
          <div>
            <span class="text-theme-on-surface-muted">Available:</span>
            <span class="ml-1 text-theme-on-surface">{stats.available}</span>
          </div>
          <div>
            <span class="text-theme-on-surface-muted">Scheduled:</span>
            <span class="ml-1 text-theme-on-surface">{stats.scheduled}</span>
          </div>
          <div>
            <span class={if stats.retryable > 0, do: "theme-status-error", else: "text-theme-on-surface-muted"}>
              Retryable:
            </span>
            <span class={"ml-1 #{if stats.retryable > 0, do: "theme-status-error font-bold", else: "text-theme-on-surface"}"}>
              {stats.retryable}
            </span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<!-- Stuck Jobs -->
<% stuck = stuck_jobs() %>
<%= if length(stuck) > 0 do %>
  <div class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-theme-on-surface">
        <.icon name="hero-exclamation-triangle" class="mr-2 h-5 w-5 text-theme-warning" />
        Long-Running Jobs ({length(stuck)})
      </h3>
    </div>
    <p class="mb-4 text-sm text-theme-on-surface-muted">
      These jobs have been executing for more than 30 minutes. Orphaned jobs left behind by an
      ungraceful shutdown are automatically recovered the next time Pinchflat restarts, so a job
      here is usually just long-running (for example indexing a large channel or downloading a
      long video). If one is genuinely hung — or it's holding up other work on a single-worker
      setup — you can requeue it. That stops the current run and sends a fresh copy to the back
      of the queue, so other jobs get to run first.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-theme-outline">
            <th class="py-2 text-left text-theme-on-surface-muted">ID</th>
            <th class="py-2 text-left text-theme-on-surface-muted">Queue</th>
            <th class="py-2 text-left text-theme-on-surface-muted">Worker</th>
            <th class="py-2 text-left text-theme-on-surface-muted">Started At</th>
            <th class="py-2 text-left text-theme-on-surface-muted">Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= for job <- stuck do %>
            <tr class="border-b border-theme-outline/50">
              <td class="py-2 text-theme-on-surface">#{job.id}</td>
              <td class="py-2 text-theme-on-surface">{job.queue}</td>
              <td class="py-2 text-theme-on-surface">{format_worker_name(job.worker)}</td>
              <td class="py-2 text-theme-on-surface">{format_datetime(job.attempted_at)}</td>
              <td class="py-2">
                <.link
                  href={~p"/diagnostics/requeue_job/#{job.id}"}
                  method="post"
                  class="text-theme-primary hover:underline"
                  data-confirm="Requeue this job? It stops the current run and moves to the back of the queue so other jobs can run first."
                >
                  Requeue
                </.link>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<!-- Failed Jobs -->
<% retryable = retryable_jobs() %>
<% discarded = discarded_jobs() %>
<div class="theme-surface-raised px-5 py-5 sm:px-7.5">
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h3 class="text-lg font-semibold text-theme-on-surface">Failed Jobs</h3>
    <%= if length(retryable) > 0 do %>
      <.button
        href={~p"/diagnostics/reset_retryable_jobs"}
        method="post"
        data-confirm="Retry all retryable jobs now? Attempt counts and error history will be preserved."
        variant="danger"
        class="w-full sm:w-auto"
      >
        <.icon name="hero-arrow-path" class="mr-1 h-4 w-4" /> Reset All Retryable Jobs
      </.button>
    <% end %>
  </div>

  <.tabbed_layout>
    <:tab title={"Retryable (#{length(retryable)})"} id="retryable">
      <%= if length(retryable) == 0 do %>
        <p class="text-theme-on-surface-muted">No retryable jobs. Everything is running smoothly!</p>
      <% else %>
        <p class="mb-4 text-sm text-theme-on-surface-muted">
          These jobs have failed and are waiting to be retried automatically. You can reset them to retry immediately, or requeue them to run again after other queued jobs.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-theme-outline">
                <th class="py-2 text-left text-theme-on-surface-muted">ID</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Queue</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Worker</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Attempts</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Last Error</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= for job <- retryable do %>
                <tr class="border-b border-theme-outline/50">
                  <td class="py-2 text-theme-on-surface">#{job.id}</td>
                  <td class="py-2 text-theme-on-surface">{job.queue}</td>
                  <td class="py-2 text-theme-on-surface">{format_worker_name(job.worker)}</td>
                  <td class="py-2 text-theme-on-surface">{job.attempt}/{job.max_attempts}</td>
                  <td class="max-w-xs truncate py-2 theme-status-error" title={extract_last_error(job.errors)}>
                    {extract_last_error(job.errors)}
                  </td>
                  <td class="py-2">
                    <.link
                      href={~p"/diagnostics/reset_job/#{job.id}"}
                      method="post"
                      class="mr-3 text-theme-primary hover:underline"
                    >
                      Reset
                    </.link>
                    <.link
                      href={~p"/diagnostics/requeue_job/#{job.id}"}
                      method="post"
                      class="text-theme-primary hover:underline"
                      data-confirm="Requeue this job? It moves to the back of the queue so other jobs can run first."
                    >
                      Requeue
                    </.link>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </:tab>

    <:tab title={"Discarded (#{length(discarded)})"} id="discarded">
      <%= if length(discarded) == 0 do %>
        <p class="text-theme-on-surface-muted">No discarded jobs.</p>
      <% else %>
        <p class="mb-4 text-sm text-theme-on-surface-muted">
          These jobs failed and exhausted all of their retries, so they won't run again on their own. Reset one to queue it for another attempt.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-theme-outline">
                <th class="py-2 text-left text-theme-on-surface-muted">ID</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Queue</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Worker</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Attempts</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Discarded At</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Last Error</th>
                <th class="py-2 text-left text-theme-on-surface-muted">Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= for job <- discarded do %>
                <tr class="border-b border-theme-outline/50">
                  <td class="py-2 text-theme-on-surface">#{job.id}</td>
                  <td class="py-2 text-theme-on-surface">{job.queue}</td>
                  <td class="py-2 text-theme-on-surface">{format_worker_name(job.worker)}</td>
                  <td class="py-2 text-theme-on-surface">{job.attempt}/{job.max_attempts}</td>
                  <td class="py-2 text-theme-on-surface">{format_datetime(job.discarded_at)}</td>
                  <td class="max-w-xs truncate py-2 theme-status-error" title={extract_last_error(job.errors)}>
                    {extract_last_error(job.errors)}
                  </td>
                  <td class="py-2">
                    <.link
                      href={~p"/diagnostics/reset_job/#{job.id}"}
                      method="post"
                      class="text-theme-primary hover:underline"
                    >
                      Reset
                    </.link>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </:tab>
  </.tabbed_layout>
</div>
