<div
  x-data="settingsPage()"
  data-settings-retry={@changeset.action != nil}
  x-bind:data-settings-dirty="settingsDirty || $el.hasAttribute('data-settings-retry')"
  x-bind:class="{ 'pb-24': settingsDirty || $el.hasAttribute('data-settings-retry') }"
>
  <div :if={message = Phoenix.Flash.get(@conn.assigns.flash, :settings_saved)} class="theme-toast-stack">
    <.flash id="settings-saved-toast" kind={:info} toast>{message}</.flash>
  </div>

  <h2 class="mb-6 ml-4 text-title-md2 font-bold text-theme-on-surface">Settings</h2>

  <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8">
    <.settings_nav
      label="Settings sections"
      placeholder="cookies, workers, plex"
      desktop_nav_surface={:surface_2}
      bleed="-mx-4 bg-theme-surface-2 px-4 md:-mx-6 md:px-6"
      sections={[
        {"settings-notifications", "Notifications"},
        {"settings-extractor", "Extractor"},
        {"settings-discovery", "Channel discovery"},
        {"settings-yt-dlp", "yt-dlp"},
        {"settings-codecs", "Codecs"},
        {"settings-storage", "Storage"},
        {"media-server-settings", "Media servers"},
        {"settings-yt-dlp-plugins", "yt-dlp plugins"},
        {"settings-cookies", "Cookies"},
        {"api-access-settings", "API and access"}
      ]}
    />

    <div data-settings class="mt-6 flex min-w-0 flex-col gap-6 lg:mt-0">
      <.settings_no_match class="theme-surface-raised px-5 py-8 text-center sm:px-7.5" />

      <.setting_form
        conn={@conn}
        changeset={@changeset}
        action={~p"/settings"}
        concurrency_fields={@concurrency_fields}
      />
    </div>
  </div>
</div>
