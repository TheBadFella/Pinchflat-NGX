<div x-data="settingsPage()">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h2 class="ml-4 text-title-md2 font-bold text-theme-on-surface">Settings</h2>

    <button
      type="button"
      class="theme-filter-button rounded-m3-sm whitespace-nowrap text-theme-on-surface-muted hover:text-theme-on-surface hover:underline"
      x-bind:aria-pressed="advancedMode"
      x-on:click="advancedMode = !advancedMode"
    >
      Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
    </button>
  </div>

  <div class="lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-8">
    <.settings_nav
      label="Settings sections"
      placeholder="cookies, workers, plex"
      bleed="-mx-4 bg-theme-bg px-4 md:-mx-6 md:px-6"
      sections={[
        {"settings-notifications", "Notifications", false},
        {"settings-extractor", "Extractor", false},
        {"database-migration", "Database", false},
        {"settings-discovery", "Channel discovery", false},
        {"settings-yt-dlp", "yt-dlp", false},
        {"settings-codecs", "Codecs", true},
        {"settings-storage", "Storage", false},
        {"media-server-settings", "Media servers", false},
        {"settings-yt-dlp-plugins", "yt-dlp plugins", false},
        {"settings-cookies", "Cookies", false},
        {"api-access-settings", "API and access", false}
      ]}
    />

    <div data-settings class="mt-6 flex min-w-0 flex-col gap-6 lg:mt-0">
      <.settings_no_match class="theme-surface-raised px-5 py-8 text-center sm:px-7.5" />

      <.setting_form
        conn={@conn}
        changeset={@changeset}
        action={~p"/settings"}
        concurrency_fields={@concurrency_fields}
      />
    </div>
  </div>
</div>
