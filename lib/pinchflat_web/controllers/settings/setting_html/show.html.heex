<div x-data="settingsPage()" class="flex flex-col gap-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="ml-4 text-title-md2 font-bold text-theme-on-surface">Settings</h2>

    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
      <div class="theme-surface-accent w-full rounded-m3-sm sm:w-80">
        <div class="relative">
          <span class="absolute left-3 top-1/2 flex -translate-y-1/2 text-theme-on-surface-muted">
            <.icon name="hero-magnifying-glass" />
          </span>
          <input
            type="search"
            x-model="query"
            x-on:keydown.escape.window="query = ''"
            placeholder="Search settings..."
            autocomplete="off"
            class="w-full border-0 bg-transparent py-3 pl-10 pr-4 text-theme-on-surface placeholder:text-theme-on-surface-muted focus:outline-none focus:ring-0"
          />
        </div>
      </div>

      <button
        type="button"
        class="theme-filter-button rounded-m3-sm whitespace-nowrap text-theme-on-surface-muted hover:text-theme-on-surface hover:underline sm:text-right"
        x-bind:aria-pressed="advancedMode"
        x-on:click="advancedMode = !advancedMode"
      >
        Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
      </button>
    </div>
  </div>

  <div class="flex flex-wrap gap-2 px-1" role="group" aria-label="Settings groups">
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('')"
      x-bind:class="!selectedGroup ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="!selectedGroup"
    >
      All
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('notifications')"
      x-bind:class="selectedGroup === 'notifications' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'notifications'"
    >
      Notifications
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('extractor')"
      x-bind:class="selectedGroup === 'extractor' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'extractor'"
    >
      Extractor
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('discovery')"
      x-bind:class="selectedGroup === 'discovery' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'discovery'"
    >
      Channel Discovery
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('backups')"
      data-settings-group="backups"
      x-bind:class="selectedGroup === 'backups' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'backups'"
    >
      PostgreSQL Backups
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('ytdlp')"
      x-bind:class="selectedGroup === 'ytdlp' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'ytdlp'"
    >
      yt-dlp
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-on:click="selectGroup('cookies')"
      x-bind:class="selectedGroup === 'cookies' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'cookies'"
    >
      Cookies
    </button>
    <button
      type="button"
      class="theme-filter-button rounded-full border"
      x-show="advancedMode || query.trim()"
      x-on:click="selectGroup('codec')"
      x-bind:class="selectedGroup === 'codec' ? 'border-theme-primary bg-theme-primary text-theme-on-primary' : 'border-theme-outline text-theme-on-surface-muted hover:text-theme-on-surface'"
      x-bind:aria-pressed="selectedGroup === 'codec'"
    >
      Codec Options
    </button>
  </div>

  <.setting_form
    conn={@conn}
    changeset={@changeset}
    action={~p"/settings"}
    concurrency_fields={@concurrency_fields}
    backup_status={@backup_status}
  />
</div>
