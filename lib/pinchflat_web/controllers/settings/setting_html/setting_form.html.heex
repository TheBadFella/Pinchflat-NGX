<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  id="settings-form"
  class="flex flex-col gap-6"
>
  <.error :if={@changeset.action}>Oops, something went wrong! Please check the errors below.</.error>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('notifications')">
    <h3 class="text-2xl text-theme-on-surface">Notification Settings</h3>

    {live_render(
      @conn,
      Pinchflat.Settings.AppriseServerLive,
      session: %{"value" => f[:apprise_server].value}
    )}
    <.input
      field={f[:notification_include_video_titles]}
      type="checkbox"
      label="Include video titles"
      help="Include up to 10 video titles, newest first. Notifications with titles are limited to 1,024 characters."
    />
    <.input
      field={f[:external_base_url]}
      placeholder="https://pinchflat.example.com"
      type="text"
      label="External Base URL"
      help={external_base_url_help()}
      inputclass="font-mono text-sm mr-4"
    />
  </section>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('extractor')">
    <h3 class="text-2xl text-theme-on-surface">Extractor Settings</h3>

    {live_render(
      @conn,
      Pinchflat.Settings.YoutubeApiKeyLive,
      session: %{"value" => f[:youtube_api_key].value}
    )}
    <.input
      field={f[:extractor_sleep_interval_seconds]}
      placeholder="0"
      type="number"
      label="Sleep Interval (seconds)"
      help="Sleep interval in seconds between each extractor request. Must be a positive whole number. Set to 0 to disable"
    />
    <.input
      field={f[:download_throughput_limit]}
      placeholder="4.2M"
      label="Download Throughput"
      help="Sets the max bytes-per-second throughput when downloading media. Examples: '50K' or '4.2M'. Leave blank to disable"
    />
    <.input
      field={f[:yt_dlp_download_worker_concurrency]}
      type="number"
      label="Download Workers"
      help={concurrency_help(@concurrency_fields.download, download_workers_help())}
      html_help={@concurrency_fields.download.locked}
      disabled={@concurrency_fields.download.locked}
    />
    <.input
      field={f[:yt_dlp_index_worker_concurrency]}
      type="number"
      label="Indexing Workers"
      help={concurrency_help(@concurrency_fields.index, indexing_workers_help())}
      html_help={@concurrency_fields.index.locked}
      disabled={@concurrency_fields.index.locked}
    />
    <.input
      field={f[:yt_dlp_remote_metadata_worker_concurrency]}
      type="number"
      label="Metadata Workers"
      help={concurrency_help(@concurrency_fields.metadata, metadata_workers_help())}
      html_help={@concurrency_fields.metadata.locked}
      disabled={@concurrency_fields.metadata.locked}
    />
    <.input
      field={f[:restrict_filenames]}
      type="toggle"
      label="Restrict Filenames"
      help="Restrict filenames to only ASCII characters and avoid ampersands/spaces in filenames"
    />

    <.input
      field={f[:ignore_unavailable_media]}
      type="toggle"
      label="Ignore Unavailable Media"
      help="Mark members-only, private, and removed videos as skipped instead of repeatedly erroring. They stay in the database but won't be retried"
    />
    <div
      x-data={"{ is12h: #{f[:time_format].value == "12h"} }"}
      phx-update="ignore"
      id="time-format-wrapper"
    >
      <.label for={"#{f[:time_format].id}-toggle"}>Time Format</.label>
      <div class="relative flex flex-col">
        <input
          type="hidden"
          id={f[:time_format].id}
          name={f[:time_format].name}
          x-bind:value="is12h ? '12h' : '24h'"
        />
        <button
          type="button"
          id={"#{f[:time_format].id}-toggle"}
          role="switch"
          aria-label="Use 12-hour time"
          x-bind:aria-checked="is12h ? 'true' : 'false'"
          class="inline-flex min-h-11 w-fit items-center gap-3 text-sm cursor-pointer rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-theme-primary focus-visible:ring-offset-2 focus-visible:ring-offset-theme-surface"
          @click={"is12h = !is12h; dispatchFor('#{f[:time_format].id}', 'change')"}
        >
          <span x-bind:class="!is12h ? 'text-theme-on-surface font-medium' : 'text-theme-on-surface-muted opacity-60'">24hr</span>
          <div class="theme-switch-target">
            <div
              x-bind:class="is12h ? 'border-theme-primary/70 bg-theme-primary-container' : 'border-theme-outline bg-theme-surface-5'"
              class="theme-switch-track"
            >
            </div>
            <div
              x-bind:class="is12h ? 'translate-x-6 bg-theme-primary' : 'translate-x-0 bg-theme-on-surface-muted'"
              class="theme-switch-thumb"
            >
            </div>
          </div>
          <span x-bind:class="is12h ? 'text-theme-on-surface font-medium' : 'text-theme-on-surface-muted opacity-60'">12hr</span>
        </button>
        <.help>Clock used when displaying timestamps in the UI</.help>
      </div>
    </div>

    <.input
      field={f[:database_maintenance_enabled]}
      type="toggle"
      label="Scheduled Database Compaction"
      help="Automatically compact the database once a month to reclaim disk space. Job queues are paused while running jobs finish, then processing resumes. You can always compact manually from the Diagnostics page"
    />
  </section>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('backups')">
    <h3 class="text-2xl text-theme-on-surface">PostgreSQL Backups</h3>
    <%= if @backup_status.available do %>
      <.input
        field={f[:postgres_backup_retention_count]}
        type="number"
        min="1"
        max="100"
        label="Backups to Keep"
        help="After each successful backup, Pinchflat-ngx keeps this many completed PostgreSQL dumps and removes older ones. Failed or partial dumps are never retained."
      />
    <% else %>
      <p id="postgres-backups-unavailable" class="mt-2 text-sm theme-status-warning">
        PostgreSQL backups are unavailable in the SQLite image. Use the PostgreSQL image to create database dumps.
      </p>
    <% end %>
  </section>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('discovery')">
    <h3 class="text-2xl text-theme-on-surface">Channel Discovery</h3>

    <p class="mt-2 max-w-prose text-sm text-theme-on-surface-muted">
      Find channel suggestions from your locally stored metadata and subscribed channels.
    </p>

    <div x-data={"{ channelDiscoveryEnabled: #{f[:channel_discovery_enabled].value} }"}>
      <.input
        field={f[:channel_discovery_enabled]}
        type="toggle"
        label="Enable Channel Discovery"
        help="Opt in to scheduled channel discovery scans. This is disabled by default and only runs after you enable it."
        x-model="channelDiscoveryEnabled"
      />
      <.input
        field={f[:channel_discovery_mentions_enabled]}
        type="toggle"
        label="Discover Channels from Mentions"
        help="Scan locally stored descriptions and metadata for channel references. Only applies when Channel Discovery is enabled."
        x-bind:disabled="!channelDiscoveryEnabled"
      />
      <.input
        field={f[:channel_discovery_featured_enabled]}
        type="toggle"
        label="Discover Featured Channels"
        help="Look for channels featured by your existing subscriptions. Only applies when Channel Discovery is enabled."
        x-bind:disabled="!channelDiscoveryEnabled"
      />
    </div>
  </section>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('ytdlp')">
    <h3 class="text-2xl text-theme-on-surface">yt-dlp</h3>

    {live_render(
      @conn,
      Pinchflat.Settings.YtDlpVersionLive,
      session: %{
        "policy" => f[:yt_dlp_update_policy].value,
        "pinned_version" => f[:yt_dlp_pinned_version].value
      }
    )}

    <div class="mt-8 border-t border-theme-outline/60 pt-6">
      {live_render(@conn, Pinchflat.Settings.YtDlpConfigLive, id: "yt-dlp-config-live")}
    </div>
  </section>

  <section
    class="theme-surface-raised px-5 py-5 sm:px-7.5"
    x-show="(advancedMode || query.trim()) && matchGroup('codec')"
  >
    <h3 class="text-2xl text-theme-on-surface">Codec Options</h3>

    <p class="mt-2 max-w-prose text-sm text-theme-on-surface-muted">
      The best available codec will be used if your preferred codecs are not found
    </p>

    <.input
      field={f[:video_codec_preference]}
      placeholder="avc"
      type="text"
      label="Video Codec Preference"
      help="Video codec preference. Will be remuxed into an MP4 container. See below for more details"
      inputclass="font-mono text-sm mr-4"
    />
    <.input
      field={f[:audio_codec_preference]}
      placeholder="m4a"
      type="text"
      label="Audio Codec Preference"
      help="Audio codec preference. See below for more details"
      inputclass="font-mono text-sm mr-4"
    />

    <div class="theme-surface-accent mt-5 p-4 md:p-6"><.codec_settings_help /></div>
  </section>

  <section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('storage')">
    <h3 class="text-2xl text-theme-on-surface">Storage &amp; Space Protection</h3>
    <p class="mt-2 text-sm text-theme-on-surface-muted">
      Prevent downloads from filling the disk. When enabled, downloads pause if free space falls below this threshold. Blocked jobs snooze without failing.
    </p>

    <%= if f[:download_space_protection_blocked].value do %>
      <div class="theme-surface-accent mt-4 rounded-m3-md border border-theme-warning/40 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h4 class="font-bold theme-status-warning">Downloads Blocked: Low Storage Space</h4>
            <p class="text-sm text-theme-on-surface-muted mt-1">
              Protected storage location: <span class="font-medium text-theme-on-surface">{f[:download_space_protection_blocked_location].value || "destination"}</span>.
              <%= if f[:download_space_protection_free_bytes].value do %>
                Measured free space: <.readable_filesize byte_size={f[:download_space_protection_free_bytes].value} />.
              <% end %>
            </p>
          </div>
          <div>
            <.button
              href={~p"/settings/resume_downloads"}
              method="post"
              variant="primary"
            >
              Check storage and resume downloads
            </.button>
          </div>
        </div>
      </div>
    <% end %>

    <.input
      field={f[:download_space_protection_enabled]}
      type="toggle"
      label="Enable Low-Space Protection"
      help="Check free disk space before each download starts. Disabled by default"
    />

    <.input
      field={f[:download_space_protection_threshold_bytes]}
      type="number"
      label="Minimum Free Space Threshold (bytes)"
      help="Minimum available disk space in bytes (e.g. 10737418240 for 10 GiB). Recovery requires this threshold plus 1 GiB"
    />
  </section>
  <section
    id="media-server-settings"
    class="theme-surface-raised px-5 py-5 sm:px-7.5"
    x-show="matchGroup('media-servers')"
  >
    <h3 class="text-2xl text-theme-on-surface mb-2">Media Server Integrations</h3>
    <p class="text-sm text-theme-on-surface-muted mb-6">
      Automatically trigger library scans on local Plex, Jellyfin, or Emby servers when downloads finish.
    </p>

    <%!-- Plex Media Server --%>
    <div class="border-t border-theme-outline/50 pt-6 mt-6">
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-semibold text-theme-on-surface">Plex Media Server</h4>
        {live_render(@conn, Pinchflat.Settings.MediaServerTestLive,
          id: "plex-test-button",
          session: %{"server_type" => "plex"}
        )}
      </div>

      <.input
        field={f[:plex_enabled]}
        type="toggle"
        label="Enable Plex Refresh"
        help="Trigger a section scan on Plex after each completed media download"
      />

      <.input
        field={f[:plex_url]}
        type="text"
        placeholder="http://192.168.1.100:32400"
        label="Plex Server URL"
        help="Base URL of your Plex Media Server (e.g. http://192.168.1.100:32400)"
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:plex_token]}
        type="password"
        placeholder="Enter Plex token"
        label="Plex Token (X-Plex-Token)"
        help="Your Plex authentication token. Stored in the application database and masked in this form."
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:plex_library_section_id]}
        type="text"
        placeholder="all"
        label="Library Section ID"
        help="Target section ID to refresh (e.g. '1', '2'), or 'all' to refresh all library sections"
        inputclass="font-mono text-sm mr-4"
      />
    </div>

    <%!-- Jellyfin --%>
    <div class="border-t border-theme-outline/50 pt-6 mt-6">
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-semibold text-theme-on-surface">Jellyfin</h4>
        {live_render(@conn, Pinchflat.Settings.MediaServerTestLive,
          id: "jellyfin-test-button",
          session: %{"server_type" => "jellyfin"}
        )}
      </div>

      <.input
        field={f[:jellyfin_enabled]}
        type="toggle"
        label="Enable Jellyfin Refresh"
        help="Trigger a full library refresh on Jellyfin after each completed media download (Jellyfin /Library/Refresh initiates a full library scan)"
      />

      <.input
        field={f[:jellyfin_url]}
        type="text"
        placeholder="http://192.168.1.100:8096"
        label="Jellyfin Server URL"
        help="Base URL of your Jellyfin server (e.g. http://192.168.1.100:8096)"
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:jellyfin_api_key]}
        type="password"
        placeholder="Enter Jellyfin API key"
        label="Jellyfin API Key"
        help="API Key generated in Jellyfin Dashboard -> Advanced -> Keys."
        inputclass="font-mono text-sm mr-4"
      />
    </div>

    <%!-- Emby --%>
    <div class="border-t border-theme-outline/50 pt-6 mt-6">
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-lg font-semibold text-theme-on-surface">Emby</h4>
        {live_render(@conn, Pinchflat.Settings.MediaServerTestLive,
          id: "emby-test-button",
          session: %{"server_type" => "emby"}
        )}
      </div>

      <.input
        field={f[:emby_enabled]}
        type="toggle"
        label="Enable Emby Refresh"
        help="Trigger a library refresh on Emby after each completed media download"
      />

      <div class="theme-banner-warning flex items-start gap-3 rounded-m3-sm p-4 text-xs mb-4">
        <.icon name="hero-exclamation-triangle" class="h-5 w-5 shrink-0 text-theme-warning mt-0.5" />
        <div>
          <p class="font-bold">Important Scan Scope Advisory:</p>
          <p class="mt-1">
            Emby's documented API (<code class="font-mono">POST /Library/Refresh</code>) triggers a full-library scan across all configured libraries and requires administrator privileges. It is not an exact-file or single-folder refresh. To prevent unintentional system load, automatic post-download refresh requires your explicit confirmation below.
          </p>
        </div>
      </div>

      <.input
        field={f[:emby_confirm_full_scan]}
        type="toggle"
        label="Confirm Full Library Scan"
        help="I understand that Emby will perform a server-wide library scan when downloads finish."
      />

      <.input
        field={f[:emby_url]}
        type="text"
        placeholder="http://192.168.1.100:8096"
        label="Emby Server URL"
        help="Base URL of your Emby server (e.g. http://192.168.1.100:8096)"
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:emby_api_key]}
        type="password"
        placeholder="Enter Emby API key"
        label="Emby API Key"
        help="API Key generated in Emby Server Settings -> Advanced -> Api Keys."
        inputclass="font-mono text-sm mr-4"
      />
    </div>
  </section>
</.simple_form>

<section class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('cookies')">
  <h3 class="text-2xl text-theme-on-surface">Cookies</h3>
  {live_render(@conn, Pinchflat.Settings.CookieFileLive, id: "cookie-file-live")}
  {live_render(@conn, Pinchflat.Settings.DefaultCookieBehaviourLive, id: "default-cookie-behaviour-live")}
</section>

<section id="postgres-backups" class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('backups')">
  <h3 class="text-2xl text-theme-on-surface">PostgreSQL Backup Files</h3>
  <%= if @backup_status.available do %>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-theme-on-surface-muted">
        Dumps are stored in Pinchflat-ngx's persistent configuration volume and are available only through this authenticated UI.
      </p>
      <.button
        href={~p"/settings/backups"}
        method="post"
        variant="primary"
        class="w-full shrink-0 sm:w-auto"
      >
        <.icon name="hero-circle-stack" class="mr-1 h-4 w-4" /> Create and Download Backup
      </.button>
    </div>

    <%= if @backup_status.backups == [] do %>
      <p class="mt-4 text-sm text-theme-on-surface-muted">No completed PostgreSQL backups are available yet.</p>
    <% else %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-theme-outline">
              <th class="py-2 text-left text-theme-on-surface-muted">Backup</th>
              <th class="py-2 text-left text-theme-on-surface-muted">Created</th>
              <th class="py-2 text-left text-theme-on-surface-muted">Size</th>
              <th class="py-2 text-left text-theme-on-surface-muted">Action</th>
            </tr>
          </thead>
          <tbody>
            <%= for backup <- @backup_status.backups do %>
              <tr class="border-b border-theme-outline/50">
                <td class="py-2 font-mono text-xs text-theme-on-surface">{backup.filename}</td>
                <td class="py-2 text-theme-on-surface">{format_backup_datetime(backup.modified_at)}</td>
                <td class="py-2 text-theme-on-surface">{format_backup_size(backup.size)}</td>
                <td class="py-2">
                  <.link
                    href={~p"/settings/backups/#{backup.filename}"}
                    class="text-theme-primary hover:underline"
                  >
                    Download
                  </.link>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <p class="mt-2 text-sm theme-status-warning">
      PostgreSQL backup files are unavailable because this installation uses SQLite.
    </p>
  <% end %>
</section>

<section id="api-access-settings" class="theme-surface-raised px-5 py-5 sm:px-7.5" x-show="matchGroup('access')">
  <h3 class="text-2xl text-theme-on-surface">API &amp; Access</h3>
  <div class="mt-6">
    {live_render(@conn, Pinchflat.Settings.ShareTokensLive,
      id: "share-tokens-live",
      session: %{"base_url" => url(@conn, ~p"/")}
    )}
  </div>
</section>

<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <.button
    variant="primary"
    class="w-full sm:w-auto"
    form="settings-form"
    x-show="matchGroup('media-servers') || matchGroup('notifications') || matchGroup('extractor') || matchGroup('storage') || matchGroup('backups') || matchGroup('discovery') || matchGroup('ytdlp') || ((advancedMode || query.trim()) && matchGroup('codec'))"
  >
    Save Settings
  </.button>
</div>

<p
  class="theme-surface-raised px-5 py-8 text-center text-sm text-theme-on-surface-muted sm:px-7.5"
  x-cloak
  x-show="!matchGroup('media-servers') && !matchGroup('notifications') && !matchGroup('extractor') && !matchGroup('storage') && !matchGroup('discovery') && !matchGroup('ytdlp') && !matchGroup('cookies') && !matchGroup('backups') && !matchGroup('access') && !((advancedMode || query.trim()) && matchGroup('codec'))"
>
  No settings match "<span x-text="query.trim()"></span>".
</p>
