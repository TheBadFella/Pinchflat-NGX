<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <div class="flex gap-3 items-center">
    <h2 class="text-title-md2 font-bold text-theme-on-surface ml-4">
      File reconciliation
    </h2>
  </div>
</div>

<div class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5">
  <h3 class="text-lg font-semibold text-theme-on-surface mb-2">Update files after settings changes</h3>
  <p class="text-sm text-theme-on-surface-muted mb-4">
    Reconciliation updates downloaded files to match your current output paths, filenames and associated-file settings.
    Build a plan, review the proposed changes, then apply it when you are ready.
  </p>
  <div class="theme-status-card theme-status-card-info mb-6 text-sm">
    Scanning does not change any files. Changes are applied only after you review and approve the plan.
  </div>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
    <.form :let={f} for={%{}} as={:plan} action={~p"/reconciliation"} method="post" class="min-w-0 space-y-4">
      <div>
        <.input
          field={f[:mode]}
          type="select"
          label="Mode"
          options={mode_options()}
          value="local"
        />
      </div>
      <.input
        field={f[:source_id]}
        type="select"
        label="Scope"
        options={source_options(@sources)}
        value={@preselected_source_id || "all"}
        help="Choose one source or all sources."
      />
      <div>
        <.button variant="primary">
          <.icon name="hero-magnifying-glass" class="h-4 w-4 mr-1" /> Scan and Build Plan
        </.button>
      </div>
    </.form>
    <section class="min-w-0" aria-labelledby="reconciliation-modes">
      <h4 id="reconciliation-modes" class="mb-3 font-semibold text-theme-on-surface">Reconciliation modes</h4>
      <dl class="space-y-4 text-sm text-theme-on-surface-muted">
        <div>
          <dt class="font-semibold text-theme-on-surface">Local only</dt>
          <dd class="mt-1">
            Move and rename existing files, and rebuild NFO and info.json files from stored metadata. No network requests are made.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-theme-on-surface">Online mode</dt>
          <dd class="mt-1">
            Includes local changes and downloads missing thumbnails and subtitles when available. Network requests are required.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-theme-on-surface">Full sync</dt>
          <dd class="mt-1">
            Includes online changes and queues new downloads when the file type or container no longer matches the media profile. Review the re-download list before applying.
          </dd>
        </div>
      </dl>
    </section>
  </div>
  <div class="theme-status-card theme-status-card-warning mt-6 space-y-2 text-sm">
    <p>
      Reconciliation can delete associated files disabled in your settings. Full sync can download media again and use bandwidth.
    </p>
    <p>
      Resolution changes and embedded features are not detected. Use Redownload Everything on the source page to update those files.
    </p>
  </div>
</div>

{live_render(@conn, Pinchflat.Settings.ReconcilePlanLive, id: "reconcile-plan-live")}

<div
  :if={@plans != []}
  class="theme-surface-raised mb-6 px-5 py-5 sm:px-7.5"
>
  <h3 class="text-lg font-semibold text-theme-on-surface mb-4">Past Runs</h3>
  <div class="max-w-full overflow-x-auto">
    <.table rows={@plans} table_class="text-theme-on-surface">
      <:col :let={plan} label="ID">{plan.id}</:col>
      <:col :let={plan} label="Scope">{plan_scope_name(plan)}</:col>
      <:col :let={plan} label="Mode">{humanize_mode(plan.mode)}</:col>
      <:col :let={plan} label="Status">
        <span class={plan_status_class(plan.status)}>{plan.status}</span>
      </:col>
      <:col :let={plan} label="Moves">{plan.move_count}</:col>
      <:col :let={plan} label="Backfills">{plan.backfill_count}</:col>
      <:col :let={plan} label="Deletions">{plan.delete_count}</:col>
      <:col :let={plan} label="Re-downloads">{plan.redownload_count}</:col>
      <:col :let={plan} label="Created">
        <.datetime_in_zone datetime={plan.inserted_at} format="%Y-%m-%d %H:%M" />
      </:col>
    </.table>
  </div>
</div>
