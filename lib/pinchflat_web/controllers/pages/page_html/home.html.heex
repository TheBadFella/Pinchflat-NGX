<%= if assigns[:setting] && @setting.download_space_protection_blocked do %>
  <div class="theme-surface-raised mb-4 rounded-m3-md border border-theme-warning/40 p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-3">
        <.icon name="hero-exclamation-triangle" class="theme-status-warning mt-0.5 h-6 w-6 shrink-0" />
        <div>
          <h3 class="text-lg font-bold text-theme-on-surface">Downloads Paused: Storage Space Low</h3>
          <p class="text-sm text-theme-on-surface-muted mt-1">
            New downloads are temporarily blocked because the
            <span class="font-medium text-theme-on-surface">{@setting.download_space_protection_blocked_location ||
              "destination"}</span>
            storage is low on space.
            <%= if @setting.download_space_protection_free_bytes do %>
              Available: <.readable_filesize byte_size={@setting.download_space_protection_free_bytes} />
              (minimum required: <.readable_filesize byte_size={@setting.download_space_protection_threshold_bytes} />).
            <% end %>
          </p>
        </div>
      </div>
      <div>
        <.button
          href={~p"/settings/resume_downloads?#{[redirect_to: ~p"/"]}"}
          method="post"
          variant="primary"
        >
          Check storage and resume downloads
        </.button>
      </div>
    </div>
  </div>
<% end %>

<div class="theme-surface-raised flex flex-wrap items-center gap-x-8 gap-y-2 px-5 py-3">
  <a href={~p"/media_profiles"} class="flex items-baseline gap-2">
    <span class="text-sm font-medium text-theme-on-surface-muted">
      Media <.pluralize count={@media_profile_count} word="Profile" />
    </span>
    <span class="font-semibold text-theme-on-surface"><.localized_number number={@media_profile_count} /></span>
  </a>

  <a href={~p"/sources"} class="flex items-baseline gap-2">
    <span class="text-sm font-medium text-theme-on-surface-muted">
      <.pluralize count={@source_count} word="Source" />
    </span>
    <span class="font-semibold text-theme-on-surface"><.localized_number number={@source_count} /></span>
  </a>

  <span class="flex items-baseline gap-2">
    <span class="text-sm font-medium text-theme-on-surface-muted">
      <.pluralize count={@media_item_count} word="Download" />
    </span>
    <span class="font-semibold text-theme-on-surface"><.localized_number number={@media_item_count} /></span>
  </span>

  <span class="flex items-baseline gap-2">
    <span class="text-sm font-medium text-theme-on-surface-muted">Library Size</span>
    <span class="font-semibold text-theme-on-surface"><.readable_filesize byte_size={@media_item_size} /></span>
  </span>
</div>

<div class="theme-surface-raised mt-4 p-5">
  <span class="mb-4 block text-2xl font-medium text-theme-on-surface">Media History</span>
  <.tabbed_layout active_tab={@active_tab} tab_href={@tab_href}>
    <:tab title="Latest" id="latest">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "latest", "latest_range" => @latest_range}
      )}
    </:tab>

    <:tab title="Pending" id="pending">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "pending"}
      )}
    </:tab>
    <:tab title="Failed" id="failed">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "failed"}
      )}
    </:tab>
    <:tab title="Downloaded" id="downloaded">
      {live_render(
        @conn,
        Pinchflat.Pages.HistoryTableLive,
        session: %{"media_state" => "downloaded"}
      )}
    </:tab>
  </.tabbed_layout>
</div>
