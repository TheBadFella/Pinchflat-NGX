<div class="flex flex-col items-center gap-6 text-center">
  <img src={~p"/images/logo-2024-03-20.png"} alt="Pinchflat-ngx" class="mx-auto w-40" />
  <h1 class="text-2xl font-semibold text-theme-on-surface">Sign in to Pinchflat-ngx</h1>

  <div :if={@error} class="theme-status-card theme-status-card-error w-full text-left" role="alert">
    <p class="font-medium">Authentication failed. Please try again.</p>
  </div>

  <.button
    href={~p"/auth/oidc/request?redirect_to=#{@redirect_to}"}
    variant="primary"
    class="w-full"
  >
    Sign in with {@provider_name}
  </.button>
</div>
