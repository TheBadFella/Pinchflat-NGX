<aside
  x-bind:class="sidebarVisible ? 'translate-x-0' : '-translate-x-full'"
  class={[
    "-translate-x-full absolute left-0 top-0 z-9999 flex h-screen theme-sidebar flex-col transition-[width,transform]",
    "border-r border-theme-outline/70 bg-theme-surface duration-300 ease-linear shadow-m3-2 sm:shadow-none lg:static lg:translate-x-0"
  ]}
  @click.outside="sidebarVisible = false"
>
  <% current_path = Phoenix.Controller.current_path(@conn) %>
  <section class="sticky top-0 z-10 bg-theme-surface">
    <div class="theme-sidebar-brand-row flex w-full">
      <a
        href={~p"/"}
        class="theme-sidebar-brand-link flex items-center justify-center shrink-0"
      >
        <img
          src={~p"/images/logo-2024-03-20.png"}
          alt="Pinchflat-ngx"
          class="theme-sidebar-logo h-10 w-auto object-contain"
        />
        <img
          src={~p"/images/icon-2024-03-20.png"}
          alt="Pinchflat-ngx"
          class="theme-sidebar-icon h-9 w-9 object-contain"
        />
      </a>

      <button class="block lg:hidden" @click.stop="sidebarVisible = !sidebarVisible">
        <.icon name="hero-arrow-left" class="fill-current" />
      </button>

      <button
        type="button"
        class="theme-sidebar-collapse theme-outline-button hidden h-8 w-8 shrink-0 items-center justify-center rounded-m3-xs p-0 text-theme-on-surface lg:flex"
        x-on:click="sidebarCollapsed = !sidebarCollapsed; window.setSidebarCollapsed(sidebarCollapsed)"
        x-bind:title="sidebarCollapsed ? 'Expand sidebar' : 'Collapse sidebar'"
      >
        <.icon
          name="hero-chevron-double-left"
          class="theme-sidebar-collapse-icon h-4 w-4 fill-current transition-transform"
        />
      </button>
    </div>
  </section>

  <div class="no-scrollbar flex flex-1 flex-col overflow-y-auto duration-300 ease-linear">
    <nav class="theme-sidebar-navigation">
      <h3 class="theme-sidebar-desktop-label mb-3 ml-3 text-xs font-medium tracking-[0.18em] text-theme-on-surface-muted lg:mb-4 lg:ml-4 lg:text-sm">
        <span>MENU</span>
      </h3>

      <div class="flex flex-col justify-between">
        <ul class="theme-sidebar-list mb-4 flex flex-col lg:mb-6">
          <.sidebar_item icon="hero-home" text="Home" href={~p"/"} current_path={current_path} />
          <.sidebar_item icon="hero-tv" text="Sources" href={~p"/sources"} current_path={current_path} />
          <.sidebar_item
            icon="hero-magnifying-glass"
            text="Channel Discovery"
            href={~p"/discovery"}
            current_path={current_path}
          />
          <.sidebar_item
            icon="hero-adjustments-vertical"
            text="Media Profiles"
            href={~p"/media_profiles"}
            current_path={current_path}
          />
          <.sidebar_submenu
            icon="hero-cog-6-tooth"
            text="Config"
            current_path={current_path}
          >
            <:submenu text="Settings" href={~p"/settings"} />
            <:submenu text="PostgreSQL Backups" href={"#{ ~p"/settings" }#postgres-backups"} />
            <:submenu text="File Reconciliation" href={~p"/reconciliation"} />
            <:submenu text="Diagnostics" href={~p"/diagnostics"} />
          </.sidebar_submenu>
        </ul>
      </div>
    </nav>

    <nav class="theme-sidebar-footer mt-auto">
      <ul class="theme-sidebar-list mb-4 flex flex-col lg:mb-6">
        <.sidebar_item
          icon="hero-book-open"
          text="Docs"
          target="_blank"
          href="https://github.com/TheBadFella/pinchflat-ngx/wiki"
          icon_class="scale-110"
        />
        <.sidebar_item
          icon="si-github"
          text="Github"
          target="_blank"
          href="https://github.com/TheBadFella/pinchflat-ngx"
        />
        <.sidebar_item
          icon="si-kofi"
          text="Donate"
          target="_blank"
          href="https://ko-fi.com/badfella"
          icon_class="scale-110"
        />
        <li class="theme-sidebar-desktop-label pt-2">
          {live_render(@conn, Pinchflat.AppVersionLive, id: "app-version-live")}
        </li>
      </ul>
    </nav>
  </div>
</aside>
