<header class="sticky top-0 z-999 flex min-h-20 w-full border-b border-theme-outline/70 bg-theme-bg/95 backdrop-blur">
  <div class="flex flex-grow items-center justify-between px-4 py-4 md:px-6 2xl:px-11">
    <div class="flex items-center gap-2 sm:gap-4 lg:hidden shrink-0">
      <section class="pr-1">
        <img src={~p"/images/icon-2024-03-20.png"} alt="Pinchflat-ngx" class="h-9 w-9 object-contain" />
      </section>

      <button
        class="theme-outline-button z-99999 mx-2 block p-2 lg:hidden"
        @click.stop="sidebarVisible = !sidebarVisible"
        aria-label="Toggle navigation menu"
      >
        <.icon name="hero-bars-3" />
      </button>
    </div>

    <div class="theme-sidebar-header-brand items-center pl-2 select-none">
      <span class="text-xl font-bold tracking-tight text-theme-on-surface flex items-center">
        <span>Pinchflat</span><span class="text-theme-primary font-semibold">-ngx</span>
      </span>
    </div>

    <div class="flex flex-1 items-center justify-end max-w-xl ml-auto pl-2">
      <div class="theme-surface-accent w-full rounded-m3-sm">
        <div class="relative">
          <span class="absolute left-3 top-1/2 flex -translate-y-1/2 text-theme-on-surface-muted">
            <.icon name="hero-magnifying-glass" />
          </span>

          <form action={~p"/search"}>
            <input
              type="text"
              name="q"
              value={@params["q"]}
              placeholder="Search all media..."
              class="w-full border-0 bg-transparent py-3 pl-10 pr-4 text-theme-on-surface placeholder:text-theme-on-surface-muted focus:ring-0 focus:outline-none"
            />
          </form>
        </div>
      </div>

      <.link
        :if={PinchflatWeb.OIDC.enabled?()}
        href={~p"/auth/logout"}
        method="delete"
        class="theme-outline-button ml-2 block shrink-0 p-2 text-theme-on-surface-muted"
        aria-label="Sign out"
        title="Sign out"
      >
        <.icon name="hero-arrow-right-on-rectangle" />
      </.link>
    </div>
  </div>
</header>
