<.modal id="donate-modal" allow_close={true}>
  <section x-data="{ inputValue: '' }">
    <h3 class="text-2xl font-semibold text-theme-on-surface">Donate</h3>

    <p class="text-sm text-theme-on-surface-muted">Thank you for your support :&rpar;</p>

    <p class="mt-4">
      If you find Pinchflat-ngx valuable and want to support continued development, you can support the project on <.inline_link href="https://ko-fi.com/badfella">
        Ko-fi
      </.inline_link>!
    </p>

    <.button href="https://ko-fi.com/badfella" target="_blank" variant="primary" class="w-full mt-8">
      Support on Ko-fi
    </.button>
  </section>
</.modal>
