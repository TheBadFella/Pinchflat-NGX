<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>{assigns[:page_title] || "Pinchflat-ngx"}</.live_title>
    <script>
      try {
        document.documentElement.dataset.sidebarCollapsed =
          localStorage.getItem('sidebarCollapsed') === 'true' ? 'true' : 'false'
      } catch (_) {
        document.documentElement.dataset.sidebarCollapsed = 'false'
      }
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico?cachebust=2024-03-20"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>

  <body
    x-data={"{
      sidebarVisible: false,
      sidebarCollapsed: window.getSidebarCollapsed(),
      currentPath: window.location.pathname,
      proEnabled: #{Settings.get!(:pro_enabled)},
      onboarding: #{Settings.get!(:onboarding)},
      updateCurrentPath() { this.currentPath = window.location.pathname },
      isSidebarPathActive(href) {
        if (href === '/') return this.currentPath === '/'
        return this.currentPath === href || this.currentPath.startsWith(`${href}/`)
      },
      isSidebarSubmenuActive(hrefs) {
        return hrefs.some((href) => this.isSidebarPathActive(href))
      }
    }"}
    x-init="
      updateCurrentPath();
      window.addEventListener('popstate', () => updateCurrentPath());
      window.addEventListener('phx:page-loading-stop', () => updateCurrentPath());
    "
    class="theme-app-shell dark bg-theme-bg text-theme-on-surface"
    data-socket-path={Path.join(Application.get_env(:pinchflat, :base_route_path), "/live")}
    data-sidebar-logo={~p"/images/logo-2024-03-20.png"}
    data-sidebar-icon={~p"/images/icon-2024-03-20.png"}
  >
    {@inner_content} <.donate_modal conn={@conn} />
    <template x-if="!proEnabled && !onboarding"><.upgrade_modal conn={@conn} /></template>
  </body>
</html>
