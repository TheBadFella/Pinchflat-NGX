# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
pinchflat-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/node_modules/
/assets/node_modules/

/.elixir_ls
.env
.DS_Store
scratchpad.md
/scratchpad/

# Database files
*.db
*.db-*

.direnv/

pinchflat.db.backup-*

.idea

build.log
/.codex-local-build-pr/
/.agents/**
/.gitattributes
/.ai/mcp/mcp.json

# SQLean SQLite extensions — fetched by tooling/fetch-sqlean.sh (pinned version),
# not committed. Loaded at runtime via config/runtime.exs.
/priv/repo/extensions/sqlean-linux-x86/
/priv/repo/extensions/sqlean-linux-arm/

# Local clone of the GitHub wiki (documentation source of truth is the wiki remote).
/.wiki-tmp/

# Python release tooling caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Command Code session directory
/.commandcode/
